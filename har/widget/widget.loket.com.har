            "text": "#w-order form {\n  width: 100%;\n}\n\n#w-order form label {\n  display: block;\n  font-size: 14px;\n  color: #494A4A;\n  font-weight: 500;\n}\n\n#w-order form input, #w-order form textarea {\n  width: 100%;\n  padding: 12px 16px;\n  border-radius: 8px;\n  border: 1px solid #DBDFE7;\n}\n\n#w-order form select {\n  -moz-appearance: none;\n  /* Firefox */\n  -webkit-appearance: none;\n  /* Safari and Chrome */\n  appearance: none;\n  padding: 12px 16px;\n  border-radius: 8px;\n  border: 1px solid #DBDFE7; \n  background-color: #ffffff;\n}\n\n\n\n#w-order form input[type=\"radio\"] {\n  width: 16px;\n  height: 16px;\n  padding: initial;\n}\n\n#w-order form input[type=\"checkbox\"] {\n  width: 16px;\n  height: 16px;\n  padding: 12px 16px;\n  border-radius: 8px;\n  border: 1px solid #DBDFE7;\n}\n\n#w-order form label[for=\"whatsapp\"] {\n  color: #8E919B;\n  font-weight: 400;\n  display: inline;\n}\n\n#w-order form .cf {\n  font-size: 14px;\n  font-weight: 300;\n  margin-left: 16px;\n}\n\n#w-order form p {\n  font-size: 14px;\n  font-weight: 400;\n  color: #8E919B;\n}\n\n#w-order .order-wrapper .content-left .accordion .accordion__header {\n  border: unset;\n  padding-left: 0;\n  padding-right: 0;\n  border-radius: unset;\n  background-color: #0049cc14;\n  border-bottom: 1px solid #DBDFE7;\n}\n\n#w-order .order-wrapper .content-left .accordion .accordion__header .rectangle {\n  width: 4px;\n  margin-right: 16px;\n  background: #0049CC;\n  border-radius: 0px 8px 8px 0px;\n}\n\n#w-order .order-wrapper .content-left .accordion .accordion__header .error {\n  background-color: red;\n}\n\n#w-order .order-wrapper .content-left .accordion .accordion__header {\n  color: #152955;\n}\n\n#w-order .order-wrapper .content-left .accordion .accordion__header .accordion__toggle {\n  margin-right: 16px;\n}\n\n#w-order .order-wrapper .content-left .accordion .is-active {\n}\n\n#w-order .order-wrapper .content-left .accordion .accordion__body {\n  border: unset;\n  padding: 0;\n}\n/* #w-order .order-wrapper .content-left {\n  width: 100%;\n  -webkit-box-ordinal-group: 2;\n} */\n.w-tab {\n  display: flex;\n  width: 96%;\n  margin: auto;\n  gap: 10px;\n}\n.w-tab .tab-item {\n  padding: 10px 20px;\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n  background-color: white;\n}\n.suggestion-item.active {\n  background-color: #F5F7FA;\n}\n.form-telephone {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n}\n.form-telephone .telephone-wrapper {\n  position: relative;\n}\n.form-telephone .country-list {\n  position: absolute;\n  width: 200px;\n  border: 1px solid #DBDFE7;\n  border-radius: 8px; \n  background-color: white;\n  top: 60px;\n}\n.form-telephone .country-list .search {\n  position: relative;\n  padding: 8px 12px;\n}\n.form-telephone .country-list .search svg {\n  position: absolute;\n  top: 18px;\n  left: 22px;\n}\n.form-telephone .country-list .country-wrapper {\n  max-height: 180px;\n  overflow-y: auto;\n}\n.form-telephone .country-list .country-wrapper .no-result {\n  display: none;\n  padding: 8px 12px;\n  font-size: 14px;\n  color: #494A4A;\n}\n.form-telephone .country-list .country-item {\n  padding: 8px 12px 8px 12px;\n  color: #494A4A;\n  cursor: pointer;\n  font-size: 14px;\n  transition: background-color 0.2s;\n}\n.form-telephone .country-list .country-item:hover {\n  background-color: #f0f0f0;\n}\n.form-telephone .country-list .search input[type=\"text\"] {\n  padding: 8px 12px 8px 36px !important;\n  border-radius: 6px !important;\n  font-size: 14px;\n}\n.form-telephone .country-code {\n  padding: 12px 16px;\n  border: 1px solid #DBDFE7;\n  border-radius: 8px;\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n}\n.form-telephone .country-code .chevron {\n   transition: transform 0.25s ease;\n}\n\n.form-telephone .country-code.active .chevron {\n    transform: rotate(180deg);\n}\n/*# sourceMappingURL=index.css.map */"
