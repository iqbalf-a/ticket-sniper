tion(){\n                var $el = $(this);\n                if($el.val().length<1)\n                    return;\n                $.post(field.url,{'term':$(this).val()},function(data){\n                    data = $.parseJSON(data);\n                    if(data.error===true){\n                        self.alert_error(field,data.message);\n                        $el.val('');\n                    }else{\n                        self.alert_clear(field);\n                    }\n                });\n            });\n            return $input;\n        }\n\n\n    });\n\n}(jQuery));\n\n/** Graded form extensions */\n(function( $ ) {\n    \n    $.extend(true, $.loket.loketForm.prototype, {\n        \n        _recursive_hide_linked_group: function(data_parent_graded){\n            var self = this;\n            if (data_parent_graded !== undefined) {\n                var $input_graded = $('input[data-linked-graded='+ data_parent_graded +']');\n                $input_graded.each(function(index, el) {\n                    var parent_graded = $(el).data('parent-graded');\n                    var $div_group   = $(el).closest('.form-group pt-5');\n                    self._recursive_hide_linked_group(parent_graded);\n                    $div_group.hide();\n                    \n                    if ($(el).is(':visible') === false){\n                        var field_key = $(el).prop('name').replace('loket_form_','');\n                        if (field_key.indexOf('[]') != -1) {\n                            field_key = field_key.replace('[]','');\n                        }\n                        $(el).prop('checked',false).prop('required',false).change();\n                        if (self.options.fields[field_key] !== undefined) {\n                            self.options.fields[field_key]['required'] = false;\n                        }\n                    }\n                });\n            }\n        },\n        \n        _do_graded_form: function(field, option) {\n        