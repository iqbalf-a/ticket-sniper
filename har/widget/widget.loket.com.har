            "mimeType": "text/css",
            "text": "@font-face {\n  font-family: 'BasierSquare';\n  src: url(https://assets.loket.com/vwar/web/assets/fonts/BasierSquare-Regular.otf) format(\"opentype\");\n  font-weight: 300;\n  font-style: normal;\n}\n\n@font-face {\n  font-family: 'BasierSquare';\n  src: url(https://assets.loket.com/vwar/web/assets/fonts/BasierSquare-Medium.otf) format(\"opentype\");\n  font-weight: 500;\n  font-style: normal;\n}\n\n@font-face {\n  font-family: 'BasierSquare';\n  src: url(https://assets.loket.com/vwar/web/assets/fonts/BasierSquare-SemiBold.otf) format(\"opentype\");\n  font-weight: 600;\n  font-style: normal;\n}\n\n@font-face {\n  font-family: 'BasierSquare';\n  src: url(https://assets.loket.com/vwar/web/assets/fonts/BasierSquare-Bold.otf) format(\"opentype\");\n  font-weight: 700;\n  font-style: normal;\n}\n\nhtml,\nbody {\n  height: 100%;\n  overflow-x: hidden;\n  background-color: #fff;\n  scroll-behavior: smooth;\n}\n\nbody {\n  margin: 0;\n  color: #151416;\n  font-size: 1rem;\n  font-weight: 300;\n  letter-spacing: 0.003em;\n  font-family: 'BasierSquare';\n  position: relative;\n}\n\n/* CONTAINER */\n@media (min-width: 1280px) {\n  .container {\n    max-width: 1120px !important;\n  }\n}\n/*    NAVBAR    */\n.w-nav {\n  height: 68px;\n  background: #FFFFFF;\n}\n\n.w-step .nav-num {\n  width: 24px;\n  height: 24px;\n  font-size: 12px;\n  font-weight: 500;\n  color: #ADB6C9;\n  border-radius: 50%;\n  text-align: center;\n  border: 1px solid #ADB6C9;\n}\n\n.w-step .nav-num.n-active {\n  font-weight: 500;\n  color: #0049CC;\n  border: 1.5px solid #0049CC;\n}\n\n.w-step .nav-num.n-pass {\n  font-weight: 500;\n  color: #0049CC;\n  background: #0049CC;\n  border: 1.5px solid #0049CC;\n}\n\n.w-step span {\n  font-size: 14px;\n  font-weight: 500;\n  color: #ADB6C9;\n}\n\n.w-step span.s-active {\n  color: black;\n}\n\n.w-nav .w-bil {\n  background: #F5F7FA;\n  border-radius: 40px;\n}\n\n.w-nav .w-bil {\n  background: #F5F7FA;\n  border-radius: 40px;\n}\n\n/* -----------   MOBILE STEP  --------  */\n.n-step {\n  height: 48px;\n}\n\n/*  ---------   FOOTER ---------   */\n.w-footer {\n  bottom: 0;\n}\n\n.w-footer ul li {\n  font-size: 14px;\n  color: #494A4A;\n  margin-bottom: 8px;\n}\n#modal-tnc {\n  background:rgba(0,0,0,.5);\n}\n#modal-tnc .modal {\n  overflow: hidden;\n  width: 618px !important;\n}\n#modal-tnc .modal-body {\n  max-height: 500px;\n  overflow: auto;\n}\n#modal-tnc .modal-body ul,\n#modal-tnc .modal-body ol{\n  list-style: revert !important;\n  margin-left: 1.25rem;\n}\n@media (max-width: 640px) {\n  .w-footer {\n    border-top: 1px solid #DBDFE7;\n  }\n  #modal-tnc .modal {\n    width: 100% !important;\n  }\n  #modal-tnc .modal-body {\n    max-height: 450px;\n  }\n  .modal.rounded-lg,.modal .rounded-lg {\n    border-bottom-left-radius: 0;\n    border-bottom-right-radius: 0;\n  }\n}\n\n/*  --------------   GLOBAL   ------------   */\n.accordion__header {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  cursor: pointer;\n  padding: 16px 24px;\n  -webkit-box-align: center;\n      -ms-flex-align: center;\n          align-items: center;\n  border-radius: 8px;\n  border: 1px solid #DBDFE7;\n  -webkit-box-pack: justify;\n      -ms-flex-pack: justify;\n          justify-content: space-between;\n  margin-top: 12px;\n}\n\n.accordion__header h6 {\n  color: #151416;\n  font-size: 16px;\n  font-weight: 500;\n}\n\n.accordion__header > * {\n  margin-top: 0;\n  margin-bottom: 0;\n  font-size: 16px;\n}\n\n.accordion__header.is-active {\n  background: #F5F7FA;\n  border-bottom-left-radius: 0;\n  border-bottom-right-radius: 0;\n  border-bottom: unset;\n}\n\n.accordion__toggle {\n  height: 20px;\n  width: 20px;\n  display: block;\n  -ms-flex-negative: 1;\n      flex-shrink: 1;\n  margin-left: 10px;\n  position: relative;\n  border-radius: 2px;\n  background: url(\"https://assets.loket.com/widget/ic_expand_less.svg\") no-repeat center center;\n}\n\n.is-active .accordion__toggle {\n  background: url(\"https://assets.loket.com/widget/ic_expand_more.svg\") no-repeat center center;\n}\n\n.is-active .accordion__toggle::before {\n  display: none;\n}\n\n.section-preferred-payment {\n  border-radius: 8px 8px 8px 0px;\n  background: linear-gradient(180deg, rgba(254, 236, 225, 0.00) 0%, #FEECE1 100%);\n  padding: 24px;\n  margin-left: -24px;\n}\n\n.preferred_payment {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  cursor: pointer;\n  padding: 16px 24px;\n  -webkit-box-align: center;\n      -ms-flex-align: center;\n          align-items: center;\n  border-radius: 8px 8px 0px 0px;\n  border: 1px solid #DBDFE7;\n  -webkit-box-pack: justify;\n      -ms-flex-pack: justify;\n          justify-content: space-between;\n  margin-top: 12px;\n  background: #ebf4ff !important;\n  border-bottom: unset;\n}\n\n.preferred_payment__body {\n  display: block;\n  padding: 0;\n  border-top: 0;\n  text-align: left;\n  border: 1px solid #DBDFE7;\n  border-bottom-left-radius: 8px;\n  border-bottom-right-radius: 8px;\n  border-top-left-radius: 8px;\n  border-top-right-radius: 8px;\n}\n\n.preferred_payment__body .payment-list .badges {\n  border-radius: 24px 4px 0px 24px;\n  background: var(--brand-orange-primary, #FB7221);\n  color: #fff;\n  position: absolute;\n  padding: 5px;\n  top: -17px;\n  right: -6px;\n  font-size: 12px;\n}\n\n.preferred_payment__body .payment-list .badges-red {\n  border-radius: 10px 10px 0px 10px;\n  background: var(--brand-orange-primary, #DA160B);\n  color: #fff;\n  position: absolute;\n  padding: 5px;\n  top: -17px;\n  right: -6px;\n  font-size: 12px;\n}\n\n.preferred_payment__body .payment-list .badges-red::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(to right, transparent 0%, white 50%, transparent 100%);\n  opacity: 0.5;\n  transform: skewX(0deg);\n  width: 2rem;\n  animation: shimmer_preferred 2s infinite;\n}\n\n@keyframes shimmer_preferred {\n  0% {\n    left: 0%;\n  }\n  50% {\n    left: 50%;\n  }\n  100% {\n    left: 100%;\n  }\n}\n\n.accordion-header-promo {\n  position: relative;\n  background: #34C759;\n  border-radius: 0.5rem 0.5rem 0.5rem 0rem;\n}\n\n.accordion-header-promo .badges {\n  background: #34C759;\n}\n\n.accordion-header-promo .badges::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(to right, transparent 0%, white 50%, transparent 100%);\n  opacity: 0.5;\n  transform: skewX(0deg);\n  width: 2rem;\n  animation: shimmer_accordion 2s infinite;\n}\n\n@keyframes shimmer_accordion {\n  0% {\n    left: 0%;\n  }\n  50% {\n    left: 50%;\n  }\n  100% {\n    left: 100%;\n  }\n}\n\n.accordion-child-promo {\n  position: relative;\n  background: #FF3B30;\n}\n\n.accordion-child-promo .badges, .accordion-child-promo .badge {\n  background: #FF3B30;\n}\n\n.badge-running {\n    color: white;\n    max-width: 100px; \n    overflow: hidden; \n    display: flex;\n    align-items: center;\n    border-radius: 4px;\n    white-space: nowrap;\n}\n\n.badge-running .wrapper {\n    display: flex;\n    white-space: nowrap;\n    animation: scroll-left 10s linear infinite;\n}\n\n.badge-running .wrapper span {\n    padding-right: 10px; \n    display: contents;\n}\n\n@keyframes scroll-left {\n  0% { transform: translateX(0); }\n  100% { transform: translateX(-50%); } \n}\n\n.accordion-child-promo .badges--shimmer::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: -2rem; /* start outside */\n  width: 2rem;\n  height: 100%;\n  background: linear-gradient(\n    to right,\n    transparent 0%,\n    white 50%,\n    transparent 100%\n  );\n  opacity: 0.5;\n  animation: shimmer_accordion_child 2s infinite;\n}\n\n@keyframes shimmer_accordion_child {\n  0% {\n    left: 0%;\n  }\n  50% {\n    left: 50%;\n  }\n  100% {\n    left: 100%;\n  }\n}\n\n.relative {\n  position: relative !important;\n}\n\n.preferred_payment__body .badges .badge-item, .preferred_payment__body .badges-red .badge-item {\n  display: inline-block;\n}\n\n.preferred_payment__body .badges .badge-text, .preferred_payment__body .badges-red .badge-item {\n  font-size: 9px;\n}\n\n.preferred_payment__body .payment-list .badges-tail {\n  position: absolute;\n  right: -6px;\n  top: 12px;\n  border-top: 3px solid #cc5812;\n  border-left: 3px solid #cc5812;\n  border-right: 3px solid transparent;\n  border-bottom: 3px solid transparent;\n}\n\n.preferred_payment__body .payment-list .badges-tail-cover {\n  background: transparent;\n  width: 5px;\n  height: 10px;\n  position: absolute;\n  right: -5px;\n  top: 10px;\n}\n\n.preferred_payment__body .payment-list {\n  cursor: pointer;\n}\n\n.preferred_payment__body .payment-list img:first-child {\n  width: 56px;\n  height: 40px;\n  object-fit: contain;\n}\n\n.rounded-t-lg {\n  border-top-right-radius: 0.5rem;\n  border-top-left-radius: 0.5rem;\n}\n\n.accordion__body {\n  display: none;\n  padding: 1em;\n  border-top: 0;\n  text-align: left;\n  border: 1px solid #DBDFE7;\n  border-bottom-left-radius: 8px;\n  border-bottom-right-radius: 8px;\n}\n\n.accordion__body ol {\n  padding-left: 24px;\n  list-style: decimal;\n}\n\n.accordion__body ol li {\n  font-size: 14px;\n  color: #494A4A;\n  text-align: left;\n}\n\n.accordion__body.is-active {\n  display: block;\n}\n\n.accordion__body .payment-list {\n  cursor: pointer;\n}\n\n.accordion__body .payment-list img:first-child {\n  width: 56px;\n  height: 40px;\n  object-fit: contain;\n}\n\n.accordion__body .payment-list:hover {\n  background: #FAFAFA;\n}\n\n\n.available-payment img {\n  width: 56px;\n  height: 40px;\n  object-fit: contain;\n}\n\n.available-payment {\n  display: flex;\n  gap: 15px;\n  flex-wrap: wrap;\n}\n\n#toast-error {\n  top: 26px;\n  left: 50%;\n  position: fixed;\n  z-index: 9999;\n  -webkit-transform: translate(-50%, 0);\n          transform: translate(-50%, 0);\n  background: #FFE2E0;\n  border: 1px solid #FF544A;\n  border-radius: 4px;\n  -webkit-animation: show_toast 0.2s ease forwards;\n          animation: show_toast 0.2s ease forwards;\n}\n\n#toast-error img {\n  width: 16px;\n  height: 16px;\n  margin-top: 2px;\n}\n\n@-webkit-keyframes show_toast {\n  0% {\n    -webkit-transform: translate(-50%, -100%);\n            transform: translate(-50%, -100%);\n  }\n  100% {\n    -webkit-transform: translate(-50%, 16px);\n            transform: translate(-50%, 16px);\n  }\n}\n\n@keyframes show_toast {\n  0% {\n    -webkit-transform: translate(-50%, -100%);\n            transform: translate(-50%, -100%);\n  }\n  100% {\n    -webkit-transform: translate(-50%, 16px);\n            transform: translate(-50%, 16px);\n  }\n}\n\n\n.modal-background {\n  background:rgba(0,0,0,.0);\n  animation: fadeIn .5s cubic-bezier(0.165, 0.840, 0.440, 1.000) forwards;\n}\n\n.modal {\n  opacity:0;\n  animation: scaleUp .5s cubic-bezier(0.165, 0.840, 0.440, 1.000) forwards;\n}\n\n@keyframes fadeIn {\n  0% {\n    background:rgba(0,0,0,.0);\n  }\n  100% {\n    background:rgba(0,0,0,.7);\n  }\n}\n\n@keyframes scaleUp {\n  0% {\n    transform:scale(.8) translateY(1000px);\n    opacity:0;\n  }\n  100% {\n    transform:scale(1) translateY(0px);\n    opacity:1;\n  }\n}\n\n.modal .content-left .box-pag {\n  font-size: 12px;\n  color: white;\n  right: 12px;\n  bottom: 12px;\n  padding: 4px 8px;\n  position: absolute;\n  background: rgba(0, 0, 0, 0.4);\n  border-radius: 4px;\n}\n\n.modal.modal-timeout {\n  width: 30%;\n}\n\n.modal .content-left img {\n  width: 100%;\n  height: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n}\n\n.modal .btn-close {\n  z-index: 1;\n  top: 18px;\n  right: 16px;\n  position: absolute;\n}\n\n.modal .selected img {\n  /* border: 2px solid #0049CC; */\n}\n\n#modal-back .modal, #modal-tnc .modal {\n  width: 400px;\n  border-top-right-radius: 12px;\n  border-top-left-radius: 12px;\n}\n\n.m-banner {\n  min-height: 182px;\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n  overflow: hidden;\n  background-size: 100% 100%;\n  background-repeat: no-repeat;\n}\n\n.m-banner img {\n  width: 100%;\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n}\n\n@media (max-width: 1024px) {\n  .modal.modal-timeout {\n    width: 60%;\n  }\n}\n\n@media (max-width: 820px) {\n  .m-banner {\n    min-height: 126px;\n  }\n}\n\n@media (max-width: 640px) {\n  .available-payment img {\n    width: 44px;\n    height: 32px;\n  }\n  .available-payment  {\n    gap: 30px;\n    justify-content: center;\n  }\n  .m-banner {\n    border-radius: 0;\n    min-height: 120px;\n  }\n\n  .modal.modal-timeout {\n    width: 100%;\n  }\n}\n\n.w-loading {\n  position: fixed;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  width: 100%;\n  height: 100%;\n  top: 0;\n  left: 0;\n  z-index: 99;\n  opacity: .8;\n  background-color: rgba(0,0,0,.5);\n}\n\n.w-loading .lds-ring {\n  display: inline-block;\n  position: relative;\n  width: 80px;\n  height: 80px;\n  background: #fff;\n}\n\n.w-loading .lds-ellipsis {\n  display: inline-block;\n  position: relative;\n  width: 80px;\n  height: 80px;\n  border-radius: 16px;\n  padding: 20px;\n  background: #fff;\n}\n\n.lds-ellipsis div {\n  position: absolute;\n  top: 33px;\n  width: 13px;\n  height: 13px;\n  border-radius: 50%;\n  background: #0049CC;\n  border: 1px solid #0049CC;\n  animation-timing-function: cubic-bezier(0, 1, 1, 0);\n}\n\n.lds-ellipsis div:nth-child(1) {\n  left: 8px;\n  animation: lds-ellipsis1 0.6s infinite;\n}\n\n.lds-ellipsis div:nth-child(2) {\n  left: 8px;\n  animation: lds-ellipsis2 0.6s infinite;\n}\n\n.lds-ellipsis div:nth-child(3) {\n  left: 32px;\n  animation: lds-ellipsis2 0.6s infinite;\n}\n\n.lds-ellipsis div:nth-child(4) {\n  left: 56px;\n  animation: lds-ellipsis3 0.6s infinite;\n}\n\n@keyframes lds-ellipsis1 {\n  0% {\n    transform: scale(0);\n  }\n  100% {\n    transform: scale(1);\n  }\n}\n\n@keyframes lds-ellipsis3 {\n  0% {\n    transform: scale(1);\n  }\n  100% {\n    transform: scale(0);\n  }\n}\n\n@keyframes lds-ellipsis2 {\n  0% {\n    transform: translate(0, 0);\n  }\n  100% {\n    transform: translate(24px, 0);\n  }\n}\n\n@keyframes lds-ring {\n  0% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(360deg);\n  }\n}\n\n.button--loading .button__text {\n  visibility: hidden;\n  opacity: 0;\n}\n\n.button--loading::after {\n  content: \"\";\n  position: absolute;\n  width: 24px;\n  height: 24px;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  margin: auto;\n  border: 6px solid transparent;\n  border-top-color: #ffffff;\n  border-radius: 50%;\n  animation: button-loading-spinner 1s ease infinite;\n}\n\n@keyframes button-loading-spinner {\n  from {\n    transform: rotate(0turn);\n  }\n\n  to {\n    transform: rotate(1turn);\n  }\n}\n\n.w-countdown {\n  padding-top: 14px;\n  padding-bottom: 14px;\n  background: #FFCC00;\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  -webkit-box-align: center;\n      -ms-flex-align: center;\n          align-items: center;\n  -webkit-box-pack: center;\n      -ms-flex-pack: center;\n          justify-content: center;\n}\n\n.w-countdown.sticky  {\n  border-top-left-radius: unset;\n  border-top-right-radius: unset;\n}\n\n.w-countdown .divider {\n  width: 1px;\n  height: 20px;\n  background: #B38F0C;\n  margin-left: 12px;\n  margin-right: 12px;\n}\n\n.w-wrapper {\n  padding-top: 40px;\n  padding-bottom: 40px;\n  background: #F5F7FA;\n}\n\n.w-container {\n  background: #FFFFFF;\n  border-radius: 12px;\n  -webkit-box-shadow: 0px 4px 8px rgba(30, 44, 106, 0.1);\n          box-shadow: 0px 4px 8px rgba(30, 44, 106, 0.1);\n}\n\n.w-content {\n  padding-left: 24px;\n  padding-right: 24px;\n  background: #FFFFFF;\n}\n\n.separator {\n  height: 7px;\n  background: #F5F7FA;\n}\n\n.text-muted {\n  color: #8E919B;\n}\n\n.text-danger {\n  color: #e21111;\n}\n\n.a-enter {\n  -webkit-transition: top 300ms cubic-bezier(0.17, 0.04, 0.03, 0.94);\n  transition: top 300ms cubic-bezier(0.17, 0.04, 0.03, 0.94);\n}\n\n.stepper {\n  width: 120px;\n}\n\n.stepper button {\n  width: 100%;\n  font-weight: 500;\n  color: #0049CC;\n  border-radius: 8px;\n  white-space: nowrap;\n  border: 1px solid #0049CC;\n  text-align: center;\n}\n\n.stepper button:disabled {\n  font-weight: 500;\n  color: #FF3B30;\n  border-radius: 8px;\n  background: #FFE2E0;\n  border: 1px solid #FF3B30;\n}\n\n.stepper button[label~=\"sub\"], .stepper button[label~=\"add\"] {\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  -webkit-box-align: center;\n      -ms-flex-align: center;\n          align-items: center;\n  -webkit-box-pack: center;\n      -ms-flex-pack: center;\n          justify-content: center;\n  font-weight: 500;\n  font-size: 20px;\n  border: 1.5px solid #0049CC;\n}\n\n.stepper button[label~=\"add\"]:disabled {\n  color: #ADB6C9;\n  background: #FFFFFF;\n  border: 1.5px solid #ADB6C9;\n}\n\n.t-separator {\n  position: relative;\n  border-top: 1px dashed #DBDFE7;\n}\n\n.t-separator::before {\n  content: \"\";\n  height: 24px;\n  width: 24px;\n  position: absolute;\n  border-radius: 50%;\n  top: -11px;\n  left: -38px;\n  background-color: #FFFFFF;\n  border-right: 1px solid #DBDFE7;\n}\n\n.t-separator::after {\n  content: \"\";\n  height: 24px;\n  width: 24px;\n  position: absolute;\n  border-radius: 50%;\n  top: -11px;\n  right: -38px;\n  background-color: #FFFFFF;\n  border-left: 1px solid #DBDFE7;\n}\n\n.error-message {\n  color: #FF3B30;\n  font-size: 12px;\n  margin-top: 8px;\n}\n\n.form-error {\n  border: 1px solid red !important;\n}\n\n.form-success {\n  background-color: #E7F9EB !important;\n}\n\n.success-message {\n  color: green;\n  font-size: 12px;\n}\n\n.button-primary {\n  color: white;\n  font-weight: 500;\n  padding: 12px 24px;\n  border-radius: 8px;\n  background: #0049CC;\n}\n\n.button-danger {\n  color: white;\n  font-weight: 500;\n  padding: 12px 24px;\n  border-radius: 8px;\n  background: red !important;\n}\n\n.button-danger:disabled {\n  background-color: #ADB6C9 !important;\n}\n\n.button-primary:disabled {\n  background: #ADB6C9;\n}\n\n.button-secondary {\n  color: black;\n  background: transparent;\n  border: 1px solid #DBDFE7;\n}\n\n.border-b {\n  border-bottom: 1px solid #DBDFE7;\n}\n\n.wrapper {\n  -webkit-box-orient: horizontal;\n  -webkit-box-direction: normal;\n      -ms-flex-direction: row;\n          flex-direction: row;\n}\n\n.wrapper .content-left {\n  width: 60%;\n  -webkit-box-ordinal-group: 2;\n      -ms-flex-order: 1;\n          order: 1;\n}\n\n.wrapper .content-left .w-action a {\n  color: #0000EE;\n  text-decoration: underline;\n}\n\n.wrapper .content-right {\n  width: 40%;\n  -webkit-box-ordinal-group: 3;\n      -ms-flex-order: 2;\n          order: 2;\n  border-radius: 8px;\n  height: -webkit-fit-content;\n  height: -moz-fit-content;\n  height: fit-content;\n  -webkit-box-shadow: 0px 4px 8px rgba(30, 44, 106, 0.1);\n          box-shadow: 0px 4px 8px rgba(30, 44, 106, 0.1);\n}\n\n.wrapper .content-right .event-information {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n}\n\n.wrapper .content-right .event-information .banner {\n  width: 45px;\n  height: 45px;\n}\n\n.wrapper .content-right span {\n  font-size: 16px;\n  color: #494A4A;\n}\n\n.wrapper .content-right h5 {\n  font-size: 18px;\n  font-weight: 600;\n  text-transform: uppercase;\n}\n\n.wrapper .payment-details .total-payment {\n  margin-top: 17px;\n  border-top: 1px dashed #DBDFE7;\n  border-bottom: 1px dashed #DBDFE7;\n}\n\n.wrapper .payment-details .total-payment h6 {\n  font-size: 18px;\n  font-weight: 550;\n}\n\n.wrapper .payment-details .w-action .button-secondary {\n  padding: 0;\n  width: 48px;\n  height: 48px;\n  min-width: 48px;\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  -webkit-box-alig