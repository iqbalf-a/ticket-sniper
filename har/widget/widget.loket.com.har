t= new_total.toString().replace(/(\\d)(?=(\\d{3})+(?!\\d))/g, \"$1.\");\n\t$('#total_ticket_purchase').html('<b>'+currency+' '+new_total_curr+'</b>');\n\n\tget_discount(new_total, ticket_transaction);\n}\n\nfunction calculate_total_price() {\n\tvar new_total \t\t= 0;\n\tvar currency\t\t= '';\n\t$('#ticket_list [id*=new_price]').map(function(){\n\t\tvar val\t\t\t= $(this).html();\n\t\tcurrency\t\t= val.split(' ')[0];\n\t\tsub_total\t\t= val.replace(/\\D/g,'');\n\t\tnew_total\t \t+= parseInt(sub_total);\n\t});\n\treturn new_total;\n}\n\nfunction calculate_total_qty() {\n\tvar ticket_sum = 0;\n\t$('#ticket_list select').map(function () \n\t{\n\t\tticket_qty\t\t= $(this).val();\n\t\tif (ticket_qty) \n\t\t{\n\t\t\tticket_sum\t\t+= parseInt(ticket_qty);\n\t\t}\n\t});\n\treturn ticket_sum;\n}\n\nfunction get_discount(total_price, ticket_transaction)\n{\n\tvar coupon_code \t\t\t= $('#coupon_code').val();\n\tvar id_group \t\t\t\t= $('#coupon_code').data('id-group');\n\n\tif (typeof coupon_code != 'undefined' && coupon_code != '' && id_group != '' && total_price > 0) {\n\t\t$.post('/ajax_data/get_discount', {id_group: id_group, coupon_code: coupon_code, total_price: total_price, ticket_transaction: JSON.stringify(ticket_transaction)}, function(data) {\n\t\t\tif (data.message.status === true) {\n\t\t\t\tvar discount \t= '\\\n\t\t\t\t\t<tr id=\"tr-discount\">\\\n\t\t\t\t\t\t<td colspan=\"4\" style=\"background:#fafafa;\">\\\n\t\t\t\t\t\t\t<i>Discount</i>\\\n\t\t\t\t\t\t\t<div>\\\n\t\t\t\t\t\t\t\t<small></small>\\\n\t\t\t\t\t\t\t</div>\\\n\t\t\t\t\t\t</td>\\\n\t\t\t\t\t\t<td class=\"nowrap\" id=\"discount-nominal\" style=\"background:#fafafa;\">\\\n\t\t\t\t\t\t\t<i>'+data.result.discount+'</i> </td>\\\n\t\t\t\t\t</tr>\\\n\t\t\t\t';\n\t\t\t\t$('#tr-discount').remove();\n\t\t\t\t$('#ticket_list tbody').append(discount);\n\t\t\t\t$('#total_ticket_purchase').html('<b>'+data.result.total_price+'</b>');\n\t\t\t}\n\t\t\telse {\n\t\t\t\talert(data.message.message);\n\t\t\t\t$('#tr-discount').remove();\n\t\t\t}\n\t\t}, 'json');\n\t}\n\telse {\n\t\t$('#tr-discount').remove();\n\t}\n}\n\nfunction set_cookie(cname, cvalue, cdomain, exdays)\n{\n\tvar d\t\t\t= new Date();\n\td.setTime(d.getTime() + (exdays*24*60*60*1000));\n\n\tvar parameter\t= cname + \"=\" + cvalue + \";\";\n\tvar expires\t\t= \"expires=\" + d.toUTCString() + \";\";\n\tvar domain\t\t= \"domain=\" + cdomain + \";\";\n\tvar path\t\t= \"path=/;\";\n\t\n\tdocument.cookie\t= parameter + expires + domain + path;\n}\n\nfunction set_cookie2(cname, cvalue, cdomain, exdays) {\n\tvar d\t\t\t= new Date();\n\td.setTime(d.getTime() + (exdays*24*60*60*1000));\n\n\tvar parameter\t= cname + \"=\" + cvalue + \";\";\n\tvar expires\t\t= \"expires=\" + d.toUTCString() + \";\";\n\tvar domain\t\t= \"domain=\" + cdomain + \";\";\n\tvar path\t\t= \"path=/;\";\n\tvar same_site   = \"SameSite=None; Secure\";\n\n\tdocument.cookie\t= parameter + expires + domain + path +same_site;\n}\n\nfunction is_exist_cookie_data_layer(data_layer) {\n\tif(data_layer == undefined || data_layer == \"\" || data_layer == false) {\n\t\treturn false;\n\t}else{\n\t\treturn true;\n\t}\n}\n\nfunction delete_cookie(cookie_name,domain) {\n\tdocument.cookie = `${cookie_name}=; domain=${domain}; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;\n} \n\nfunction get_cookie(cname)\n{\n\tvar name\t\t= cname + \"=\";\n\tvar ca\t\t\t= document.cookie.split(';');\n\tfor (var i=0; i<ca.length; i++)\n\t{\n\t\tvar c\t\t= ca[i];\n\t\twhile (c.charAt(0)==' ') c = c.substring(1);\n\t\tif (c.indexOf(name) == 0) return c.substring(name.length,c.length);\n\t}\n\t\n\treturn \"\";\n}\n\nfunction set_fast_selling(value)\n{\n\tif (value)\n\t{\n\t\t$(\".form_fast_selling\").hide();\n\t\t$('#notes').attr('placeholder', 'e.g. email, phone number, etc');\n\t}\n\telse\n\t{\n\t\t$(\".form_fast_selling\").show();\n\t\t$('#notes').attr('placeholder', '');\n\t}\n}\n\nfunction is_maintenance_mode(value)\n{\n\tif (value)\n\t{\n\t\t$(\".maintenance_info\").show();\n\t}\n\telse\n\t{\n\t\t$(\".maintenance_info\").hide();\n\t}\n}\n\nfunction get_list_ticket(id_event, id_group, id_ticket)\n{\n\t$.post('/ajax_data/get_list_ticket',{'id_event':id_event, 'id_group':id_group},function(data)\n\t{\n\t\t$('#id_ticket').html('');\n\t\t$('#id_ticket').append('<option value=\"\">&hellip;</option>');\n\t\t$.each(data.dropdown_ticket, function(k,v){\n\t\t\tif(k == id_ticket)\n                $('#id_ticket').append('<option value=\"' + k + '\" selected=\"selected\">'+ v +'</option>');\n\t\t\telse\n\t\t\t\t$('#id_ticket').append('<option value=\"' + k + '\">'+ v +'</option>');\n\t\t});\n\t\t$('#id_ticket').trigger(\"chosen:updated\");\n\t},'json');\n}\n\nfunction get_list_easy_forms(id_easyform)\n{\n\t$.getJSON('/ajax_data/get_list_easy_forms', function(data)\n\t{\n\t\t$('#id_easyform').html('');\n\t\t$('#id_easyform').append('<option value=\"\">&hellip;</option>');\n\t\t$.each(data.dropdown_forms, function(k,v){\n\t\t\tif (k == id_easyform)\n\t\t\t\t$('#id_easyform').append('<option value=\"' + k + '\" selected>'+ v +'</option>');\n\t\t\telse\n\t\t\t\t$('#id_easyform').append('<option value=\"' + k + '\">'+ v +'</option>');\n\t\t});\n\t\t$('#id_easyform').trigger(\"chosen:updated\");\n\t});\n}\n\nfunction get_list_group(id_event, id_schedule)\n{\n\tget_list_group_(id_event, id_schedule, '');\n}\n\nfunction get_list_group_outlet(id_event, id_schedule, $param)\n{\n\tget_list_group_(id_event, id_schedule, $param);\n\tget_list_ticket_for_report(id_event, id_schedule);\n}\n\nfunction get_list_group_(id_event, id_schedule, $param)\n{\n\tvar selectorappend = ($param =='')?'#id_group':$param;\n\t$.post('/ajax_data/get_list_group',{'id_event':id_event, 'id_schedule':id_schedule},function(data){\n\t\t$(selectorappend).html('');\n\t\t$(selectorappend).append('<option value=\"\">&hellip;</option>');\n\t\t\n\t\tvar Items = [];\n\t\t$.each(data.dropdown_group, function(key,value){\n\t\t\tItems.push( { key: key, value: value } );\n\t\t});\n\n\t\tItems.sort( function(a,b){ return a.value.localeCompare( b.value ); } ); \n\t\t$.each(Items, function(index, data){\n\t\t\t$(selectorappend).append('<option value=\"' + data.key + '\">'+ data.value +'</option>');\n\t\t});\n\t\t\n\t\t$(selectorappend).trigger(\"chosen:updated\");\n\t},'json');\n}\n\nfunction get_list_ticket_for_report(id_event, id_schedule, id_group = null, $param = '')\n{\n    var selectorappend = ($param =='') ? '#id_ticket' : $param;\n    var params = {\n        'id_event':id_event,\n        'id_schedule':id_schedule\n    }\n    if (id_group != null)\n        params.id_group = id_group;\n\t$.post('/ajax_data/get_list_ticket_for_report',params,function(data){\n\t\t$(selectorappend).html('');\n\t\t$(selectorappend).append('<option value=\"\">&hellip;</option>');\n\t\t\n\t\tvar Items = [];\n\t\t$.each(data.dropdown_ticket, function(key,value){\n\t\t\tItems.push({key: key,value: value});\n\t\t});\n\n\t\tItems.sort(function(a,b){ return a.value.localeCompare( b.value ); }); \n\t\t$.each(Items, function(index, data){\n\t\t\t$(selectorappend).append('<option value=\"' + data.key + '\">'+ data.value +'</option>');\n\t\t});\n\t\t\n\t\t$(selectorappend).trigger(\"chosen:updated\");\n\t},'json');\n}\n\nfunction invoice_checkin_badge(id_invoice)\n{\n\tif (confirm('Are you sure want to checkin badge?'))\n\t{\n\t\t$.post('/ajax_data/invoice_checkin_badge',{'id_invoice':id_invoice},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\t\tif (!data.error)\n\t\t\t\twindow.open('/event/badge_ticketbox/'+ id_invoice, '_blank')\n\t\t},'json');\n\t}\n}\n\nfunction resend_ticket(code)\n{\n\tif (confirm('Are you sure want to resend E-Voucher?'))\n\t{\n        $.post('/ajax_data/resend_ticket',{'code':code},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\t},'json');\n\t}\n}\n\n\nfunction sync_data_to_loket_x(id_invoice, code)\n{\n\tif (confirm('Are you sure want to sync this invoice to Loket-X?'))\n\t{\n        $.post('/ajax_data/sync_data_to_loket_x/' + id_invoice,{'code':code},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\t},'json');\n\t}\n}\n\nfunction resend_ticket_v2(code) {\n\tif (confirm('Are you sure want to resend E-Voucher?')) {\n\t\t$.post('/ajax_data/resend_ticket', { 'code': code, 'version': 'v2' }, function (data) {\n\t\t\talert(data.message);\n\t\t}, 'json');\n\t}\n}\n\nfunction refund_ticket(params)\n{\n\tif (confirm('Are you sure want to refund Invoice?'))\n\t{\n\t\tvar response = grecaptcha.getResponse();\n\n\t\t$.post('/ajax_data/refund_ticket', Object.assign({\n\t\t\t\t'user_chaptcha': response\n\t\t\t}, params),\n\t\t\tfunction(data)\n\t\t\t{\n\t\t\t\tif(data['status'] == true) {\n\t\t\t\t\talert(\"Your refund request submitted, you will be direct to fill your bank information. Click Ok for continue\");\n\t\t\t\t\twindow.location.href = data['link'];\n\t\t\t\t}\n\t\t\t\telse{\n\t\t\t\t\talert(data.message);\n\t\t\t\t}\n\t\t\t},\n\t\t\t'json');\n\t}\n}\n\nfunction remove_ebadge(id_schedule, id_ticket_type)\n{\n\tif (confirm('Are you sure want to delete E-badge?'))\n\t{\n\t\t$.post('/ajax_data/remove_ebadge',{'id_schedule': id_schedule,'id_ticket_type':id_ticket_type},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\t},'json');\n\n\t\tsetTimeout(function() \n\t\t{\n\t\t\tlocation.href='/ticket/schedule';\n\t\t}, '1000');\n\t}\n}\n\nfunction remove_eticket(id_schedule, id_ticket_type)\n{\n\tif (confirm('Are you sure want to delete E-ticket?'))\n\t{\n\t\t$.post('/ajax_data/remove_ticket',{'id_schedule': id_schedule,'id_ticket_type':id_ticket_type},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\t},'json');\n\n\t\tsetTimeout(function() \n\t\t{\n\t\t\tlocation.href='/ticket/schedule';\n\t\t}, '1000');\n\t}\n}\n\nfunction remove_evoucher(id_schedule, id_ticket_type)\n{\n\tif (confirm('Are you sure want to delete E-voucher?'))\n\t{\n\t\t$.post('/ajax_data/remove_evoucher',{'id_schedule': id_schedule,'id_ticket_type':id_ticket_type},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\t},'json');\n\n\t\tsetTimeout(function() \n\t\t{\n\t\t\tlocation.href='/ticket/schedule';\n\t\t}, '1000');\n\t}\n}\n\nfunction mark_invoice(id_invoice, set_to, confirm_status, testing = false)\n{\n\tvar confirm_value = (typeof confirm_status === false) ? false : true;\n\n\tif (confirm_status == false)\n\t{\n\t\tconfirm_value\t= confirm('Are you sure want to change status of this invoice?');\n\t}\n\t\n\tif (confirm_value == true)\n\t{\n\t\tvar reason\t\t= '';\n\n\t\tif (set_to == 9)\n\t\t{\n\t\t\treason\t= prompt(\"Attention! Cancel action only able to do in the same day as the transaction. \\nCancelation Reason : \", '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the reason for cancelation.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\n\t\tif (set_to == 10)\n\t\t{\n\t\t\treason\t= prompt('Reason for Refund : ', '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the reason for refund.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\n\t\tif (set_to == 14)\n\t\t{\n\t\t\treason\t= prompt('Reason for Refund : ', '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the reason for ticket refund.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\n\t\tif (set_to == 15)\n\t\t{\n\t\t\treason\t= prompt('Reason for Refund : ', '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the reason for shipping refund.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\n\t\tif (set_to == 13)\n\t\t{\n\t\t\treason\t= prompt('Refunded Note : ', '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the note for refunded.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\t\t\n\t\t$.post('/ajax_data/mark_invoice',{'id_invoice':id_invoice, set_to:set_to, reason:reason, refund_type:confirm_status, testing},function(data)\n\t\t{\n\t\t\tif (!data.error)\n\t\t\t{\n\t\t\t\t$(\"#status_invoice_\"+id_invoice).html(data.status_invoice);\n\t\t\t\t$(\"#dropdown_menu_\"+id_invoice).html(data.dropdown_menu);\n\t\t\t}\n\n\t\t\talert(data.message);\n\t\t\tlocation.reload();\n\t\t},'json');\n\t}\n}\n\nfunction mark_invoice_installment(id_invoice_installment, set_to)\n{\n\tif (confirm('Are you sure want to change status of this invoice?'))\n\t{\n\t\tvar reason\t\t= '';\n\t\tif (set_to == 9)\n\t\t{\n\t\t\treason\t= prompt('Cancelation Reason : ', '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the reason for cancelation.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\n\t\tif (set_to == 12)\n\t\t{\n\t\t\treason\t= prompt('Reason for deletion : ', '');\n\t\t\tif (reason.trim() == '')\n\t\t\t{\n\t\t\t\talert('Fill the reason for deletion.');\n\t\t\t\treturn;\n\t\t\t}\n\t\t}\n\n\t\t$.post('/ajax_data/mark_invoice_installment',{'id_invoice_installment':id_invoice_installment, set_to:set_to, reason:reason},function(data)\n\t\t{\n\t\t\tif (!data.error)\n\t\t\t{\n\t\t\t\t$(\"#status_invoice_\"+id_invoice_installment).html(data.status_invoice);\n\t\t\t\t$(\"#dropdown_menu_\"+id_invoice_installment).html(data.dropdown_menu);\n\t\t\t}\n\n\t\t\talert(data.message);\n\n\t\t\tlocation.reload();\n\t\t},'json');\n\t}\n}\n\nfunction send_email(id_template, type)\n{\n\temail_test\t= $(\".email_test\").val();\n\n\t$.post('/ajax_data/send_email',{'id_template':id_template, 'email_test':email_test,'type':type},function(data)\n\t{\n\t\talert(data.message);\n\t},'json');\n}\n\nfunction save_template(id_schedule)\n{\n\t$('.btn_save').attr(\"disabled\", true);\n\t$('.btn_save').html(\"Loading...\");\n\t\n\tcontent_template\t= $('.content_template').html();\n    check_ticket_id     = $('#id_ticket_type').length;\n    \n    if(check_ticket_id)\n    {\n        id_ticket_type      = $('#id_ticket_type').val();\n\t\t$.ajax({\n\t\t\ttype : 'POST',\n\t\t\turl  : '/ajax_data/save_template',\n\t\t\tdata : \n\t\t\t{\n\t\t\t\t'id_schedule' : id_schedule,\n\t\t\t\t'id_ticket_type' : id_ticket_type,\n\t\t\t\t'content_template' : content_template,\n\t\t\t},\n\t\t\tsuccess : function(data){\n\t\t\t\talert(data.message);\n\t\t\t\t$('.btn_save').attr(\"disabled\", false);\n            \t$('.btn_save').html(\"Save\");\n\t\t\t}\n\t\t});\n    }\n\n    else \n    {\n        $.post('/ajax_data/save_template',{'id_schedule':id_schedule, 'content_template':content_template},function(data)\n        {\n            alert(data.message);\n    \n            $('.btn_save').attr(\"disabled\", false);\n            $('.btn_save').html(\"Save\");\n        },'json');\n    }\n}\n\nfunction save_template_ereceipt(id_schedule)\n{\n    $('.btn_save').attr(\"disabled\", true);\n    $('.btn_save').html(\"Loading...\");\n\n    content_template    = $('.content_template').html();\n    id_template         = $('#id_template').val();\n\n    $.post('/ticket/schedule/ereceipt/update',{\n        'id_schedule':id_schedule, \n        'id_template':id_template,\n        'content_template':content_template\n    }, function(data) {\n        alert(data.message);\n\n        $('.btn_save').attr(\"disabled\", false);\n        $('.btn_save').html(\"Save\");\n    },'json');\n}\n\nfunction save_template_evoucher(id_schedule)\n{\n    $('.btn_save').attr(\"disabled\", true);\n    $('.btn_save').html(\"Loading...\");\n\n    content_template    = $('.content_template').html();\n    id_template         = $('#id_template').val();\n\n    $.post('/ticket/schedule/evoucher_v1/update',{\n        'id_schedule':id_schedule, \n        'id_template':id_template,\n        'content_template':content_template\n    }, function(data) {\n        alert(data.message);\n\n        $('.btn_save').attr(\"disabled\", false);\n        $('.btn_save').html(\"Save\");\n    },'json');\n}\n\nfunction save_template_evoucher_v2(id_schedule)\n{\n    $('.btn_save').attr(\"disabled\", true);\n    $('.btn_save').html(\"Loading...\");\n\n    content_template    = $('.content_template').html();\n    id_template         = $('#id_template').val();\n\n    $.post('/ticket/schedule/evoucher_v2/update',{\n        'id_schedule':id_schedule, \n        'id_template':id_template,\n        'content_template':content_template\n    }, function(data) {\n        alert(data.message);\n\n        $('.btn_save').attr(\"disabled\", false);\n        $('.btn_save').html(\"Save\");\n    },'json');\n}\n\nfunction save_template_evoucher_ticket_type(id_schedule, id_ticket_type)\n{\n    $('.btn_save').attr(\"disabled\", true);\n    $('.btn_save').html(\"Loading...\");\n\n    content_template    = $('.content_template').html();\n    id_template         = $('#id_template').val();\n\n    $.post('/ticket/schedule/evoucher_ticket_type/update',{\n        'id_ticket_type':id_ticket_type,\n        'id_schedule':id_schedule, \n        'id_template':id_template,\n        'content_template':content_template\n    }, function(data) {\n        alert(data.message);\n\n        $('.btn_save').attr(\"disabled\", false);\n        $('.btn_save').html(\"Save\");\n    },'json');\n}\n\nfunction save_booking_confirmation_template(id_schedule) {\n\t{\n\t\t$('.btn_save').attr(\"disabled\", true);\n\t\t$('.btn_save').html(\"Loading...\");\n\t\t\n\t\tcontent_template\t= $('.content_template').html();\n\t\t\t\n\t\t$.post('/ajax_data/save_booking_confirmation_template',{'id_schedule':id_schedule, 'content_template':content_template},function(data)\n\t\t{\n\t\t\talert(data.message);\n\t\n\t\t\t$('.btn_save').attr(\"disabled\", false);\n\t\t\t$('.btn_save').html(\"Save\");\n\t\t},'json');\n\t}\n}\n\nfunction set_image_evoucher(image_type, text_prompt)\n{\n    let a = $('#a-'+image_type);\n    console.log(a);\n    if (a != undefined && a.size() > 0) {\n        let target = $(a).attr('href');\n        let img = a.find('img');\n        let url = img.attr('src');\n        $('#input-image-url').val(url);\n        $('#input-target').val(target);\n    } else {\n        $('#input-image-url').val(\"\");\n        $('#input-target').val(\"\");\n    }\n    $('#modal-set-image-url-title').text(text_prompt);\n    $('#btn-submit-set-image-url').attr('data-image_type', image_type);\n    $('#modal-set-image-url').modal({\n        show\t: true,\n        backdrop: false,\n        keyboard: true\n    });\n}\n\nfunction save_image_evoucher()\n{\n    let type = $('#btn-submit-set-image-url').attr('data-image_type');\n    let src = $('#input-image-url').val();\n    let target = $('#input-target').val();\n    \n    if (src != '' && src.trim() != '')\n        $('.image_'+type).attr('src', src);\n\n    if (target != '#' && target != ''){\n        let a = $('#a-'+type);\n        if (a.length > 0) {\n            a.attr('href', target);\n        } else {\n            let img = $('.image_'+type).first();\n            let div = $('.image_'+type).closest('div');\n            let a = '<a id=\"a-'+type+'\" href=\"'+target+'\" target=\"_blank\"></a>';\n            div.append(a);\n            $('#a-'+type).append(img);\n        }\n    } else {\n        let a = $('#a-'+type);\n        if (a.length > 0) {\n            let img = $(a).find('img');\n            let div = $(img).closest('div');\n            div.append(img);\n            div.children('a').remove();\n        }\n    }\n    \n    $('#modal-set-image-url').modal('hide');\n}\n\n\nfunction set_custom_link(target)\n{\n\ttext_prompt\t= 'Insert Custom Link :';\n\tcustom_link\t= prompt(text_prompt, '');\n\t\n\tif (custom_link == '' || custom_link.trim() == '')\n\t{\n\t\treturn;\n\t}\n\n\t$(`.${target}`).attr('href', custom_link);\n}\n\n// Async Downloader \n$.AsyncDownloader = (function() {\n\treturn {\n\t\tlimit: 500,\n\t\turl: '',\n        postData: '',\n\t\turlDownload: '',\n\t\tbutton: '',\n\t\tloading: '<img src=\"/themes_1.0/img/loading.gif\" alt=\"loading\"/> Downloading ',\n\t\tbuttonLabel: '',\n\t\tdownloadID: '',\n\t\tisDownloadParsial: false,\n\t\tcounter: 0,\n\t\ttotal_data: 0,\n\t\tsetButton: function(button) {\n\t\t\tvar self = this;\n\t\t\tif (!typeof button == 'object') {\n\t\t\t\tconsole.error('Invalid typeof button');\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tself.button = button;\n\t\t\treturn this;\n\t\t},\n\t\tsetURL: function(url) {\n\t\t\tthis.url = url;\n\t\t\treturn this;\n\t\t},\n\t\tsetURLDownload: function(url) {\n\t\t\tthis.urlDownload = url;\n\t\t\treturn this;\n\t\t},\n\t\tsetDownloadID: function(id) {\n\t\t\tthis.downloadID = id;\n\t\t\treturn this;\n\t\t},\n\t\tsetDownloadParsial: function(bool) {\n\t\t\tthis.isDownloadParsial = bool;\n\t\t\treturn this;\n\t\t},\n\t\tsetLimit: function(limit) {\n\t\t\tthis.limit = limit;\n\t\t\treturn this;\n\t\t},\n        setPostData: function(postData) {\n\t\t\tthis.postData = postData;\n\t\t\treturn this;\n\t\t},\n\t\tstartDownload: function() {\n\t\t\tvar self = this;\n\t\t\tself.buttonLabel = self.button.text();\n\n\t\t\tif (self.url != '' && self.button != '') {\n\t\t\t\tself.download(0,0,0);\n\t\t\t}\n\t\t},\n\t\tdownload: function (start, counter, last_id) {\n\t\t\tvar self = this;\n\t\t\tconsole.log({start: start + self.limit, counter: counter, last_id: last_id})\n\t\t\tself.showProgress();\n            if(self.postData)\n            {\n                let url = self.url + '&start=' + start + '&counter=' + counter + '&last_id=' + last_id;\n                $.post(url, self.postData).done(function(data)\n                {\n                    data = JSON.parse(data)\n                    if (data.response == 'ok') {\n                        self.counter = data.counter;\n                        self.total_data = data.total;\n                        if (self.isDownloadParsial)\n                            self.downloadParsial(data.start);\n\n                        setTimeout(function(){\n                            self.download(start + self.limit, data.counter, data.last_id);\n                        }, 1000);\n                    }\n                    else if (data.response == 'completed') {\n                        if (self.isDownloadParsial)\n                            self.finishDownloadParsial();\n                        else\n                            self.finishDownload();\n                        self.resetProgress();\n                    }\n                    else {\n                        if (data.message)\n                            alert(data.message);\n                        else\n                            alert('An error occurred, please try again')\n                        self.resetButton(self.buttonLabel);\n                    }\n                })\n                .error(function(xhr,status,error){\n                    alert('Something wrong! Please check your internet connection and try again.');\n                    console.error(status + ' : ' + error);\n                    self.resetButton(self.buttonLabel);\n                });\n\n            } \n            else \n            {\n                $.getJSON(self.url + '&start=' + start + '&counter=' + counter + '&last_id=' + last_id,{})\n                .done(function(data)\n                {\n                    if (data.response == 'ok') {\n                        self.counter = data.counter;\n                        self.total_data = data.total;\n                        if (self.isDownloadParsial)\n                            self.downloadParsial(data.start);\n\n                        setTimeout(function(){\n                            self.download(start + self.limit, data.counter, data.last_id);\n                        }, 1000);\n                    }\n                    else if (data.response == 'completed') {\n                        if (self.isDownloadParsial)\n                            self.finishDownloadParsial();\n                        else\n                            self.finishDownload();\n                        self.resetProgress();\n                    }\n                    else {\n                        if (data.message)\n                            alert(data.message);\n                        else\n                            alert('An error occurred, please try again')\n                        self.resetButton(self.buttonLabel);\n                    }\n                })\n                .error(function(xhr,status,error){\n                    alert('Something wrong! Please check your internet connection and try again.');\n                    console.error(status + ' : ' + error);\n                    self.resetButton(self.buttonLabel);\n                });\n\n            }\n\t\t\t\n\t\t},\n\t\tfinishDownload: function () {\n\t\t\tvar self = this;\n\t\t\tvar url = location.origin + self.urlDownload + self.downloadID;\n\t\t\tlocation.href = url;\n\t\t\tself.resetButton(self.buttonLabel);\n\t\t\tconsole.log('Download complete');\n\t\t},\n\t\tdownloadParsial: function(start) {\n\t\t\tvar self = this;\n\t\t\tvar url = location.origin + self.urlDownload + start;\n\t\t\twindow.open(url)\n\t\t},\n\t\tfinishDownloadParsial: function () {\n\t\t\tvar self = this;\n\t\t\tself.resetButton('Download complete');\n\t\t\tconsole.log('Download parsial complete');\n\t\t},\n\t\tresetButton: function(text) {\n\t\t\tvar self = this\n\t\t\tself.button.removeClass('loading')\n\t\t\t\t.html(text);\n\t\t},\n\t\tshowProgress: function() {\n\t\t\tvar self = this,\n\t\t\t\tprogress = '';\n\t\t\tif (self.total_data > 0) {\n\t\t\t\tprog = Math.round(self.counter / self.total_data * 100);\n\t\t\t\tprog = prog > 100 ? 100 : prog;\n\t\t\t\tprogress = prog + '%';\n\t\t\t}\n\t\t\telse {\n\t\t\t\tprogress = self.counter;\n\t\t\t}\n\t\t\tself.button.html(self.loading + '('+ progress +')');\n\t\t},\n\t\tresetProgress: function() {\n\t\t\tthis.counter = this.total_data = 0;\n\t\t}\n\t}\n});\n\n// number format\nNumber.prototype.formatMoney = function(c, d, t){\n\tvar n = this,\n\t\tc = isNaN(c = Math.abs(c)) ? 2 : c,\n\t\td = d == undefined ? \".\" : d,\n\t\tt = t == undefined ? \",\" : t,\n\t\ts = n < 0 ? \"-\" : \"\",\n\t\ti = parseInt(n = Math.abs(+n || 0).toFixed(c)) + \"\",\n\t\tj = (j = i.length) > 3 ? j % 3 : 0;\n\treturn s + (j ? i.substr(0, j) + t : \"\") + i.substr(j).replace(/(\\d{3})(?=\\d)/g, \"$1\" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : \"\");\n};\n\n// bootbox.addLocale('en_loket',{\n// \tOK \t\t: 'Ok',\n// \tCANCEL\t: 'Cancel',\n// \tCONFIRM\t: 'Confirm'\n// });\n// bootbox.setLocale('en_loket');\n\nfunction save_log_token(response, gross_amount, id_invoice, vendor_pg)\n{\n\t$.post('/ajax_data/save_log_token',{'response':response, 'gross_amount':gross_amount, 'id_invoice':id_invoice},function(data)\n\t{\n\t\tconsole.log('saved log');\n\t},'json');\n}\n\nfunction recount_summary_report(total_ticket, total_sold, total_invoice, total_discount, total_revenue, total_progress)\n{\n\t$(\"#total_ticket\").html(total_ticket);\n\t$(\"#total_sold\").html(total_sold);\n\t$(\"#total_invoice\").html(total_invoice);\n\t$(\"#total_discount\").html(total_discount);\n\t$(\"#total_revenue\").html(total_revenue);\n\t$(\"#total_progress\").html(total_progress);\n}\n\nfunction get_dropdown_ticket_group(id_schedule)\n{\n\tif ($.isNumeric(id_schedule))\n\t{\n\t\t$(\".id_group_div\").addClass('hidden');\n\t\t$(\"#div_group_\" + id_schedule).removeClass('hidden');\n\n\t\t$(\".id_group_dropdown\").attr('name', '');\n\t\t$(\"#dropdown_group_\" + id_schedule).attr('name', 'id_group');\n\t}\n\telse\n\t{\n\t\t$(\".id_group_div\").addClass('hidden');\n\t\t$(\".id_group_dropdown\").attr('name', '');\n\t}\n}\n\nfunction recreate_invoice_va(id_invoice_installment)\n{\n\tif (confirm('Are you sure want to recreate new invoice?')) {\n\t\t$.post('/ajax_data/recreate_invoice_va10', { id_invoice_installment: id_invoice_installment}, function(data) {\n\t\t\talert(data.message);\n\t\t\tif (!data.error)\n\t\t\t\tlocation.reload();\n\t\t}, 'json');\n\t}\n}\n\nfunction remove_character_from_string(value) {\n\treturn value.replace(/[`~!@#$%^&*()_|+\\-=?;:'\",.<>\\{\\}\\[\\]\\\\\\/]/gi, '');\n}\n\nfunction formatRupiah(angka, prefix) \n{\n\tvar number_string = angka.replace(/[^\\d]/g, \"\").toString()\n\tsplit = parseInt(number_string).toString().split(\",\"),\n\tsisa = split[0].length % 3,\n\trupiah = split[0].substr(0, sisa),\n\tribuan = split[0].substr(sisa).match(/\\d{3}/gi);\n\n  // tambahkan titik jika yang di input sudah menjadi angka ribuan\n  if (ribuan) {\n\tseparator = sisa ? \".\" : \"\";\n\trupiah += separator + ribuan.join(\".\");\n  }\n\n  rupiah = split[1] != undefined ? rupiah + \",\" + split[1] : rupiah;\n  return prefix == undefined ? rupiah : rupiah ? \"Rp\" + rupiah : \"\";\n}\n\nfunction getCurrentUrl() {\n\tlet location = window.location\n\treturn (location.origin).concat(location.pathname).concat(location.hash)\n}\n\n\nfunction inputValidation(rules, values, lang = 'ind') {\n    let errors = [];\n    let error_sections = [];\n\n    for (let field in rules) {\n        if (rules[field][\"label\"] == undefined || rules[field][\"rule\"] == undefined)\n            continue;\n        \n        let rule = rules[field][\"rule\"];\n        let label = rules[field][\"label\"];\n        let label_ind = label;\n        if (rules[field][\"label_ind\"] != undefined)\n            label_ind = rules[field][\"label_ind\"]\n        let section = null;\n        if (rules[field][\"section\"] != undefined)\n            section = rules[field][\"section\"];\n\n        let arr_rule = rule.split(\"|\");\n        for (let idx in arr_rule) {\n            let key = arr_rule[idx];\n            let compare_val = null;\n            let key_list = null;\n            \n            let arr_key = key.split(\":\");\n            if (arr_key.length > 1) {\n                key = arr_key[0];\n                compare_val = arr_key[1];\n                if (key == 'in_list') {\n                    key_list = compare_val.split(',');\n                    compare_val = null;\n                }\n            }\n\n            let is_error = false;\n            switch (key) {\n                case \"required\":\n                    if (values[field] == undefined || values[field].length == 0){\n                        is_error = true;\n                        \n                        let message = \"Field \"+ label +\" is required.\";\n                        if (lang == 'ind')\n                            message = \"Kolom \"+ label_ind +\" wajib diisi.\";\n                        \n                        errors.push(message)\n                        if (section != null) {\n                            let error_section = {\n                                'section': section,\n                                'message': message\n                            }; \n                            error_sections.push(error_section);\n                        }\n                    }\n                    break;\n                case \"numeric\":\n                    if (values[field] == undefined || values[field].length == 0 || isNaN(values[field])){\n                        is_error = true;\n                        \n                        let message = \"Field \"+ label +\" must be numeric value.\";\n                        if (lang == 'ind')\n                            message = \"Kolom \"+ label_ind +\" harus berupa angka.\";\n                        \n                        errors.push(message)\n                        if (section != null) {\n                            let error_section = {\n                                'section': section,\n                                'message': message\n                            }; \n                            error_sections.push(error_section);\n                        }\n                    }\n                    break;\n                case \"char_greater_than\": \n                    if (values[field] == undefined || values[field].length <= Number(compare_val)){\n                        is_error = true;\n                        \n                        let message = \"Field \"+ label +\" must greater than \"+ Number(compare_val) +\" character.\";\n                        if (lang == 'ind')\n                            message = \"Kolom \"+ label_ind +\" harus lebih dari \"+ Number(compare_val) +\" karakter.\";\n\n                        errors.push(message)\n                        if (section != null) {\n                            let error_section = {\n                                'section': section,\n                                'message': message\n                            }; \n                            error_sections.push(error_section);\n                        }\n                    }\n                    break;\n                case \"char_less_than\":\n                    if (values[field] == undefined || values[field].length >= Number(compare_val)){\n                        is_error = true;\n                        \n                        let message = \"Field \"+ label +\" must less than \"+ Number(compare_val) +\" character.\";\n                        if (lang == 'ind')\n                            message = \"Kolom \"+ label_ind +\" harus kurang dari \"+ Number(compare_val) +\" karakter.\";\n\n                        errors.push(message)\n                        if (section != null) {\n                            let error_section = {\n                                'section': section,\n                                'message': message\n                            }; \n                            error_sections.push(error_section);\n                        }\n                    }\n                    break;\n                case \"in_list\":\n                    if (values[field] == undefined || !key_list.includes(values[field])){\n                        is_error = true;\n                        \n                        let message = \"Field \"+ label +\" must in the predefined values.\";\n                        if (lang == 'ind')\n                            message = \"Kolom \"+ label_ind +\" harus salah satu dari nilai yang ditentukan.\";\n                        \n                        errors.push(message)\n                        if (section != null) {\n                            let error_section = {\n                                'section': section,\n                                'message': message\n                            }; \n                            error_sections.push(error_section);\n                        }\n                    }\n                    break;\n                default:\n                    break;\n            }\n            if (is_error)\n                break;\n        }\n    }\n\n    for (let idx in error_sections){\n        let error_section = error_sections[idx];\n        $(error_section['section']).html(error_section['message']);\n    }\n\n    return errors;\n}\n\nfunction fetch_event_topic(id_parent_topic, selected_event_topic = 0) {\n    $.ajax({\n        url: '/ajax_data/get_topic_by_parent/' + id_parent_topic,\n        type: 'GET',\n        dataType: 'json',\n        success: function (response) {\n            var len = response.length;\n            $(\"select[name='event_topic']\").empty();\n            $(\"select[name='event_topic']\").append('<option selected disabled>Select Sub Category</option>');\n\t\t\tconst topic_exist =  response.some(item => item.id_topic == selected_event_topic)\n            for (let i = 0; i < len; i++) {\n                var id_topic = response[i]['id_topic'];\n                var name = response[i]['name'];\n\t\t\t\tlet checked = i == 0\n\t\t\t\tif (topic_exist && selected_event_topic == id_topic) {\n\t\t\t\t\tchecked = true\n\t\t\t\t}\n                let is_selected = checked ? 'selected' : '';\n                let item = `<option value='${id_topic}' ${is_selected}> ${name} </option>`\n                $(\"select[name='event_topic']\").append(item);\n            }\n        }\n    });\n}\n"
          },
