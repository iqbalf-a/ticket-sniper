              "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-ancestors 'self' *.loket.com *.loket.id;, default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-ancestors 'self' *.loket.com *.loket.id go-tix.id *.go-tix.id gojek.com *.gojek.com persib.co.id *.persib.co.id persibstore.id *.persibstore.id;"
            },
            {
              "name": "cache-control",
              "value": "max-age=14400"
            },
            {
              "name": "referrer-policy",
              "value": "strict-origin, strict-origin"
            },
            {
              "name": "cf-ray",
              "value": "a00115211e9fd9e8-CGK"
            },
            {
              "name": "x-xss-protection",
              "value": "1; mode=block, 1; mode=block"
            },
            {
              "name": "server",
              "value": "cloudflare"
            }
          ],
          "cookies": [],
          "content": {
            "size": 96747,
            "mimeType": "application/javascript",
            "text": "function WidgetKrilin(options = {}) {\n    const requiredOptions = ['eventType', 'selector', 'arrivalDate', 'type', 'widgetCode', 'csrfToken', 'groupId', 'widgetTimer'];\n    requiredOptions.forEach(item => {\n        // validate user input\n        if (!options.hasOwnProperty(item)) throw new Error(`Options ${item} is required!`);\n        // cast options\n        if (['eventType'].includes(item))\n        {\n            const intValue = parseInt(options[item])\n            options[item] = intValue\n        }\n    })\n    const modalConfirmation = document.getElementById('modal-back')\n    const previousButton = document.querySelectorAll('#btn-previous')\n    const confirmationPreviousButton = document.querySelector('.btn-ok')\n    const isSameTicketField = document.querySelector('input[name=\"is_same_ticket\"]')\n    const STATUS_FULLBOOKED = 6;\n    let isSameTicket = false \n    if (isSameTicketField)\n    {\n        isSameTicket = [1, '1'].includes(isSameTicketField.value)\n    }\n    const {widgetCode, widgetTimer, currencyCode, decimal, scaleFactor, limitAddOn} = options\n    const storageKey = `ticket_${widgetCode}`\n    const step = {\n        SELECT_TICKET: 'step-1',\n        PERSONAL_INFORMATION: 'step-2',\n        CONFIRMATION: 'step-3',\n        CHECKOUT: 'step-4',\n        PAYMENT_COMPLETE: 'step-paycomplete'\n    }\n    const { maxTransaction, minTransaction, type, eventType, arrivalDate, currentStep, csrfToken, groupId } = options\n    return {\n        isLoading: false,\n        validForm: true,\n        selectedTickets: [],\n        MAX_TRANSACTION: maxTransaction, \n        MIN_TRANSACTION: minTransaction,\n        EVENT_TYPE: eventType, \n        SELECT_TYPE: 1, \n        PICKER_TYPE: 2,\n        DAILY_EVENT: 1,\n        selectedPayment: '',\n        selectedCoupon: '',\n        selectedParentPayment: '',\n        selectedInsuranceProductGroup: '',\n        paymentName: '',\n        coupons: [],\n        csrfToken,\n        getTotalSelectedTicket()\n        {\n            const self = this\n            if (type == self.SELECT_TYPE && currentStep == step.SELECT_TICKET)\n            {\n                let value = 0;\n                const {select} = options.selector\n                select.forEach(item => {\n                    value += parseInt(item.value)\n                })\n                return value;\n            }\n            let total = this.selectedTickets.reduce((prev, item) =>  prev + parseInt(item.ticketQty),  0)\n            if (total <= 0) total = 1\n            return total\n        },\n        loadFromDatabase(resultTransaction)\n        { \n            if (['', null, 'null', undefined].includes(resultTransaction)) return false;\n            let summary = JSON.parse(resultTransaction)\n            if (!Array.isArray(summary)) return false;\n            this.selectedTickets = this.filterBookedTicket(summary);\n            this.summarizeTicket()\n        },\n        getTotalTicketPrice() {\n            return this.selectedTickets.reduce((prev, item) => prev + parseInt(item.price), 0)\n        },\n        resetCouponForm() \n        {\n            document.querySelectorAll('.form-error').forEach(item => item.classList.remove('form-error'))\n            document.querySelectorAll('.message-box').forEach(item => {\n                item.classList.add('hidden')\n            })\n            document.querySelectorAll('#promocode').forEach(item => {\n                if (!item.hasAttribute('readonly')) item.value = ''\n            }) \n        },\n        updateTicket(data, newData) {\n            const exist  = data.some(item => item.ticketId == newData.ticketId)\n            if (exist) {\n                if (newData.ticketQty <= 0)\n                {\n                    const filteredData = data.filter(item => item.ticketId != newData.ticketId)\n                    this.selectedTickets = filteredData\n                    return;\n                } \n                const index = data.findIndex(item => item.ticketId == newData.ticketId)\n                data[index] = {\n                    ...newData\n                }\n                return;   \n            }\n            if (newData.ticketQty > 0) data.push(newData)\n        },\n        checkQuantity({groupId, ticketId, ticketQty, paywTicket, paywPrice}) {\n            const self = this;\n\n            let formData = new FormData()\n            formData.append('id_group', groupId)\n            formData.append('id_ticket', ticketId)\n            formData.append('ticket_qty', ticketQty)\n            formData.append('csrf_token', csrfToken)\n            formData.append('widget_code', widgetCode)\n            formData.append('ticket_sum', self.getTotalSelectedTicket())\n            formData.append('event_type', self.EVENT_TYPE)\n            if (paywTicket) formData.append('custom_price', paywPrice)\n            if (self.EVENT_TYPE == self.DAILY_EVENT)\n            {\n                formData.append('arrival_date', arrivalDate)\n                const ticketTieringPrice = document.getElementById(`ticket_${groupId}_${ticketId}`)\n                formData.append('ticket_tiering_price', ticketTieringPrice.getAttribute('data-price'))\n            }\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n              method: 'POST',\n              headers: {\n                'Accept': 'application/json',\n                'Content-Type': 'application/x-www-form-urlencoded'\n              },\n              body: requestBody\n            }\n            return fetch('/widget/'+widgetCode+'/check_quantity', httpOptions)\n        },\n        checkQuantityOptions({ element, qty }) {\n            const parentNode = element.parentNode\n            let ticketId = parentNode.getAttribute('id-ticket')\n            let groupId = parentNode.getAttribute('id-group')\n            let ticketName = parentNode.getAttribute('ticket-name')\n            let price = parentNode.getAttribute('price')\n            let paywTicket = ['true'].includes(parentNode.getAttribute('is-payw'))\n            const selector = `ticket_custom_price[${groupId}][${ticketId}]`\n            const paywPrice = document.querySelector(`input[name=\"${selector}\"]`)\n            let result = {\n                ticketId, \n                groupId,\n                ticketName,\n                initialPrice: price,\n                paywTicket,\n                ticketQty: qty\n            }\n            if (paywTicket)\n            {\n                result.initialPrice = paywPrice.value\n                result.paywPrice = paywPrice.value\n            }\n            return result\n        },\n        getTicketData(option, {price, reset_to_zero}) {\n            let qty =  option.ticketQty\n            if (reset_to_zero) qty = 0\n            return {\n                ...option,\n                ticketQty: qty,\n                price: parseInt(price)\n            }\n        },\n        validateSameTicket(ticketId) \n        {\n            if (!isSameTicket) return true;\n            if (this.selectedTickets.length <= 0) return true;\n            const result = this.selectedTickets.map(item => parseInt(item.ticketId))\n            return result.includes(parseInt(ticketId));\n        },\n        hasDigitalMetric() \n        {\n            const digitalMetricRaw = document.querySelector('input[name=\"digital_metric\"]')\n            if (!digitalMetricRaw) return false;\n            const digitalMetric = digitalMetricRaw.value.split('|')\n            if (digitalMetric.length<= 0) return false;\n            return true\n        },\n        handleSelectQuantity(element) {\n            const self = this\n            const parentNode = element.parentNode\n            let ticketId = parentNode.getAttribute('id-ticket')\n            if (!self.validateSameTicket(ticketId) && element.value != 0) {\n                element.value = 0\n                window.createToast(document.querySelector('input[name=\"is_same_ticket_lang\"]').value)\n                return;\n            }\n            let qty = 1\n            if (type == self.SELECT_TYPE) qty = parseInt(element.value)\n            const options = self.checkQuantityOptions({element, qty})\n            self.setLoadingButton(true)\n            self.checkQuantity(options)\n                .then(response => response.json())\n                .then(result => {\n                    const {reset_to_zero, message, error, reload} = result\n                    if (reset_to_zero || error)\n                    {\n                        element.value = 0\n                        if (widgetTimer == null || (widgetTimer != null && widgetTimer > 0))\n                        {\n                            self.onError(message)\n                        \n                            if (reload) {\n                                setTimeout(function() {\n                                    location.reload();\n                                }, 5000);\n                            }\n                        }\n                    }\n                    const data = self.getTicketData(options, result)\n                    self.updateTicket(self.selectedTickets, data)\n                    self.summarizeTicket()\n                })\n                .catch(err => console.log(err))\n                .finally(e => {\n                    self.setLoadingButton(false)\n                })\n        },\n        handleSubmitSelectTicketSeating(self) {\n            modalConfirmation.classList.remove('flex')\n            modalConfirmation.classList.add('hidden')\n            const tnc =  document.getElementById('modal-tnc')\n            if (tnc)\n            {\n                tnc.classList.add('flex')\n                tnc.classList.remove('hidden')\n                return;\n            }\n           \n            if (self.getTotalSelectedTicket() > 0)\n            {\n                if (window.hasOwnProperty('GTM')) {\n                    window\n                        .GTM()\n                        .selectTicket(self.getTotalTicketPrice())\n                }\n            }\n            window.setLoading(true)\n            document.getElementById('form-user').submit()\n        },\n        handleSubmitSelectTicket() {\n            const self = this\n\n            const buttons = document.querySelectorAll('#buy_ticket')\n            for (let index = 0; index < buttons.length; index++) {\n                const element = buttons[index];\n                if (element.classList.contains('button--loading')) return;\n            }\n            const useSeatingChart = [1, true, '1'].includes(document.querySelector('input[name=\"use_seating_chart\"]').value)\n            if (useSeatingChart)\n            {\n                const $seatingChart = $('#seating-chart')\n                const isSingleSeatOpen = $seatingChart.seatingChart('isSingleSeatOpen');\n                if (isSingleSeatOpen) {\n                    createToast(document.querySelector('input[name=\"alert_seating_single_seat\"]').value)\n                    return; \n                }\n                const seats = $seatingChart.seatingChart('getPickedSeats'); \n                if (seats.length > 0) {\n                    modalConfirmation.classList.add('flex')\n                    modalConfirmation.classList.remove('hidden')\n                } else {\n                    return;\n                }\n            } else {\n                const tnc = document.getElementById('modal-tnc')\n                if (tnc)\n                {\n                    tnc.classList.add('flex')\n                    tnc.classList.remove('hidden')\n\n                    const agreeTnc = document.getElementById('btn-agree-tnc')\n                    agreeTnc.addEventListener('click', function (e) {\n                        e.preventDefault()\n                        tnc.classList.add('hidden')\n                        tnc.classList.remove('flex')\n                        if (self.getTotalSelectedTicket() > 0)\n                        {   \n                            window\n                                .GTM()\n                                .selectTicket(self.getTotalTicketPrice())\n                        }\n                        window.setLoading(true)\n                        document.getElementById('form-user').submit()\n                    })\n                }\n                \n                if (self.getTotalSelectedTicket() > 0)\n                {\n                    if (window.hasOwnProperty('GTM'))\n                    {\n                        window\n                            .GTM()\n                            .selectTicket(self.getTotalTicketPrice())\n                    }\n                }\n                if (typeof modalTNC === 'undefined') {\n                    window.setLoading(true);\n                    document.getElementById('form-user').submit()\n                }\n            }\n        },\n        setLoadingButton(isLoading) \n        {\n            const elements = document.querySelectorAll('#buy_ticket')\n            for (let index = 0; index < elements.length; index++) {\n                elements[index].classList.remove('button--loading')\n                if (isLoading) elements[index].classList.add('button--loading')\n            }\n        },\n        handleSubmitRegister(self) {\n            if (typeof modalTNC === 'undefined') {\n                window.setLoading(true);\n                document.getElementById('form-register').submit()\n            }\n        },\n        handleSubmitConfirm(event, self) {\n            const confirmation = document.getElementById('modal-back')\n            const confirmationOk = document.querySelector('.btn-confirmation-ok')\n            const tnc = document.getElementById('modal-tnc')\n            if (self.selectedPayment == '')\n            {\n                if (tnc != undefined)\n                {\n                    tnc.classList.add('flex')\n                    tnc.classList.remove('hidden')\n                    return;\n                }\n                window.setLoading(true)\n                document.getElementById('form-register').submit()\n                return;\n            }\n            let modalConfirmationText = document.querySelector('input[name=\"widget_confirm_payment_submit\"]').value\n            let modalMessage = document.getElementById('modal-message-confirmation')\n            // let paymentName = document.querySelector('.payment-name')\n            let message = modalConfirmationText.replace('$payment_name', self.paymentName)\n            modalMessage.innerText = message\n            confirmation.classList.add('flex')\n            confirmation.classList.remove('hidden')\n            confirmationOk.addEventListener('click', function (event) {\n                if (tnc != undefined) \n                {\n                    confirmation.classList.add('hidden')\n                    confirmation.classList.remove('flex')\n                    tnc.classList.add('flex')\n                    tnc.classList.remove('hidden')\n                    return; \n                }\n                confirmation.classList.remove('flex')\n                confirmation.classList.add('hidden')\n                window.setLoading(true)\n                document.getElementById('form-register').submit() \n            })\n        },\n        handleSubmitComplete() {\n\n        },\n        handleSubmit(event, self) {\n            event.preventDefault()\n            switch (currentStep) {\n                case step.SELECT_TICKET:\n                        self.handleSubmitSelectTicket()\n                    break;\n                case step.PERSONAL_INFORMATION:\n                        self.handleSubmitRegister(self)\n                    break;\n                case step.CONFIRMATION:\n                        self.handleSubmitConfirm(event, self)\n                    break;\n                case step.CHECKOUT:\n                        self.handleSubmitCheckout()\n                    break;\n                case step.PAYMENT_COMPLETE:\n                        self.handleSubmitComplete()\n                    break;\n                default:\n                    break;\n            }\n        },\n        onSelect () {\n            const self = this;\n            const {select} = options.selector\n            select.forEach(item => {\n                let listener = 'change'\n                if (type == self.PICKER_TYPE) listener = 'click'\n                item.addEventListener(listener, function () {\n                    self.handleSelectQuantity(this)\n                })\n            })\n        },\n        onSubmit () {\n            const {submit} = options.selector\n            const self = this;\n            submit.forEach(item => {\n                item.forEach(child => {\n                    child.addEventListener('click', function (event) {\n                        event.preventDefault()\n                        self.handleSubmit(event, self)\n                    })\n                })\n            })\n            const seatingConfirmationOk = document.querySelector('.btn-ok-seating')\n            if (seatingConfirmationOk != undefined) seatingConfirmationOk.addEventListener('click', function (event) {\n                self.handleSubmitSelectTicketSeating(self)\n            })\n        },\n        validateSeatingChart()\n        {\n            const useSeatingChart = [1, true, '1'].includes(document.querySelector('input[name=\"use_seating_chart\"]').value)\n            if (!useSeatingChart) \n            {\n                return;\n            }\n            const $seatingChart = $('#seating-chart')\n            const isSingleSeatOpen = $seatingChart.seatingChart('isSingleSeatOpen');\n            if (isSingleSeatOpen)\n            {\n                throw new Error(document.querySelector('input[name=\"alert_seating_single_seat\"]').value)\n            }\n            const seats = $seatingChart.seatingChart('getPickedSeats'); \n            if (seats.length <= 0)\n            {\n                throw new Error(document.querySelector('input[name=\"choose_ticket\"]').value)\n            }\n            modalConfirmation.classList.add('flex')\n            modalConfirmation.classList.remove('hidde')\n        },\n        onError(message) {\n            window.createToast(message)\n        },\n        runCallback(callbackType) {\n            if (!options.hasOwnProperty('callback') \n                && (typeof options.callback[callbackType] != 'function')) return\n            if (options.callback.hasOwnProperty(callbackType)) options.callback[callbackType]()\n        },\n        formatPrice (price) {\n            if (currencyCode.trim() == 'Rp.' || currencyCode == 'Rp'){\n                return price.toLocaleString('id-ID', {\n                    style: 'currency',\n                    currency: 'IDR',\n                    minimumFractionDigits: 0\n                }).replace(/\\s/g, '');\n            }\n            if (currencyCode == 'RM' || currencyCode == 'MYR') {\n                let fractionDigits = parseInt(decimal);\n                if (!Number.isInteger(fractionDigits) || fractionDigits < 0) fractionDigits = 0;\n                if (fractionDigits > 20) fractionDigits = 20;\n                return currencyCode+price.toLocaleString('en-MY', {\n                    minimumFractionDigits: fractionDigits,\n                    maximumFractionDigits: fractionDigits\n                });\n            }\n            return currencyCode+price.toFixed(decimal);\n        },\n        summarizeTicket()\n        {\n            const self = this\n            const ticket = options.selector['ticket']\n            const summary = options.selector['summary']\n            ticket.innerHTML = ''\n            ticket.forEach(item => item.innerHTML = '')\n            const defaultTicketLabel = document.querySelector('.default-ticket-label').innerHTML\n            if (self.selectedTickets.length == 0)\n            {\n                const defaultTicket = `\n                    <div class=\"flex items-center gap-4 pb-5 border-b\">\n                    <img id=\"ic_ticket\" src=\"${options.icon.evoucher}\" width=\"34\">\n                    <span class=\"text-sm\"> ${defaultTicketLabel} </span>\n                    </div>`;\n                ticket.forEach(item => item.insertAdjacentHTML('afterbegin', defaultTicket))\n                const newSummary = `\n                    <span class=\"text-sm text-muted\"> $label_empty </span>\n                    <span class=\"text-lg font-semibold\"> ${currencyCode}0 </span>\n                    `\n                summary.forEach(item => {\n                    const labelEmpty = item.getAttribute('label-empty').replace('$qty', 0)\n                    item.innerHTML = newSummary.replace('$label_empty', labelEmpty) \n                })\n            }\n            let totalPrice = 0;\n            let totalQty = 0;\n            self.selectedTickets.forEach(({ticketName, initialPrice, price, ticketQty}) => {\n                if (typeof price == \"string\" && (currencyCode.trim() == 'Rp.' || currencyCode == 'Rp')) {\n                    let cleaned = price.replace(/\\./g, \"\");\n                    price = parseInt(cleaned);\n                }\n                let newPrice = initialPrice \n                if (currencyCode.trim() == 'Rp.' || currencyCode == 'Rp') {\n                    newPrice = self.formatPrice(parseInt(newPrice))\n                } else if (currencyCode == 'RM' || currencyCode == 'MYR') {\n                    newPrice = self.formatPrice(parseFloat(newPrice / parseInt(scaleFactor)))\n                }\n                totalPrice += parseInt(price)\n                totalQty += parseInt(ticketQty)\n\n                const newTicket = `\n                    <div class=\"flex items-center gap-4 lg:pb-5 border-b s-tickets a-enter pt-4 lg:pb-2\">\n                    <img src=\"${options.icon.evoucher}\" width=\"34\" />\n                    <div>\n                        <p> ${ticketName} </p>\n                        <p class=\"text-sm text-muted mt-1\" > $label_price </p>\n                    </div>\n                    </div>`\n                ticket.forEach(item => {\n                    let pluralLabel = 'ticket';\n                    if (ticketQty > 1) pluralLabel = 'tickets'\n                    let labelTicket = item.getAttribute('label-ticket').trim()\n                    item.insertAdjacentHTML('afterbegin', newTicket.replace('$label_price', labelTicket.replace('$qty', ticketQty).replace('$price', newPrice).replace('ticket', pluralLabel)))\n                })\n            })\n            let totalFormatted = totalPrice\n            if (currencyCode.trim() == 'Rp.' || currencyCode == 'Rp') {\n                totalFormatted = self.formatPrice(parseInt(totalFormatted))\n            } else if (currencyCode == 'RM' || currencyCode == 'MYR') {\n                totalFormatted = self.formatPrice(parseFloat(totalFormatted / parseInt(scaleFactor)))\n            }\n            const newSummary = `<span class=\"text-sm text-muted\"> $label_empty </span>\n                                <span class=\"text-lg font-semibold\"> ${totalFormatted} </span>`\n            summary.forEach(item => {\n                let pluralLabel = 'ticket';\n                if (totalQty > 1) pluralLabel = 'tickets'\n                const labelEmpty = item.getAttribute('label-empty').replace('$qty', totalQty).replace('ticket', pluralLabel)\n                item.innerHTML = newSummary.replace('$label_empty', labelEmpty)  \n            })\n        },\n        saveToDatabase()\n        {\n            if (window.localStorage == undefined) throw new Error('local storage not supported')\n            window.localStorage.setItem(storageKey, JSON.stringify(this.selectedTickets))\n        },\n        toTicketSummary(tickets) \n        {\n            let resultTickets = [];\n            tickets.forEach(item => {\n                resultTickets.push({\n                    groupId,\n                    initialPrice: `${item.ticket_price}`,\n                    price: parseInt(item.ticket_price) * item.ticket_quantity,\n                    ticketQty: parseInt(item.ticket_quantity),\n                    ticketName: item.ticket_type,\n                    ticketId: item.id_ticket\n                })\n            })\n            return resultTickets\n        },\n        filterBookedTicket(tickets)\n        {\n            return tickets.filter(item => {\n                const node = document.querySelector(`[id-ticket=\"${item.ticketId}\"]`)\n                if (node)\n                {\n                    const statusTicket = node.getAttribute('status-ticket')\n                    if (statusTicket == STATUS_FULLBOOKED) return false\n                    return true;\n                }\n                return true;\n            })\n        },\n        handleClickPreviousButton(event)\n        {\n            event.preventDefault()\n            if (event.target.classList.contains('widget-confirm'))\n            {\n                window.setLoading(true)\n                let targetUrl = event.target.getAttribute('target-url')\n                window.location = targetUrl\n                return;\n            }\n            modalConfirmation.classList.add('flex')\n            modalConfirmation.classList.remove('hidden')\n        },\n        handleConfirmPreviousButton(event)\n        {\n            event.preventDefault()\n            window.setLoading(true)\n            modalConfirmation.classList.add('hidden')\n            modalConfirmation.classList.remove('flex')\n            const url = document.querySelector('input[name=\"back_target_url\"]').value\n            window.location = url\n        },\n        onPrevious()\n        {\n            const self = this\n            if (previousButton.length == 0) return\n            previousButton.forEach(item => {\n                item.addEventListener('click', self.handleClickPreviousButton)\n            })\n        },\n        onConfirmPrevious()\n        {\n            if (confirmationPreviousButton == undefined) return\n            confirmationPreviousButton.addEventListener('click', this.handleConfirmPreviousButton)\n        },\n        handleUnselectPayment()\n        {\n            const checkedPayment = document.querySelectorAll(`[class^='checked_payment']`)\n            const selectedPaymentWrapper = document.getElementById(`payment_${this.selectedPayment}`)\n            for (let i = 0; i < checkedPayment.length; i++)\n            {\n                if (i == 0 && selectedPaymentWrapper != null && selectedPaymentWrapper.nextElementSibling != null)\n                {\n                    selectedPaymentWrapper.nextElementSibling.remove()\n                }\n                if (checkedPayment[i].hasAttribute('checked'))\n                {\n                    checkedPayment[i].removeAttribute('checked')\n                    if (checkedPayment[i].nextElementSibling != null) checkedPayment[i].nextElementSibling.remove()\n                }\n            }\n            const selectedPreferredPaymentWrapper = document.getElementById(`payment_p_${this.selectedPayment}`)\n            for (let i = 0; i < checkedPayment.length; i++)\n            {\n                if (i == 0 && selectedPreferredPaymentWrapper != null && selectedPreferredPaymentWrapper.nextElementSibling != null)\n                {\n                    selectedPreferredPaymentWrapper.nextElementSibling.remove()\n                }\n                if (checkedPayment[i].hasAttribute('checked'))\n                {\n                    checkedPayment[i].removeAttribute('checked')\n                    if (checkedPayment[i].nextElementSibling != null) checkedPayment[i].nextElementSibling.remove()\n                }\n            }\n        },\n        isUseProtection() {\n            const isMobile = window.matchMedia(\"only screen and (max-width: 1024px)\").matches;\n            let protectionField  = document.querySelector('.desktop-protection')\n            if (isMobile)\n                protectionField = document.querySelector('.mobile-protection') \n            if (!protectionField) return false;\n            return protectionField.checked\n        },\n        widgetCalculate(paymentId)\n        {\n            let formData = new FormData()\n            const qty = document.querySelectorAll('span[label=\"qty-123\"]');\n            formData.append('widget_code', widgetCode)\n            formData.append('csrf_token', this.csrfToken)\n            if (!['', undefined, null, 0, NaN].includes(paymentId)) formData.append('id_list_payment', paymentId)\n            qty.forEach(item => {\n              let parentElement = item.parentElement\n              let ticketId = parentElement.getAttribute('id-ticket')\n              let qty = parseInt(item.innerText)\n              if (qty < 0)\n                qty = 0\n              formData.append(`ticket_addons[${ticketId}]`, parseInt(qty))\n            })\n            formData.append('protection', this.isUseProtection() ? 1 : 0)\n            formData.append('id_insurance_product_group', this.selectedInsuranceProductGroup)\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n              method: 'POST',\n              headers: {\n                'Accept': 'application/json',\n                'Content-Type': 'application/x-www-form-urlencoded'\n              },\n              body: requestBody\n            }\n            return fetch('/widget/calculate', httpOptions)\n        },\n        handleEnableCouponPromo()\n        {\n            const inputFieldPromo = document.querySelectorAll('#promocode')\n            const btnSubmitPromo = document.querySelectorAll('#btnsubmitpromo')\n            const promoWrapper = document.getElementsByClassName('promo')\n            if (promoWrapper != null) \n            {\n                inputFieldPromo.forEach(item => {\n                    if (item != null )\n                    {\n                        btnSubmitPromo.forEach(eachButton => {\n                            eachButton.removeAttribute('disabled')\n                            if (this.selectedCoupon != '' && item.value == '') eachButton.setAttribute('disabled', true)\n                        })\n                    }\n                }) \n            }\n        },\n        handleSetDetailPayment(paymentId, result)\n        {\n            const paymentInfoWrapper = $('.payment-info');\n            paymentInfoWrapper.fadeOut('fast')\n            let { error, fee, insurance_fee, tax, grand_total, limit_va, redirect_url, addon, discount, result_promo, lang_free_ticket, payment_info} = result\n            if (error && redirect_url != undefined)\n            {\n                // set alert\n                window.location = redirect_url;\n                return;\n            }\n            if (limit_va && (paymentId == 18))\n            {\n                return;\n            }\n            const invoiceFee = document.querySelectorAll('.invoice_fee')\n            const insuranceFee = document.querySelectorAll('.insurance_fee')\n            const invoiceTax = document.querySelectorAll('.invoice_tax')\n            const invoiceDiscount = document.querySelectorAll('.discount')\n            const invoiceGrandTotal = document.querySelectorAll('.invoice_grand_total')\n            const addonTicketContainer = document.querySelectorAll('.addon-ticket')\n            addonTicketContainer.forEach(wrapper => {\n                wrapper.innerHTML = ''\n                if (addon == undefined) return;\n                addon.detail.forEach(item => {\n                  let quantity = parseInt(item.quantity)\n                  if (quantity > 0)\n                  {\n                    let addonItem = `\n                      <div class=\"flex items-center justify-between mb-1\">\n                        <span> ${item.desc} (x${quantity}) </span>\n                        <span style=\"color: #151416;\"> <?php echo $currency_code; ?> ${item.price} </span>\n                      </div>\n                    `\n                    wrapper.insertAdjacentHTML('afterbegin', addonItem)\n                  }\n                })\n            })\n            const paymentInfo = document.querySelector('#payment-description')\n            paymentInfo.classList.add('hidden')\n            if (payment_info !== '' && paymentInfo && payment_info != undefined) {\n                paymentInfo.classList.remove('hidden')\n                paymentInfoWrapper.fadeIn('fast');\n                paymentInfo.innerHTML = payment_info\n            }\n            if (fee != undefined) invoiceFee.forEach(item => item.innerHTML = fee)\n            invoiceTax.forEach(item => item.innerHTML = tax)\n            invoiceGrandTotal.forEach(item => {\n                item.innerHTML = grand_total\n                item.offsetHeight = item.offsetHeight\n            })\n            insuranceFee.forEach(item => {\n                item.innerHTML = insurance_fee\n                item.parentNode.classList.remove('hidden')\n            })\n            if (!insurance_fee) insuranceFee.forEach(item => item.parentNode.classList.add('hidden'))\n            const info = document.querySelectorAll('.succes-apply')\n            info.forEach(item => item.classList.add('hidden'))\n            if (discount != undefined) {\n                invoiceDiscount.forEach((item, index) => {\n                    const numericalValue = parseInt(discount.replace(/\\D/g, ''));\n                    item.parentNode.classList.add('hidden')\n                    if (numericalValue > 0)\n                    {\n                        item.innerHTML = `-${discount}`\n                        item.parentNode.classList.remove('hidden')\n                        if (index == 0)\n                        {\n                            info.forEach(each_item => {\n                                each_item.classList.remove('hidden')\n                            })\n                        }\n                    }\n                })\n                \n            }\n            const protectionContainer  = document.querySelectorAll('.protection-section')\n            protectionContainer.forEach(container => {\n                container.classList.remove('hidden')\n            })\n            if (result_promo != undefined)\n            {\n                let {data_promo} = result_promo\n                if (data_promo == undefined) data_promo = {}\n                const promos = Object.values(data_promo)\n                const freeTicketContainer = document.querySelectorAll('.free-ticket')\n                freeTicketContainer.forEach(wrapper => {\n                    wrapper.innerHTML = ''\n                    promos.forEach(item => {\n                        let giveawayItem = `\n                        <div class=\"flex items-center justify-between mb-1\">\n                            <span>${lang_free_ticket} ${item.ticket_type} (x${item.qty_ticket_type_extra}) </span>\n                            <span style=\"color: #151416;\"> ${currencyCode} 0 </span>\n                        </div>\n                        ` \n                        wrapper.insertAdjacentHTML('afterbegin', giveawayItem)\n                    })\n                })\n                if (promos.length > 0) \n                {\n                    protectionContainer.forEach(container => {\n                        container.classList.add('hidden')\n                    })\n                }\n            }\n            document.querySelector('input[name=\"selected_payment\"]').value = paymentId\n            document.querySelector('input[name=\"id_list_payment\"]').value = paymentId\n            // if (![0, null, undefined, NaN, ''].includes(paymentId)) {\n            //     let radioPayment = document.getElementById(`payment_${paymentId}`)\n            //     radioPayment.setAttribute('checked', true);\n            // }\n        },\n        handleSelectPayment(self, event)\n        {\n            if (self.isLoading) return\n            self.handleUnselectPayment()\n            self.isLoading = true\n            let idListPayment = event.getAttribute('data-id-list-payment')\n            let idParent = event.getAttribute('id-parent')\n            let radioPayment = document.getElementById(`payment_${idListPayment}`)\n            self.paymentName = radioPayment.getAttribute('payment-name');\n            // let paymentName = radioPayment.getAttribute('payment-name')\n            // let paymentLogo = radioPayment.getAttribute('payment-logo')\n            self.widgetCalculate(idListPayment)\n                .then(response => response.json())\n                .then(result => {\n                    if (result.error) throw result;\n                    \n                    self.selectedPayment = idListPayment\n                    self.selectedParentPayment = idParent\n                    self.handleSetDetailPayment(idListPayment, result)\n                    self.handleEnableCouponPromo()\n                    // self.handleSetPaymentInfo(paymentName, paymentLogo)\n                    let checkIcon = `<img src=\"https://assets.loket.com/widget/ic_correct.svg\" id=\"checked_${idListPayment}\" width=\"20\" height=\"20\" />`\n                    event.insertAdjacentHTML('beforeend', checkIcon) \n                })\n                .catch(error => {\n                    if (widgetTimer != null && widgetTimer > 0){\n                        window.createToast(error.message)\n                        const {reload} = error\n                        if (reload) {\n                            setTimeout(function() {\n                                location.reload();\n                            }, 5000);\n                        }\n                    }\n                })\n                .finally(e =>self.isLoading = false)\n        },\n        handleSetPaymentInfo(paymentName, paymentLogo)\n        {\n            // let paymentInfoWrapper = document.querySelector('.payment-info')\n            // let template = `\n            //     <h6 class=\"text-base payment-name\"> ${paymentName} </h6>\n            //     <img src=\"${paymentLogo}\" width=\"56\" height=\"40\" style=\"width: 56px; height: 40px; object-fit: contain\" />\n            // `\n            if (this.selectedParentPayment != \"\")\n            {\n                const accordionHeader = document.querySelectorAll('.accordion__header')\n                const accordionBody = document.querySelectorAll('.accordion__body')\n                accordionBody.forEach(item => {\n                    const idParentPayment = item.getAttribute('id-parent')\n                    item.classList.remove('is-active')\n                    if (idParentPayment == this.selectedParentPayment)\n                    {\n                        item.classList.add('is-active')\n                    } \n                })\n                accordionHeader.forEach(item => {\n                    const idParentPayment = item.getAttribute('id-parent')\n                    item.classList.remove('is-active')\n                    if (idParentPayment == this.selectedParentPayment)\n                    {\n                        item.classList.add('is-active')\n                    }\n                })\n            } else \n            {\n               \n            }\n            // paymentInfoWrapper.classList.remove('hidden')\n            // paymentInfoWrapper.innerHTML = template \n        },\n        handleLoadSelectedPayment()\n        {\n            const self = this\n            const selectedPaymentWrapper = document.getElementById(`payment_${this.selectedPayment}`)\n            if (!selectedPaymentWrapper) return;\n            if ([null, undefined, ''].includes(self.selectedPayment)) return;\n            const idListPayment = this.selectedPayment\n            let radioPayment = document.getElementById(`payment_${idListPayment}`)\n            // let paymentName = radioPayment.getAttribute('payment-name')\n            // let paymentLogo = radioPayment.getAttribute('payment-logo')\n            self.widgetCalculate(idListPayment)\n                .then(response => response.json())\n                .then(result => {\n                    if (result.error) throw result;\n\n                    const idParentPayment = selectedPaymentWrapper.parentNode.getAttribute('id-parent')\n                    self.selectedParentPayment = idParentPayment\n                    self.handleSetDetailPayment(idListPayment, result)\n                    self.handleEnableCouponPromo()\n                    // self.handleSetPaymentInfo(paymentName, paymentLogo)\n                    let checkIcon = `<img src=\"https://assets.loket.com/widget/ic_correct.svg\" id=\"checked_${idListPayment}\" width=\"20\" height=\"20\" />`\n                    selectedPaymentWrapper.parentElement.insertAdjacentHTML('beforeend', checkIcon)\n                })\n                .catch(error => {\n                    if (widgetTimer != null && widgetTimer > 0){\n                        window.createToast(error.message)\n                        const {reload} = error\n                        if (reload) {\n                            setTimeout(function() {\n                                location.reload();\n                            }, 5000);\n                        }\n                    }\n                })\n                .finally(e => self.isLoading = false) \n        },\n        autoSelectSinglePayment() {\n            const groupPayments = document.querySelectorAll(\n                '.section-payment-method .accordion .accordion__header'\n            );\n\n            if (groupPayments.length !== 1) return;\n\n            const selectedPayment = this.selectedPayment\n            if (selectedPayment !== null && selectedPayment !== undefined && selectedPayment !== '') {\n                return;\n            }\n\n            const header = groupPayments[0];\n            const body = header.nextElementSibling;\n\n            if (!body) {\n                console.warn('Accordion body missing for header.');\n                return;\n            }\n\n            if (!header.classList.contains('is-active')) {\n                header.classList.add('is-active');\n            }\n\n            if (!body.classList.contains('is-active')) {\n                body.classList.add('is-active');\n            }\n\n            const payments = body.querySelectorAll('.payment-list');\n\n            if (payments.length === 0) {\n                console.warn('No payment-list elements found.');\n                return;\n            }\n\n            const firstPayment = payments[0];\n\n            if (!(firstPayment instanceof HTMLElement)) {\n                console.warn('First payment element is not valid.');\n                return;\n            }\n\n            const clickEvent = new Event('click', { bubbles: true });\n            firstPayment.dispatchEvent(clickEvent);\n        },\n        onListPayment() \n        {\n            const self = this\n            const listPayment = document.querySelectorAll(`[id^='list_payment']`)\n            if (listPayment.length <= 0) return\n            self.selectedPayment = document.querySelector('input[name=\"selected_payment\"]').value;\n            listPayment.forEach(item => \n                item.addEventListener('click', function () {\n                    self.handleSelectPayment(self, this)\n                })\n            )\n            self.handleLoadSelectedPayment()\n            self.autoSelectSinglePayment();\n        },\n        getCookie(cname)\n        {\n            var name\t\t= cname + \"=\";\n            var ca\t\t\t= document.cookie.split(';');\n            for (var i=0; i<ca.length; i++)\n            {\n                var c\t\t= ca[i];\n                while (c.charAt(0)==' ') c = c.substring(1);\n                if (c.indexOf(name) == 0) return c.substring(name.length,c.length);\n            }\n            \n            return \"\";\n        },\n        applyFromCard()\n        {\n            const couponType = document.getElementById(\"coupon_type\").value\n            return couponType == 'card'\n        },\n        handleSubmitCoupon(self, event)\n        {\n            let element = event.target\n            if (event.target.classList.contains('button__text')) element = event.target.parentNode\n            event.preventDefault()\n            const labelApply = element.getAttribute('label-apply')\n            const labelRemove = element.getAttribute('label-remove')\n            const inputField = document.querySelectorAll('#promocode')\n            let code = ''\n            inputField.forEach(item => {\n                if (item.value != \"\") code = item.value\n            })\n            if (code == '') return;\n            let formData = new FormData()\n            formData.append('coupon_code', code)\n            formData.append('csrf_token', this.csrfToken)\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n                method: 'POST',\n                headers: {\n                    'Accept': 'application/json',\n                    'Content-Type': 'application/x-www-form-urlencoded'\n                },\n                body: requestBody \n            }\n            element.classList.add('button--loading')\n            let url = `/widget/${widgetCode}/remove_coupon`\n            if (event.target.classList.contains('button-primary') || (event.target.classList.contains('button__text') && event.target.parentNode.classList.contains('button-primary')))\n            {\n                url = `/widget/${widgetCode}/apply_coupon`\n                formData.append('id_list_payment', self.selectedPayment)\n            }\n            fetch(url, httpOptions) \n                .then(response => response.json())\n                .then(({success, message}) => {\n                    if (!success) throw new Error(message)\n                    document.querySelectorAll('#promocode').forEach(item => item.classList.remove('form-error'))\n                    if (element.classList.contains('button-primary'))\n                    {\n                        document.querySelectorAll('#promocode').forEach(item => {\n                            item.classList.add('form-success')\n                            item.setAttribute('readonly', true)\n                        })\n                    }\n                    let label = labelRemove\n                    let buttonStyle = 'button-danger'\n                    element.classList.remove('button-primary')\n                    if (element.classList.contains('button-danger'))\n                    {\n                        document.querySelectorAll('#promocode').forEach(item => {\n                            item.classList.remove('form-success')\n                            item.removeAttribute('readonly')\n                        })\n                        element.classList.remove('button-danger')\n                        label = labelApply\n                        buttonStyle = 'button-primary'\n                        inputField.forEach(item => {\n                            item.value = ''\n                        })\n                    } \n                    document.querySelectorAll('.button__text').forEach(item => item.innerHTML = label) \n                    element.classList.add(buttonStyle)\n                    const modal = document.querySelector('#modal-coupon')\n                    document.querySelectorAll('.message-box').forEach(item => {\n                            item.classList.remove('error-message')\n                            item.classList.add('hidden')\n                    })\n                    if(document.getElementById(\"coupon_type\"))\n                    {\n                        document.getElementById('coupon_type').value = 'input'\n                    }\n                    modal.classList.add('hidden')\n                    modal.classList.remove('flex')\n                })\n                .catch(err => {\n                    document.querySelectorAll('#promocode').forEach(item => item.classList.remove('form-success'))\n                    document.querySelectorAll('#promocode').forEach(item => {\n                        item.classList.add('form-error')\n                        if (item.classList.contains('form-success'))\n                            item.classList.removeAttribute('readonly')\n                    })\n                    document.querySelectorAll('.message-box').forEach(item => {\n                            item.classList.add('error-message')\n                            item.classList.remove('hidden')\n                            item.innerHTML = err.message\n                    })\n                    element.classList.remove('button-danger')\n                    element.classList.add('button-primary')\n                    document.querySelectorAll('.button__text').forEach(item => item.innerHTML = labelApply)\n                })\n                .finally(e => {\n                    element.classList.remove('button--loading')\n                    const paymentId = self.selectedPayment\n                    self.widgetCalculate(paymentId)\n                        .then(response => response.json())\n                            .then(result => {\n                                if (result.error) throw result;\n\n                                self.handleSetDetailPayment(paymentId, result)\n                            })\n                            .catch(error => {\n                                if (widgetTimer != null && widgetTimer > 0){\n                                    window.createToast(error.message)\n                                    const {reload} = error\n                                    if (reload) {\n                                        setTimeout(function() {\n                                            location.reload();\n                                        }, 5000);\n                                    }\n                                }\n                            })\n                            .finally(e => self.isLoading = false)\n                })\n        },\n        hasCoupon() \n        {\n            const button = document.querySelector('#btnsubmitpromo')\n            const input = document.querySelector('#promocode')\n            return button.classList.contains('button-danger') && input.value != ''\n        },\n        createPromoCard(self, coupon) \n        {\n            const labelDetail = document.querySelector('.label-detail')\n            return `\n                <div class=\"coupon-card ${self.selectedCoupon == coupon.code && self.applyFromCard() ? `selected` : ``} ${coupon['is_eligible_to_apply'] && self.selectedPayment > 0 ? `` : `not-applicable`}\" code=\"${coupon.code}\">\n                    <div class=\"coupon-card-left\">\n                        <div class=\"coupon-card-title flex items-center justify-between\">\n                            <label class=\"coupon-card-name ${coupon.is_eligible_to_apply && self.selectedPayment > 0 ? `` : `disabled`}\"> ${coupon.name} </label>\n                            ${coupon.hasOwnProperty('notes') ? `\n                                <a class=\"coupon-card-detail\"> <u code=\"${coupon.code}\">${labelDetail.innerText}</u> </a>\n                            ` : ``}\n                        </div>\n                        <div class=\"coupon-card-desc\">\n                        <div class=\"desc-item\">\n                            <img src=\"https://assets.loket.com/widget/2.0/ic_clock.svg\" />\n                            <label class=\"uk-text-normal\">\n                               ${coupon.end_date}\n                            </label>\n                        </div>\n                        ${coupon.hasOwnProperty('eligible_payments') ? `\n                            <div class=\"desc-item\">\n                                <img src=\"https://assets.loket.com/widget/2.0/ic_wallet.svg\" />\n                                <label class=\"uk-text-normal\">\n                                ${coupon.eligible_payments}\n                                </label>\n                            </div> \n                        ` : ``}\n                        ${coupon.hasOwnProperty('available_days') ? `\n                            <div class=\"desc-item\">\n                                <img src=\"https://assets.loket.com/widget/2.0/ic_schedule.svg\" />\n                                <label class=\"uk-text-normal\">\n                                ${coupon.available_days}\n                                </label>\n                            </div> \n                        ` : ``}\n                        ${coupon.hasOwnProperty('minimum_transaction') ? `\n                            <div class=\"desc-item\">\n                                <img src=\"https://assets.loket.com/widget/2.0/ic_bill.svg\" />\n                                <label class=\"uk-text-normal\">\n                                ${coupon.minimum_transaction}\n                                </label>\n                            </div> \n                        ` : ``}\n                        ${coupon.hasOwnProperty('discount_max') ? `\n                            <div class=\"desc-item\">\n                                <img src=\"https://assets.loket.com/widget/2.0/ic_voucher.svg\" />\n                                <label class=\"uk-text-normal\">\n                                ${coupon.discount_max}\n                                </label>\n                            </div> \n                        ` : ``}\n                         ${coupon.hasOwnProperty('minimum_ticket_quantity') ? `\n                            <div class=\"desc-item\">\n                                <img src=\"https://assets.loket.com/widget/2.0/ic_minimum_quantity.svg\" />\n                                <label class=\"uk-text-normal\">\n                                ${coupon.minimum_ticket_quantity}\n                                </label>\n                            </div> \n                        ` : ``}\n                        ${coupon.hasOwnProperty('availability') ? `\n                                <button label=\"danger\">\n                                ${coupon.availability}\n                                </button>\n                        ` : ``}\n                        </div>\n                    </div>\n                    <div class=\"coupon-card-right\">\n                        <label class=\"coupon-card-radio\">\n                            ${self.selectedCoupon == coupon.code && self.applyFromCard() ? \n                                `<img src=\"https://assets.loket.com/widget/2.0/ic_correct.svg\" />` : `\n                            ${coupon.is_eligible_to_apply ? \n                                `<input type=\"radio\" id=\"coupon_radio_${coupon.code}\" name=\"inp-check-pc-radio\" value=\"${coupon.code}\" />`: `<img src=\"https://assets.loket.com/widget/2.0/coupon/ic_block.svg\" />`}\n                            `}\n                            \n                        </label>\n                    </div>\n                </div>\n            `\n        },\n        handleSelectPromo(self, event)\n        {\n            if (event.classList.contains('not-applicable')) return;\n            const code = event.getAttribute('code')\n            const radio = document.querySelectorAll('input[name=\"inp-check-pc-radio\"]')\n            const modal = document.querySelector('#modal-coupon')\n           \n            const btnSubmitPromo = document.querySelector('#btnsubmitpromo')\n            if (btnSubmitPromo && btnSubmitPromo.classList.contains('button-danger'))\n            {\n                \n            }\n            let formData = new FormData()\n            formData.append('coupon_code', code)\n            formData.append('apply_from', 'card')\n            formData.append('csrf_token', this.csrfToken)\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n                method: 'POST',\n                headers: {\n                    'Accept': 'application/json',\n                    'Content-Type': 'application/x-www-form-urlencoded'\n                },\n                body: requestBody \n            }\n            let url = `/widget/${widgetCode}/apply_coupon`\n            formData.append('id_list_payment', self.selectedPayment)\n            if (event.classList.contains('selected'))\n            {\n                url = `/widget/${widgetCode}/remove_coupon`\n            }\n            return fetch(url, httpOptions)\n                    .then(response => response.json())\n                    .then(({success, message}) => {\n                        if (!success) throw new Error(message)\n                        \n                        if (event.classList.contains('selected'))\n                        {\n                            event.classList.remove('selected')\n                            self.selectedCoupon = ''\n                        } else \n                        {\n                            event.classList.add('selected')\n                            self.selectedCoupon = code\n                        }\n                        if(document.getElementById(\"coupon_type\"))\n                        {\n                            document.getElementById('coupon_type').value = 'card'\n                        }\n                        modal.classList.add('hidden')\n                        modal.classList.remove('flex')\n                    })\n                    .catch(error => {\n                        document.querySelectorAll('.message-box').forEach(item => {\n                                item.classList.add('error-message')\n                                item.classList.remove('hidden')\n                                item.innerHTML = error.message\n                        })\n                    })\n                    .finally(_ => {\n                        radio.forEach(item => {\n                            const value = item.value\n                            if (value == code) \n                            {\n                                if (item.hasAttribute('checked')) item.removeAttribute('checked')\n                                else item.setAttribute('checked', true)\n                            } else  {\n                                if (item.hasAttribute('checked'))\n                                    item.removeAttribute('checked')\n                            }\n                        })\n                        const paymentId = self.selectedPayment\n                        self.widgetCalculate(paymentId)\n                            .then(response => response.json())\n                                .then(result => {\n                                    if (result.error) throw result;\n                                    self.handleSetDetailPayment(paymentId, result)\n                                })\n                                .catch(error => {\n                                    if (widgetTimer != null && widgetTimer > 0){\n                                        window.createToast(error.message)\n                                        const {reload} = error\n                                        if (reload) {\n                                            setTimeout(function() {\n                                                location.reload();\n                                            }, 5000);\n                                        }\n                                    }\n                                })\n                                .finally(e => self.isLoading = false)\n                    })\n        },\n        createPromoDetail(self, couponCode) {\n            const couponInfo = self.coupons.find(item => item.code == couponCode) \n            return  `\n                    <h2 class=\"title\">${couponInfo.name}</h2>\n                    <div class=\"desc-item\">\n                        <img src=\"https://assets.loket.com/widget/2.0/ic_clock_blue.svg\" />\n                        <label class=\"uk-text-normal\">\n                           ${couponInfo.end_date}\n                        </label>\n                    </div>\n                    ${couponInfo.hasOwnProperty('eligible_payments') ? `\n                        <div class=\"desc-item\">\n                            <img src=\"https://assets.loket.com/widget/2.0/ic_wallet_blue.svg\" />\n                            <label class=\"uk-text-normal\">\n                            ${couponInfo.eligible_payments}\n                            </label>\n                        </div> \n                    ` : ``}\n                    ${couponInfo.hasOwnProperty('available_days') ? `\n                        <div class=\"desc-item\">\n                            <img src=\"https://assets.loket.com/widget/2.0/ic_schedule_blue.svg\" />\n                            <label class=\"uk-text-normal\">\n                            ${couponInfo.available_days}\n                            </label>\n                        </div> \n                    ` : ``}\n                    ${couponInfo.hasOwnProperty('minimum_transaction') ? `\n                        <div class=\"desc-item\">\n                            <img src=\"https://assets.loket.com/widget/2.0/ic_bill_blue.svg\" />\n                            <label class=\"uk-text-normal\">\n                            ${couponInfo.minimum_transaction}\n                            </label>\n                        </div> \n                    ` : ``}\n                    ${couponInfo.hasOwnProperty('minimum_ticket_quantity') ? `\n                        <div class=\"desc-item\">\n                            <img src=\"https://assets.loket.com/widget/2.0/ic_minimum_quantity_blue.svg\" style=\"height: 14px\"/>\n                            <label class=\"uk-text-normal\">\n                            ${couponInfo.minimum_ticket_quantity}\n                            </label>\n                        </div> \n                    ` : ``}\n                    ${couponInfo.hasOwnProperty('discount_max') ? `\n                        <div class=\"desc-item\">\n                            <img src=\"https://assets.loket.com/widget/2.0/ic_voucher_blue.svg\" />\n                            <label class=\"uk-text-normal\">\n                            ${couponInfo.discount_max}\n                            </label>\n                        </div> \n                    ` : ``}\n                `\n        },\n        handleOpenTncDetail(self, event) {\n            const couponDetailWrapper = document.querySelector('.coupon-detail')\n            const tncContentWrapper = document.querySelector('.tnc-coupon .content')\n            const backIcon = document.querySelector('.ic-back')\n            const code = event.target.getAttribute('code')\n            const parentContainer = document.querySelector(`.coupon-card[code=\"${code}\"]`)\n            const applicable = !parentContainer.classList.contains('not-applicable')\n            const btnApply = document.querySelector('#btnapplyfromdetail')\n            const applied  = parentContainer.classList.contains('selected')\n\n            const labelApply  = btnApply.getAttribute('label-apply')\n            const labelRemove = btnApply.getAttribute('label-remove')\n\n            btnApply.removeAttribute('disabled')\n            if (!applicable)\n                btnApply.setAttribute('disabled', true)\n\n            btnApply.classList.add('button-primary')\n            let label = labelApply\n            btnApply.classList.remove('button-danger')\n            if (applied)\n            {\n                label = labelRemove\n                btnApply.classList.add('button-danger')\n                btnApply.classList.remove('button-primary')\n            }\n            btnApply.innerHTML = `<span class=\"button__text\" style=\"color: white;\"> ${label} </span>`\n            \n            document.querySelector('.coupon-info').classList.add('hidden')\n            document.querySelector('.private-coupon').classList.add('hidden')\n            document.querySelector('.public-coupon').classList.add('hidden')\n            document.querySelector('.tnc-coupon').classList.remove('hidden')\n            const buttonApplyFromDetail = document.querySelector('#btnapplyfromdetail')\n            couponDetailWrapper.classList.remove('hidden')\n            const modalTitle = document.querySelector('.modal-title')\n            const labelDetailPromo = document.querySelector('.label-detail-promo')\n            const field = event.target\n            const couponCode = field.getAttribute('code')\n            backIcon.classList.remove('hidden')\n            const couponInfo = self.coupons.find(item => item.code == couponCode)\n            couponDetailWrapper.innerHTML = self.createPromoDetail(self, couponCode)\n            tncContentWrapper.innerHTML = couponInfo.notes\n            modalTitle.innerHTML = labelDetailPromo.innerText\n            buttonApplyFromDetail.setAttribute('code', code)\n        },\n        handleOpenModalPromo(self, event)\n        {\n            const modalPromo = document.querySelector('#modal-coupon');\n            const infoPromo = document.querySelector('.info-promo')\n            let label = event.getAttribute('label-cannot-apply-twice') \n            if (self.selectedPayment <= 0) label = event.getAttribute('label-select-payment') \n            infoPromo.innerText = label\n            self.resetCouponForm()\n            \n            let formData = new FormData()\n            formData.append('csrf_token', this.csrfToken)\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n                method: 'POST',\n                headers: {\n                    'Accept': 'application/json',\n                    'Content-Type': 'application/x-www-form-urlencoded'\n                },\n                body: requestBody\n            }\n            return fetch(`/widget/${widgetCode}/promos`, httpOptions)\n                    .then(response => response.json())\n                    .then(result => {\n                        const availablePromo = document.querySelector('.available-promo')\n                        const notAvailablePromo = document.querySelector('.not-available-promo')\n                        availablePromo.innerHTML = ''\n                        notAvailablePromo.innerHTML = ''\n                        let {data} = result\n                        if (!Array.isArray(data)) data = Object.values(result.data)\n                        self.coupons = data\n                        data.forEach(item => {\n                            const promoCard = this.createPromoCard(self, item)\n                            if (item.is_eligible_to_apply)\n                            {\n                                availablePromo.insertAdjacentHTML('afterbegin', promoCard)\n                            } else {\n                                notAvailablePromo.insertAdjacentHTML('afterbegin', promoCard)\n                            }\n                        })\n                        const couponCardDetail = document.querySelectorAll('.coupon-card-detail')\n                        couponCardDetail.forEach(item => {\n                            item.addEventListener('click', function (event) {\n                                event.stopPropagation();\n                                self.handleOpenTncDetail(self, event)\n                            })\n                        })\n                        const closeCouponDetail = document.querySelector('.ic-back')\n                        closeCouponDetail.addEventListener('click', function (event) {\n                            self.handleCloseCouponDetail(false)\n                        })\n                        const notAvailableCoupon = data.filter(item =>item.is_eligible_to_apply == false)\n                        const availableCoupon = data.filter(item => item.is_eligible_to_apply == true)\n                        document.querySelector('.not-applicable-coupon').classList.remove('hidden')\n                        document.querySelector('.not-applicable-divider').classList.remove('hidden')\n                        document.querySelector('.applicable-coupon').classList.remove('hidden')\n                        document.querySelector('.coupon-divider').classList.remove('hidden')\n                        if (notAvailableCoupon.length <= 0)\n                        {\n                            document.querySelector('.not-applicable-coupon').classList.add('hidden')\n                            document.querySelector('.not-applicable-divider').classList.add('hidden')\n                        }\n                        if (availableCoupon.length <= 0)\n                        {\n                            document.querySelector('.applicable-coupon').classList.add('hidden')\n                            document.querySelector('.coupon-divider').classList.add('hidden')\n                        }\n                        // set listener after append node to parent\n                        const couponCard = document.querySelectorAll('.coupon-card')\n                        couponCard.forEach(item => item.addEventListener('click', function (event) {\n                            self.handleSelectPromo(self, this)\n                        }))\n                        document.querySelectorAll('.info-promo').forEach(item => {\n                            item.parentNode.classList.remove('hidden')\n                        })\n                        if (self.selectedPayment != \"\") \n                        {\n                            self.handleEnableCouponPromo()\n                            document.querySelectorAll('.info-promo').forEach(item => {\n                                item.parentNode.classList.add('hidden')\n                            })\n                        }\n                        if (data.length <= 0)\n                        {\n                            document.querySelectorAll('.public-coupon').forEach(item => {\n                                item.classList.add('hidden')\n                                item.classList.remove('flex')\n                            })\n                            document.querySelector('.coupon-divider').classList.add('hidden')\n                        }\n                        modalPromo.classList.remove('hidden')\n                        modalPromo.classList.add('flex')\n                    })\n            \n        },\n        handleCloseCouponDetail(isCloseModal = true) {\n            const modalTitle = document.querySelector('.modal-title')\n            const usePromoLabel = document.querySelector('.label-use-promo').innerText\n            const backIcon = document.querySelector('.ic-back')\n            const privateCoupon = document.querySelector('.private-coupon')\n            const publicCoupon = document.querySelector('.public-coupon')\n            const infoCoupon = document.querySelector('.coupon-info')\n            const couponDetail = document.querySelector('.coupon-detail')\n            const tncCoupon = document.querySelector('.tnc-coupon')\n            backIcon.classList.add('hidden')\n            privateCoupon.classList.remove('hidden')\n            modalTitle.innerHTML = usePromoLabel\n            publicCoupon.classList.remove('hidden')\n            infoCoupon.classList.add('flex')\n            infoCoupon.classList.remove('hidden')\n            couponDetail.classList.add('hidden')\n            couponDetail.classList.remove('flex')\n            tncCoupon.classList.add('hidden')\n            tncCoupon.classList.remove('flex') \n            if (isCloseModal)\n            {\n                const modalPromo = document.querySelector('#modal-coupon');\n                modalPromo.classList.add('hidden')\n                modalPromo.classList.remove('flex')\n            }\n        },\n        onRenderCouponPromo()\n        {\n            const self = this\n            const buttonPromo = document.querySelectorAll('.promo')\n            buttonPromo.forEach(item => {\n                item.addEventListener('click', function () {\n                    self.handleOpenModalPromo(self, this)           \n                })\n            })\n            // apply coupon through text input\n            const submitButton = document.querySelectorAll('#btnsubmitpromo')\n            if (submitButton.length <= 0) return;\n            if (document.querySelector('input[name=\"selected_coupon\"]'))\n                self.selectedCoupon = document.querySelector('input[name=\"selected_coupon\"]').value;\n            submitButton.forEach(item => {\n                item.addEventListener('click', function (event) {\n                    self.handleSubmitCoupon(self, event)\n                }) \n            })\n            const closeModalBtn = document.querySelector('.close-modal')\n            closeModalBtn.addEventListener('click', function (e) {\n                self.handleCloseCouponDetail()\n            })\n\n            // apply coupon through coupon detail\n            const applyFromDetailButton  = document.querySelector('#btnapplyfromdetail')\n            if (applyFromDetailButton)\n            {\n                applyFromDetailButton.addEventListener('click', function (event) {\n                    self.handleApplyFromDetail(self, event.target)           \n                })\n            }\n        },\n        handleApplyFromDetail(self, event) {\n            const code = event.getAttribute('code')\n            const radio = document.querySelectorAll('input[name=\"inp-check-pc-radio\"]')\n            const modal = document.querySelector('#modal-coupon')\n            const labelRemove = event.getAttribute('label-remove')\n            const labelApply = event.getAttribute('label-apply')\n           \n            let formData = new FormData()\n            formData.append('coupon_code', code)\n            formData.append('apply_from', 'card')\n            formData.append('csrf_token', this.csrfToken)\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n                method: 'POST',\n                headers: {\n                    'Accept': 'application/json',\n                    'Content-Type': 'application/x-www-form-urlencoded'\n                },\n                body: requestBody \n            }\n            let url = `/widget/${widgetCode}/apply_coupon`\n            formData.append('id_list_payment', self.selectedPayment)\n            if (event.classList.contains('button-danger'))\n            {\n                url = `/widget/${widgetCode}/remove_coupon`\n            }\n            event.classList.add('button--loading')\n            return fetch(url, httpOptions)\n                    .then(response => response.json())\n                    .then(({success, message}) => {\n                        if (!success) throw new Error(message)\n                        \n                        if (event.classList.contains('button-danger'))\n                        {\n                            event.classList.remove('button-danger')\n                            event.classList.add('button-primary')\n                            event.innerHTML = `<span class=\"button__text\" style=\"color: white;\"> ${labelApply} </span>`\n                            self.selectedCoupon = ''\n                        } else \n                        {\n                            event.classList.remove('button-primary')\n                            event.classList.add('button-danger')\n                            event.innerHTML = `<span class=\"button__text\" style=\"color: white;\"> ${labelRemove} </span>`\n                            self.selectedCoupon = code\n                        }\n                        if(document.getElementById(\"coupon_type\"))\n                        {\n                            document.getElementById('coupon_type').value = 'card'\n                        }\n                        self.handleCloseCouponDetail()\n                    })\n                    .catch(error => {\n                        window.createToast(error.message)\n                    })\n                    .finally(_ => {\n                        event.classList.remove('button--loading')\n                        radio.forEach(item => {\n                            const value = item.value\n                            if (value == code) \n                            {\n                                if (item.hasAttribute('checked')) item.removeAttribute('checked')\n                                else item.setAttribute('checked', true)\n                            } else  {\n                                if (item.hasAttribute('checked'))\n                                    item.removeAttribute('checked')\n                            }\n                        })\n                        const paymentId = self.selectedPayment\n                        self.widgetCalculate(paymentId)\n                            .then(response => response.json())\n                                .then(result => {\n                                    if (result.error) throw result;\n\n                                    self.handleSetDetailPayment(paymentId, result)\n                                })\n                                .catch(error => {\n                                    if (widgetTimer != null && widgetTimer > 0){\n                                        window.createToast(error.message)\n                                        const {reload} = error\n                                        if (reload) {\n                                            setTimeout(function() {\n                                                location.reload();\n                                            }, 5000);\n                                        }\n                                    }\n                                })\n                                .finally(e => self.isLoading = false)\n                    })\n        },\n        handleUnselectAddon() {\n            const thumbnail = document.querySelectorAll('.addon-thumbnail')\n            for(let i = 0; i < thumbnail.length; i++) \n            {\n                if (thumbnail[i].classList.contains('selected'))\n                {\n                    thumbnail[i].classList.remove('selected')\n                }\n            } \n        },\n        handlePreviewAddon(self, event)\n        {\n            self.handleUnselectAddon()\n            let currentIndex = event.target.parentNode.getAttribute('idx')\n            let total = event.target.parentNode.getAttribute('total')\n            let position = event.target.parentNode.getAttribute('position')\n            if (event.target.classList.contains('selected')) return;\n            event.target.parentNode.classList.add('selected')\n            let sourceImage = event.target.currentSrc\n            document.getElementById(`preview_${currentIndex}`).src = sourceImage\n            document.querySelector(`.total-${currentIndex}`).innerHTML = `${position}/${total}`\n        },\n        handleSelectTicketAddon(event, self)\n        {\n            event.target.parentElement.classList.add('hidden');\n            event.target.parentElement.nextElementSibling.classList.remove('hidden')\n            let qty = event.target.parentElement.nextElementSibling.querySelector('[label^=\"qty-123\"]')\n            let ticketId = event.target.parentElement.nextElementSibling.getAttribute('id-ticket')\n            let updatedQty  = 1\n            qty.innerText = updatedQty\n            self.updateAddon(ticketId, updatedQty)\n            self.widgetCalculate(self.selectedPayment)\n                .then(response => response.json())\n                .then(result => {\n                    if (result.error) throw result;\n\n                    self.handleSetDetailPayment(self.selectedPayment, result)\n                    if (parseInt(limitAddOn) == 1) {\n                        self.hadleLimitAddOnDisableOthers(ticketId)\n                    }\n                })\n                .catch(error => {\n                    if (widgetTimer != null && widgetTimer > 0){\n                        window.createToast(error.message)\n                        \n                        event.target.parentElement.classList.remove('hidden');\n                        event.target.parentElement.nextElementSibling.classList.add('hidden')\n                        var revertQty = updatedQty - 1\n                        qty.innerText = revertQty\n                        self.updateAddon(ticketId, revertQty)\n                        \n                        const {reload} = error\n                        if (reload) {\n                            setTimeout(function() {\n                                location.reload();\n                            }, 5000);\n                        }\n                    }\n                })\n                .finally(_ => self.isLoading = false)\n        },\n        hadleLimitAddOnDisableOthers(idTicket)\n        {\n            const select = document.querySelectorAll('button[label=\"default\"]')\n            select.forEach(item => {\n                let currentIdTicket = item.parentElement.getAttribute('id-ticket')\n                if (currentIdTicket != idTicket) {\n                    item.setAttribute(\"disabled\", true);\n                    item.parentElement.parentElement.parentElement.parentElement.classList.add(\"add-on-disable\");\n                }\n            })\n        },\n        hadleLimitAddOnEnableOthers(idTicket)\n        {\n            const select = document.querySelectorAll('button[label=\"default\"]')\n            select.forEach(item => {\n                let currentIdTicket = item.parentElement.getAttribute('id-ticket')\n                if (currentIdTicket != idTicket) {\n                    item.removeAttribute(\"disabled\");\n                    item.parentElement.parentElement.parentElement.parentElement.classList.remove(\"add-on-disable\");\n                }\n            })\n        },\n        updateAddon(idTicket, newValue)\n        {\n            document.querySelector(`[name=\"addon_ticket[${idTicket}]\"]`).value = newValue \n        },\n        handleAddTicketAddon(event, self)\n        {\n            let ticketId = event.target.parentElement.getAttribute('id-ticket')\n            let quantity = event.target.parentNode.querySelector('[label^=\"qty-123\"]')\n            const addonMode = parseInt(event.target.parentNode.getAttribute('addon-mode'))\n            let currentQty = quantity.innerText\n            const cannotGreaterThanOneError = document.querySelector('.addon_cannot_greater_than_one').innerHTML\n            const mustEqualToTotalTicketError = document.querySelector('.total_addon_must_equal_to_total_ticket').innerHTML\n            const maxTransactionAddonError = document.querySelector('.max_transaction_addon').innerHTML\n            if (addonMode == 1 && parseInt(currentQty) >= 1)\n            {\n                window.createToast(cannotGreaterThanOneError)\n                return;\n            }\n            if (addonMode == 2  && (parseInt(currentQty) >= self.getTotalSelectedTicket())) \n            {\n                window.createToast(mustEqualToTotalTicketError)\n                return\n            }\n            let newQty = parseInt(currentQty) + 1\n            let maxQuantity = parseInt(quantity.getAttribute('max'))\n            if (currentQty >= maxQuantity)\n            {\n                window.createToast(maxTransactionAddonError.replace('$maxQuantity', maxQuantity))\n                return;\n            }\n            quantity.innerText = newQty \n            self.updateAddon(ticketId, newQty)\n            self.widgetCalculate(self.selectedPayment)\n                .then(response => response.json())\n                .then(result => {\n                    if (result.error) throw result;\n\n                    self.handleSetDetailPayment(self.selectedPayment, result) \n                })\n                .catch(error => {\n                    if (widgetTimer != null && widgetTimer > 0){\n                        window.createToast(error.message)\n                        const {reload} = error\n                        if (reload) {\n                            setTimeout(function() {\n                                location.reload();\n                            }, 5000);\n                        }\n                    }\n                })\n                .finally(_ => self.isLoading = false)\n        },\n        handleSubstractTicketAddon(event, self)\n        {\n            let ticketId = event.target.parentElement.getAttribute('id-ticket')\n            let quantity = event.target.parentNode.querySelector('[label^=\"qty-123\"]')\n            let currentQty = quantity.innerText\n            let newQty = parseInt(currentQty) - 1\n            if (currentQty < 2)\n            {\n              quantity.innerText = 0;\n              event.target.parentNode.classList.add('hidden')\n              event.target.parentElement.previousElementSibling.classList.remove('hidden')\n            } else {\n              quantity.innerText = newQty\n            }\n            quantity.innerText = newQty \n            self.updateAddon(ticketId, newQty)\n            self.widgetCalculate(self.selectedPayment)\n                .then(response => response.json())\n                .then(result => {\n                    if (result.error) throw result;\n\n                    self.handleSetDetailPayment(self.selectedPayment, result) \n                    if (parseInt(limitAddOn) == 1 && newQty == 0) {\n                        self.hadleLimitAddOnEnableOthers(ticketId)\n                    }\n                })\n                .catch(error => {\n                    if (widgetTimer != null && widgetTimer > 0){\n                        window.createToast(error.message)\n                        const {reload} = error\n                        if (reload) {\n                            setTimeout(function() {\n                                location.reload();\n                            }, 5000);\n                        }\n                    }\n                })\n                .finally(_ => self.isLoading = false)\n        },\n        handlePickAddon(event) \n        {\n            const ticketId = event.target.getAttribute('id-ticket')\n            const index = event.target.getAttribute('data-index')\n            const select = document.querySelectorAll('button[label=\"default\"]')\n            select.forEach(item => {\n                if (ticketId == item.parentNode.getAttribute('id-ticket'))\n                {\n                    const event = new Event('click', { bubbles: true })\n                    let modal = document.getElementById(`modal-${index}`)\n                    modal.classList.add('hidden')\n                    modal.classList.remove('flex')\n                    item.dispatchEvent(event)\n                    return;\n                }\n            })\n            \n        },\n        onRenderAddon() {\n            const self = this\n            const thumbnail = document.querySelectorAll('.addon-thumbnail')\n            thumbnail.forEach(item => item.addEventListener('click', function (event) {\n                self.handlePreviewAddon(self, event)\n            }))\n            const addon = document.querySelectorAll('[data-modal]');\n            const container = document.getElementById('confirmation');\n            addon.forEach((item) => {\n                item.addEventListener('click', function() {\n                    let index = item.getAttribute('data-index');\n                    let modal = document.getElementById(`modal-${index}`)\n                    modal.classList.add('flex')\n                    modal.classList.remove('hidden')\n                    container.insertAdjacentElement(\"beforeend\", modal)\n                })\n            })\n\n            const close = document.querySelectorAll('[data-modal-close]');\n            \n            for (let i = 0; i < close.length; i++) {\n                close[i].addEventListener('click', function() {\n                const id = Number(this.getAttribute('data-modal-close'));\n                    const isModal = document.getElementById(`modal-${id}`);\n                    isModal.classList.remove('flex');\n                    isModal.classList.add('hidden');\n                });\n            }\n            const select = document.querySelectorAll('button[label=\"default\"]')\n            select.forEach(item => {\n                item.addEventListener('click', function (event) {\n                    self.handleSelectTicketAddon(event, self)\n                })\n            })\n            const add = document.querySelectorAll('button[label=\"add\"]');\n            const sub = document.querySelectorAll('button[label=\"sub\"]');\n            add.forEach(item => {\n                item.addEventListener('click', function (event) {\n                    self.handleAddTicketAddon(event, self)\n                })\n            })\n            sub.forEach(item => {\n                item.addEventListener('click', function (event) {\n                    self.handleSubstractTicketAddon(event, self)\n                })\n            })\n            const addProduct = document.querySelectorAll('.add-product')\n            addProduct.forEach(item => {\n                item.addEventListener('click', self.handlePickAddon)\n            })\n        },\n        handleSubmitInvitationCode(event)\n        {\n            event.preventDefault()\n            let element = event.target\n            if (element.classList.contains('button__text')) element = event.target.parentNode\n            const invitationField = document.getElementById('invitation-code')\n            const groupId = element.getAttribute('id-group')\n            const scheduleId = element.getAttribute('id-schedule')\n            const emptyError = element.getAttribute('empty-error-message')\n            const notification = document.querySelector('.w-notification')\n            const notificationMessage = document.querySelector('.notification-message')\n            const successIcon = document.querySelector('#success-icon')\n            const invitationButton = document.getElementById('invitation-button');\n\n\n            if (invitationField.value == \"\") {\n                if (notification.classList.contains('invitation')) {\n                    successIcon.classList.add('hidden')\n                    notification.classList.remove('hidden')\n                    notificationMessage.classList.add('error-message')\n                    notificationMessage.innerHTML = emptyError\n                }\n                invitationField.classList.add('form-error')\n                return;\n            }\n\n            invitationButton.classList.add('button--loading');\n\n            let formData = new FormData()\n            formData.append('id_group', groupId)\n            formData.append('id_schedule', scheduleId)\n            formData.append('invitation_code', invitationField.value)\n            formData.append('csrf_token', csrfToken)\n            formData.append('widget_code', widgetCode)\n\n            let requestBody = new URLSearchParams(formData)\n            let httpOptions = {\n                method: 'POST',\n                headers: {\n                    'Accept': 'application/json',\n                    'Content-Type': 'application/x-www-form-urlencoded'\n                },\n                body: requestBody\n            }\n                fetch('/ajax_data/check_invitation_code', httpOptions)\n                .then(response => response.json())\n                .then(({error, message, reload}) => {\n                    if (error) {\n                        if (reload) {\n                            setTimeout(function () {\n                                window.location.reload()\n                            }, 900)\n                        }\n                        throw new Error(message)\n                    }\n                    invitationField.classList.remove('form-error')\n                    invitationField.classList.add('form-success')\n                    notification.classList.remove('hidden')\n                    notificationMessage.innerHTML = message\n                    successIcon.classList.remove('hidden')\n                    notificationMessage.classList.remove('error-message')\n                    notificationMessage.classList.add('success-message')\n                    document.querySelectorAll('#buy_ticket').forEach(item => item.removeAttribute('disabled'))\n                    invitationButton.classList.remove('button--loading');\n                })\n                .catch(({message}) => {\n                    invitationField.classList.remove('form-success')\n                    notificationMessage.classList.remove('success-message')\n                    successIcon.classList.add('hidden')\n                    notification.classList.remove('hidden')\n                    invitationField.classList.add('form-error')\n                    notificationMessage.classList.add('error-message')\n                    notificationMessage.innerHTML = message\n                    document.querySelectorAll('#buy_ticket').forEach(item => item.setAttribute('disabled', true))\n                    invitationButton.classList.remove('button--loading');\n                })\n        },  \n        onRenderInvitationCode() {\n            const invitationCode = document.getElementById('invitation-button')\n            if (invitationCode == null || invitationCode == undefined) return\n            invitationCode.addEventListener('click', this.handleSubmitInvitationCode)\n        },\n        onRenderProtection() {\n            const self = this\n            const ticketProtection = document.querySelectorAll('input[name=\"protection\"]')\n            if (ticketProtection.length <= 0) return;\n            ticketProtection.forEach(item => {\n                item.addEventListener('change', function (event) {\n                    const paymentId = self.selectedPayment\n                    self.widgetCalculate(paymentId)\n                        .then(response => response.json())\n                        .then(result => {\n                            if (result.error) throw result;\n                            self.handleSetDetailPayment(paymentId, result)\n                        })\n                        .catch(error => {\n                            if (widgetTimer != null && widgetTimer > 0){\n                                window.createToast(error.message)\n                                const {reload} = error\n                                if (reload) {\n                                    setTimeout(function() {\n                                        location.reload();\n                                    }, 5000);\n                                }\n                            }\n                        })\n                        .finally(e => self.isLoading = false) \n                })\n            })\n        },\n        onInsuranceProductChange() {\n            const self = this\n            const buttons = document.querySelectorAll('.insurance-product-btn')\n            for (let index = 0; index < buttons.length; index++) {\n                const element = buttons[index];\n\n                element.addEventListener('click', function (event) {\n                    const paymentId = self.selectedPayment\n                    self.selectedInsuranceProductGroup = element.getAttribute('data-id')\n                    self.widgetCalculate(paymentId)\n                        .then(response => response.json())\n                        .then(result => {\n                            if (result.error) throw result;\n                            self.handleSetDetailPayment(paymentId, result)\n                        })\n                        .catch(error => {\n                            if (widgetTimer != null && widgetTimer > 0) {\n                                window.createToast(error.message)\n                                const { reload } = error\n                                if (reload) {\n                                    setTimeout(function () {\n                                        location.reload();\n                                    }, 5000);\n                                }\n                            }\n                        })\n                        .finally(e => self.isLoading = false)\n                })\n            }\n        },\n        onBackBrowser(){\n            window.addEventListener('pageshow', function(event) {\n                if (event.persisted) {\n                    window.location.reload();\n                }\n            })\n        },\n        onRenderLoketProtection(){\n            const self = this\n            const protectionTitle = document.querySelectorAll('.protection-title')\n            protectionTitle.forEach(item => {\n                item.addEventListener('click', function () {\n                    self.handleOpenModalTicketProtection(self, this)           \n                })\n            })\n            const closeButtons = document.querySelectorAll('.btn-close-loket-protection')\n            closeButtons.forEach(item => {\n                item.addEventListener('click', function(){\n                    const modalPromo = document.querySelector('#modal-loket-protection');\n                    modalPromo.classList.add('hidden')\n                    modalPromo.classList.remove('flex')\n                })\n            })\n        },\n        handleOpenModalTicketProtection(self, event){\n            const modalPromo = document.querySelector('#modal-loket-protection');\n            modalPromo.classList.remove('hidden')\n            modalPromo.classList.add('flex')\n        },\n        initialize() {\n            this.onSelect()\n            this.onSubmit()\n            this.onPrevious()\n            this.onConfirmPrevious()\n            this.onListPayment()\n            this.onRenderCouponPromo()\n            this.onRenderAddon()\n            this.onRenderInvitationCode()\n            this.onRenderProtection()\n            this.onInsuranceProductChange()\n            this.onBackBrowser()\n            this.onRenderLoketProtection()\n        },\n        onLoadingPage(value) {\n            const loadingCom = document.querySelector('.w-loading');\n\n            if (value) return loadingCom.classList.remove('hidden');\n\n            return loadingCom.classList.add('hidden');\n        }\n    }\n}\n"
          },
