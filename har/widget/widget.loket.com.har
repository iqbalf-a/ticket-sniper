          "content": {
            "size": 12385,
            "mimeType": "application/javascript",
            "text": "window.GTM = function() {\n    return {\n        domain: '',\n        invoice: {},\n        initialize({domain, invoice}) {\n            this.domain = domain\n            this.invoice = invoice \n        },\n        setCookie(cname, cvalue, cdomain, exdays) {\n            let d\t\t\t= new Date();\n            d.setTime(d.getTime() + (exdays*24*60*60*1000));\n\n            let parameter\t= cname + \"=\" + cvalue + \";\";\n            let expires\t\t= \"expires=\" + d.toUTCString() + \";\";\n            let domain\t\t= \"domain=\" + cdomain + \";\";\n            let path\t\t= \"path=/;\";\n            \n            document.cookie\t= parameter + expires + domain + path;\n        },\n        getDigitalMetric() \n        {\n            const utmSource = document.querySelector('input[name=\"utm_source\"]').value\n            const utmMedium = document.querySelector('input[name=\"utm_medium\"]').value\n            const utmCampaign = document.querySelector('input[name=\"utm_campaign\"]').value\n            const utmContent = document.querySelector('input[name=\"utm_content\"]').value\n            const data = {\n                digital_source: utmSource,\n                digital_medium: utmMedium, \n                digital_campaign: utmCampaign, \n                digital_content: utmContent \n            }\n            return data\n        },\n        getCookie(cname)\n        {\n            var name\t\t= cname + \"=\";\n            var ca\t\t\t= document.cookie.split(';');\n            for (var i=0; i<ca.length; i++)\n            {\n                var c\t\t= ca[i];\n                while (c.charAt(0)==' ') c = c.substring(1);\n                if (c.indexOf(name) == 0) return c.substring(name.length,c.length);\n            }\n            \n            return \"\";\n        },\n        deleteCookie(cookie_name,domain) {\n            document.cookie = `${cookie_name}=; domain=${domain}; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;\n        }, \n        exist(cookie) {\n            return ['true', true, 1].includes(cookie)\n        },\n        getParameter(fieldName) {\n            let input = document.querySelector(`input[name=\"gtm_${fieldName}\"]`)\n            if (input == undefined || input == null) throw Error(`Field ${fieldName} not found`)\n            return input.value\n        },\n        pickArrivalDate(selectedDate) {\n            let dataLayerObj = {\n                event: 'generalEvent',\n                event_category: 'Event Order Flow',\n                event_action: 'Select Arrival Date',\n                event_label: this.getParameter('event_label'),\n                arrival_date: selectedDate,\n                user_id: ''\n            }\n            window.dataLayer.push(dataLayerObj)\n        },\n        validateDataLayer() \n        {\n            if (window.dataLayer == undefined) throw new Error('Extension not installed')\n        },\n        selectTicket(totalTicketPrice) {\n            if (totalTicketPrice <= 0) return;\n            this.validateDataLayer()\n            const checkoutDataLayer = {\n                event: 'checkout',\n                event_category: 'Ecommerce',\n                event_action: 'Checkout Step 1',\n                event_label: this.getParameter('event_label'),\n                platform: 'widget',\n                user_id: '',\n                digital_metric: this.getDigitalMetric(),\n                ecommerce: {\n                    checkout: {\n                    actionfield: {\n                        step: 1\n                    },\n                    products: [{\n                                name: this.getParameter('event_name'),\n                                id: parseInt(this.getParameter('id')),\n                                price: totalTicketPrice,\n                                brand: this.getParameter('brand'),\n                                category: this.getParameter('category'),\n                                variant: this.getParameter('variant'),\n                                quantity: 1}]\n                    }\n                }\n            }\n            window.dataLayer.push(checkoutDataLayer);\n        },\n        register()\n        {\n            this.validateDataLayer();\n            const registerDataLayer = {\n                event: 'meta_complete_registration',\n                digital_metric: this.getDigitalMetric()\n            }\n            window.dataLayer.push(registerDataLayer)\n        },\n        confirm() \n        {\n            let confirmDataLayer = {\n                event: \"checkout\",\n                event_category: \"Ecommerce\",\n                event_action: \"Checkout Step 3\",\n                event_label: this.getParameter('event_label'),\n                platform: \"widget\",\n                user_id : '',\n                digital_metric: this.getDigitalMetric(),\n                ecommerce: {\n                    checkout: {\n                        actionField: {step: 3},\n                        products: [{\n                            name: this.getParameter('event_name'),\n                            id: this.getParameter('id'),\n                            price: this.getParameter('invoice_price_total'),\n                            brand:  this.getParameter('brand'),\n                            category: this.getParameter('category'),\n                            variant: this.getParameter('variant'),\n                            quantity: 1\n                        }]\n                    }\n                }\n            };\n            let metaAddPayment = {\n                event: 'meta_add_payment_info',\n                digital_metric: this.getDigitalMetric()\n            }\n            window.dataLayer.push(confirmDataLayer, metaAddPayment)\n        },\n        payComplete()\n        {\n            \n        },\n        completeRegister()\n        {\n            this.validateDataLayer()\n            const invoiceCode = invoice.invoice_code\n            const key  = `dtlyr_stp_2_${invoiceCode}`;\n            if (this.exist(this.getCookie(key))) return false;\n            const confirmDataLayer = {\n                event: \"checkout\",\n                event_category: \"Ecommerce\",\n                event_action: \"Checkout Step 2\",\n                event_label: this.getParameter('event_label'),\n                platform: \"widget\",\n                user_id : '',\n                digital_metric: this.getDigitalMetric(),\n                ecommerce: {\n                    checkout: {\n                        actionField: {step: 2},\n                        products: [{\n                            name: this.getParameter('event_name'),\n                            id: Number(this.getParameter('id')),\n                            price: Number(this.getParameter('invoice_price_total')),\n                            brand: this.getParameter('brand'),\n                            category: this.getParameter('category'),\n                            variant: this.getParameter('variant'),\n                            quantity: 1\n                        }]\n                    }\n                }\n            };\n            window.dataLayer.push(confirmDataLayer)\n            this.setCookie(key, true, this.domain, 1)\n        },\n        applyCoupon()\n        {\n            this.validateDataLayer();\n            const invoiceCode = invoice.invoice_code\n            const key  = `dtlyr_cpn_${invoiceCode}`;\n            if (this.exist(this.getCookie(key))) return false;\n            let applyCouponDataLayer = {\n                event : 'generalEvent',\n                event_category:'Event Order Flow',        \n                event_action:'Apply Promo Code',\n                event_label : this.getParameter('event_label'),\n                user_id : '',\n                digital_metric: this.getDigitalMetric()\n            }\n            window.dataLayer.push(applyCouponDataLayer)\n            this.setCookie(key, true, this.domain, 1)\n        },\n        removeCoupon()\n        {\n            this.validateDataLayer();\n            const invoiceCode = invoice.invoice_code\n            const domain = this.domain\n            const key  = `dtlyr_cpn_${invoiceCode}`;\n            this.deleteCookie(key, domain)\n        },\n        checkout() \n        {\n            this.validateDataLayer()\n            let checkoutDataLayer = {\n                event: \"checkout\",\n                event_category: \"Ecommerce\",\n                event_action: \"Checkout Step 4\",\n                event_label: this.getParameter('event_label'),\n                platform: \"widget\",\n                user_id : '',\n                digital_metric: this.getDigitalMetric(),\n                ecommerce: {\n                    checkout: {\n                        actionField: {step: 4},\n                        products: [{\n                            name: this.getParameter('event_name'),\n                            id: this.getParameter('id'),\n                            price: invoice.invoice_price_total,\n                            brand: this.getParameter('brand'),\n                            category: this.getParameter('category'),\n                            variant: this.getParameter('variant'),\n                            quantity: 1\n                        }]\n                    }\n                }\n            };\n            let metaDataLayer = {\n                event: 'meta_initiate_checkout',\n                digital_metric: this.getDigitalMetric()\n            }\n            window.dataLayer.push(checkoutDataLayer, metaDataLayer)\n        },\n        complete() \n        {\n            const key = `is_pushed_to_datalayer_${this.getParameter('invoice_code')}`\n            let couponCode = `${this.getParameter('coupon_code')}`.toUpperCase()\n            if (couponCode == '') couponCode = 'No Coupon'\n            if (this.exist(this.getCookie(key))) return\n            let confirmDataLayer = {\n                event: \"purchase\",\n                event_category: \"Ecommerce\",\n                event_action: \"Complete Order\",\n                event_label: this.getParameter('event_label'),\n                platform: \"widget\",\n                payment_method:  this.getParameter('payment_method'),\n                coupon_amount: invoice.discount,\n                ticket_category: this.getParameter('ticket_category'),\n                user_id: '',\n                digital_metric: this.getDigitalMetric(),\n                ecommerce: {\n                    currencyCode: 'IDR',\n                    purchase: {\n                        actionField: {\n                            id: invoice.invoice_code,\n                            affiliation: 'widget',\n                            revenue: Number(invoice.invoice_payment_total),\n                            tax: Number(invoice.invoice_add_fee),\n                            shipping: 0,\n                            coupon: coupon_code\n                        },\n                        products: [{\n                            name: this.getParameter('event_name'),\n                            id: Number(this.getParameter('id')),\n                            price: Number(invoice.invoice_price_total),\n                            brand: this.getParameter('brand'),\n                            category: this.getParameter('category'),\n                            variant: this.getParameter('variant'),\n                            quantity: 1\n                        }]\n                    }\n                }\n            };\n            let metaDataLayer = {\n                event: 'meta_purchase',\n                payment_amount: Number(invoice.invoice_payment_total),\n            }\n            let purchaseDataLayer = {\n                event: 'gads_purchase',\n                value: Number(invoice.invoice_payment_total),\n                transaction_id: invoice.invoice_code,\n                digital_metric: this.getDigitalMetric()\n            }\n            window.dataLayer.push(confirmDataLayer, metaDataLayer, purchaseDataLayer)\n            this.setCookie(key, true, domain, 1)\n        },\n        arrivalDate(selectedDate)\n        {\n            this.validateDataLayer()\n            const arrivalDateDataLayer = {\n                event: 'generalEvent',\n                event_category: 'Event Order Flow',\n                event_action: 'Select Arrival Date',\n                event_label: this.getParameter('event_label'),\n                arrival_date: selectedDate,\n                user_id: '',\n                digital_metric: this.getDigitalMetric()\n            }\n            window.dataLayer.push(arrivalDateDataLayer)\n        }\n    }\n}"
          },
