          "content": {
            "size": 105703,
            "mimeType": "application/javascript",
            "text": "(function( $ ) {\n        $.widget(\"loket.loketForm\", {\n            options : {\n                buttons_align : 'center',\n                date_format   : 'mm/dd/yyyy',\n                async         : false,\n                complete_action : null  \n            },\n            $widget_box     : null,\n            $title          : null, \n            $form           : null,\n            $msgbox         : null,\n            _create : function(){\n                this.element.addClass('row');\n                if(this.options.source){\n                    var options = this._get_source();\n                    $.extend(true, this.options, options);  \n                }\n                this._create_box();\n            },\n            \"reload\" : function(){\n                this.element.empty();\n                this._create();\n            },\n            _get_source : function(){\n                var params      = {};\n                var source_url  = this.options.source + '?loketform_action=get_source';\n                if(this.options.session_name){\n                    source_url  = source_url + '&loketform_session_name=' + this.options.session_name;\n                }\n                $.ajax({\n                      url: source_url,\n                      type: \"GET\",\n                      async: false,\n                      success: function(data) {\n                        try{\n                            params = JSON.parse(data);\n                        }catch(e){\n                            console.log(e.message);\n                        }\n                      }\n                });\n                return params;\n            },\n            _is_from_wizard: function() {\n                return this.options.hasOwnProperty('from_wizard')\n            },\n            _create_accordion: function ()\n            { \n                const wrapper = $('<section/>').addClass('accordion')\n                let title = this.options.title\n                if (['', undefined, null].includes(title))\n                {\n                    title = 'Participant'\n                }\n                const header = ` <div class=\"accordion__header is-active\">\n                                    <div class=\"flex\">\n                                        <div class=\"rectangle\"></div>\n                                        <h5 class=\"text-lg font-semibold mr-2\" style=\"color: #152955\"> ${title} </h5>\n                                    </div>\n                                    <span class=\"accordion__toggle\"></span>\n                                </div>`;\n                if (!this._is_from_wizard())\n                    $(header).prependTo(wrapper)\n                const widget_box = $('<div/>').addClass('widget loket_form col-lg-12').appendTo(this.element); \n                const body = $('<div />').addClass('accordion__body is-active')\n                if (this._is_from_wizard())\n                    body.attr('wizard', true)\n                $(widget_box).appendTo(body)\n                this.$wrapper = widget_box\n                $(body).appendTo(wrapper)\n                $(wrapper).appendTo(this.element)\n            },\n            _create_box : function(){\n                this.$widget_box = $('<div/>').addClass('widget loket_form col-lg-12').appendTo(this.element);\n                if(this.options.title){\n                    this._create_title();\n                }\n                if (this._is_new_widget())\n                    this._create_accordion()\n                this._create_form();\n            },\n            _create_title : function(){\n                this.$title = this._get_caption(this.options.title);\n                this.$widget_box.append(this.$title);\n            },\n            _create_form  : function(){\n                if (this.options.no_tag_form !== undefined && this.options.no_tag_form === true) {\n                    $el = $('<div/>')\n                }\n                else {\n                    $el = $('<form/>')\n                }\n                let target_append = this.$widget_box\n                if (this._is_new_widget())\n                    target_append = this.$wrapper\n               this.$form = $el\n                                .append(this._get_msg_box())\n                                .append(this._get_fields())\n                                .appendTo(target_append);\n            },\n            _get_msg_box : function(){\n                this.$msgbox = $('<div/>').addClass('loket_form_message alert').hide();\n                return this.$msgbox;    \n            },\n            _get_fields : function(){\n                var $fieldset   = $('<div/>').addClass('loket_form_inputs');\n                var self        = this;\n                $.each(this.options.fields, function(index, field) {\n                    field.name  = index;\n                    if(!field.value){\n                        field.value = null;\n                    }\n                    $fieldset.append(self._get_field(field));\n                });\n                var $buttons = $('<div/>').addClass('form-group pt-5').append($('<label/>').addClass('form-label mb-2')).append(this._get_buttons());\n                $fieldset.append($buttons);\n                return $fieldset;\n            },\n            _get_field : function(field){\n                var $div        = $('<div/>').addClass('form-group pt-5');\n                var $div_row    = $('<div/>').addClass('row');\n                var $div_label  = $('<div/>');\n                var $label      = this._get_label(field).appendTo($div_label);\n                var $input      = this._get_input(field);\n                if (field.required)\n                    $label.addClass('required');\n                if (field.title !== undefined)\n                    $div_row.append($div_label);\n                if (field.type != 'label') {\n                    $div_row.append($input);\n                    this._set_value_from_param($input, field);\n                }\n                $div = this._set_visibility(field,$div);\n                if(field.type=='hidden'){\n                    $div.hide();\n                }\n                field.element = $div; \n                this._set_label_from_param($label, field);\n                return $div.append($div_row);                       \n            },\n            _get_input : function (field){\n                switch(field.type){\n                    default:\n                        var $div    = $('<span/>').addClass('form-span');\n                        var $input  = this._get_input_type(field);\n                        if(field.before || field.after){\n                            $div.append($input)\n                        }else{\n                            $('<div>').addClass('form-input')\n                                .append($input)\n                                .appendTo($div);\n                        }\n                        return $div;\n                    break;\n                    case \"caption\":\n                        return this._get_caption(field.title);\n                    break;\n                    case \"label\":\n                        return this._get_label(field,false);\n                    break;\n                    case 'hidden':\n                        return this._get_input_hidden(field);\n                    break;\n                    case 'checkbox':\n                        return this._get_input_checkbox(field);\n                    break;\n                    case 'radio':\n                        return this._get_input_radio(field);\n                        break;\n                    case 'image':\n                        if (this._is_new_widget())\n                        {\n                            return this._get_input_image_new(field);\n                        }\n                        return this._get_input_image(field);\n                }\n            },\n            _get_input_type    : function(field){\n                var $input = null;\n                switch(field.type){\n                    default:\n                        $input = this._get_input_text(field);\n                        break;\n                    case 'textarea':\n                        $input = this._get_input_textarea(field);\n                        break;\n                    case 'select':\n                        $input = this._get_input_select(field);\n                        break;\n                    case 'date':\n                        $input = this._get_input_date(field);\n                        break;\n                    case 'time':\n                        $input = this._get_input_time(field);\n                        break;\n                    case 'email':\n                        $input = this._get_input_email(field);\n                        break;\n                    case 'tel':\n                        $input = this._get_input_tel(field);\n                        break;\n                    case 'number':\n                        $input = this._get_input_number(field);\n                        break;\n                    case 'password':\n                        $input = this._get_input_password(field);\n                        break;\n                    case 'radio':\n                        $input = this._get_input_radio(field);\n                        break;\n                    case 'checkbox':\n                        return this._get_input_checkbox(field);\n                        break;\n                }\n                return $input;\n            },\n            _set_visibility    : function(field,$div){\n                if(field.visible!==undefined){\n                    if(!field.visible){\n                        $div.hide();\n                    }\n                }\n                this._set_graded_auto_visibility.apply(this, [field, $div]);\n                return $div;\n            },\n            _get_label        : function(field, input_label){\n                input_label = input_label!==undefined?input_label:true;\n                var $label      = $('<label/>').attr('for',field.name).html(field.title);\n                if(input_label)\n                    $label.addClass('form-label mb-2');\n                if(field.subtitle)\n                    $label.append('<mark><br><i>' + field.subtitle + '</i></mark>');\n                return $label;\n            },\n            _get_caption      : function(title){\n                var $div = $('<div/>').addClass('widget-title').append(\n                                    $('<div/>').addClass('meta').append(\n                                        $('<div/>').addClass('name').html(title)\n                                    )\n                                );\n                return $div\n\n            },\n            _get_input_base   : function(field,$input){\n                var self = this;\n                $input.prop('name','loket_form_' + field.name)\n                      //.prop('id','loket_form_' + field.name)\n                      .data('field',field)\n                      .addClass('form-control loket_control');\n                if(field.required){\n                    $input.prop('required',field.required);\n                }\n                if(field.attr){\n                    $.each(field.attr, function(key,value) {\n                        if (key.indexOf('data-') != -1) {\n                            $input.attr(key, value);\n                        }\n                        else {\n                            $input.prop(key,value);\n                        }\n                    });\n                }\n                if(field.placeholder){\n                    $input.prop('placeholder',field.placeholder);\n                }\n                $input.change(function(e){\n                    var el  = $(this);\n                    var val = self._get_input_change(el);\n                    if(field.change!==undefined){\n                        if(typeof field.change==='string'){\n                            var func = field.change.replace(\"function\",\"function change\");\n                            eval(func);\n                            change.apply(this,[self,val]);\n                        }else{\n                            field.change.apply(this,[self,val]);\n                        }\n                    }\n                });\n                $input.click(function(e){\n                    var el  = $(this);\n                    var val = self._get_input_change(el);\n                    if(field.click!==undefined){\n                        if(typeof field.click==='string'){\n                            var func = field.click.replace(\"function\",\"function click\");\n                            eval(func);\n                            click.apply(this,[self,val]);\n                        }\n                    }\n                });\n                return $input;\n            },\n            _get_input_change : function(element){\n                var field   = element.data('field');\n                field.value = this._get_input_value(element,field);\n                element.data('field',field);\n                return field.value;\n            },\n            _get_input_text_group : function(field){\n                var $input          = $('<input/>').prop('type','text');\n                $input              = this._get_input_base(field,$input);\n                var $span           = $('<span/>').addClass('input-group').append($input);\n                if(field.before)\n                    var $div_before = $('<div/>').addClass('input-group-addon custom-div').html(field.before).prependTo($span);\n                if(field.after)\n                    var $div_after  = $('<div/>').addClass('input-group-addon custom-div').html(field.after).appendTo($span);\n                if(!field.size)\n                    return $span;\n                var $div_col        = $('<div/>').addClass('col-sm-' + field.size).append($span);\n                return $div_col;\n            },\n            _get_input_text : function(field){\n                if(field.before || field.after)\n                    return this._get_input_text_group(field);\n                var $input  =  $('<input/>').prop('type','text');\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_textarea : function(field){\n                var $input  =  $('<textarea/>');\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_select : function(field){\n                var self = this;\n                var $input  = $('<select/>');\n                if(field.options!==undefined){\n                    $input.append($('<option/>').val('').html('-'));\n                    var option_value = field.option_value!==undefined ? field.option_value : 'value';\n                    var option_text  = field.option_text!==undefined ? field.option_text  :'text';\n                    if(typeof field.options=='string'){\n                        $.ajax({\n                            type: 'GET',\n                            url: field.options,\n                            success: function(data){\n                                field.options  = $.parseJSON(data);\n                            },\n                            error : function(){\n                                field.options  = [];\n                            },\n                            async:false\n                        });\n                    }\n                    $.each(field.options, function(index,option) {\n                        $input.append($('<option/>').val(option[option_value]).html(option[option_text]));\n                    });\n                }\n                $input      =  this._get_input_base(field,$input);\n                \n                if (field.default!==undefined && field.default!='') {\n                    setTimeout(function(){\n                        $input.find('option:contains(\"'+field.default.trim()+'\")').prop('selected', true).change();\n                    }, 250)\n                }\n                return $input;\n            },\n            _get_input_date   : function(field){\n                var dateFormat  = field.format ? field.format : this.options.date_format;\n                var $input      =  $('<input/>').prop('type','text').attr('data-toggle','datepicker');\n                if (this._is_new_widget())\n                    $input      =  $('<input/>').prop('type','date')\n                $input          =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_time   : function(field){\n                var dateFormat  = field.format ? field.format : this.options.date_format;\n                var $input      =  $('<input/>').prop('type','text').attr('data-toggle','timepicker');\n                $input          =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_email  : function(field){\n                var $input  =  $('<input/>').prop('type','email');\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_tel  : function(field){\n                var $input  =  $('<input/>').prop('type','tel');\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_number  : function(field){\n                var $input  =  $('<input/>').prop('type','number');\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_password : function(field){\n                var $input  =  $('<input/>').prop('type','password');\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_radio    : function(field){\n                var self = this;\n                var $div = $('<div/>');\n                if(field.options!=undefined){\n                    $.each(field.options, function(index,option){\n                        var $input  =  $('<input/>').prop('type','radio').prop('value',option.value).css('display','inline-block');\n                        if(field.default!==undefined && field.default==option.value){\n                            $input.prop('checked',true);\n                        }\n                        $input      =  self._get_input_base(field,$input);\n                        $input.prop('id',$input.prop('id') + '_' + option.value);\n                        $input.removeClass('form-control');\n                        $div.append($input);\n                        var separator = '<br/>';\n                        if(field.inline){\n                            separator = '<span style=\"margin-left: 20px;\"/>';\n                        }\n                        $div.children().last().after(' ' + option.text + separator);\n                    });\n                }\n                return $div;\n            },\n            _get_input_hidden : function(field){\n                var $input  =  $('<input/>').prop('type','hidden');\n                if(field.value){\n                    $input.val(field.value);\n                }\n                $input      =  this._get_input_base(field,$input);\n                return $input;\n            },\n            _get_input_checkbox : function(field){\n                var $input_div      = $('<div/>').addClass('checkbox');\n                var $input          = $('<input/>').prop('type','checkbox');\n                $input              = this._get_input_base(field,$input);\n                var $input_label    = $('<label/>').append($input).append('<span>' + field.title + '</span>');\n                return $input_div.append($input_label);\n            },\n            _get_input_value    : function($input,field){\n                if($input===false){\n                    $input = this.$form.find('input[name=\"loket_form_' + field.name + '\"]:checked');\n                    if($input.length<1)\n                        return null;\n                }\n                switch(field.type){\n                    default:\n                        return $input.val();\n                    break;\n                    case 'checkbox':\n                        return $input.prop('checked');\n                    break;\n                }\n                return $input.val();\n            },\n            _get_buttons : function(){\n                var $div = $('<div/>').addClass('action text-' + this.options.buttons_align);\n                var self = this;\n                if(this.options.buttons){\n                    $.each(this.options.buttons, function(index, button) {\n                        $div.append(self._get_button(button));\n                    });\n                }\n                return $div;\n            },\n            _get_button : function(button){\n                var $a      = $('<a/>').addClass('btn').html(button.title);\n                var self    = this;\n                if(button.class!==undefined)\n                    $a.addClass(button.class);\n                if(button.href!==undefined)\n                    $a.prop('href',button.href);\n                if(button.click!==undefined){\n                    if(typeof button.click==='string'){\n                        var func = 'button.click = ' + button.click;\n                        eval(func);\n                        $a.click(function(){\n                            button.click.apply(this,[self]);\n                        });\n                    }else{\n                        $a.click(function(){\n                            button.click.apply(this,[self]);\n                        });\n                    }\n                }\n                return $a;\n            },\n            _get_image_loading: function(){\n                return $('<img/>').attr('src','/themes_1.0/img/loading.gif').addClass('loading');\n            },\n            get_fields   : function(){\n                var $controls = this.$widget_box.find('.loket_control');\n                var fields    = [];\n                $controls.each(function(index){\n                    var field = $(this).data('field');\n                    fields.push(field);\n                });\n                return fields;\n            },\n            get_data    : function(){\n                var self    = this;\n                var fields  = this.get_fields();\n                var data    = {};\n                $.each(fields, function(index, field) {\n                    if(field.type=='date')\n                    {\n                        // date to strtotime\n                        if(isNaN(field.value)){\n                            if(field.value.length==10){\n                                field.value = Date.parse(field.value+\" GMT\") / 1000;\n                            }\n                        }\n                    }\n                    if(field.type=='radio'){\n                        field.value =self._get_input_value(false,field);\n                    }\n                    data[field.name] = field.value;\n                });\n                return data;\n            },\n            _get_data_value:function(fieldname,field){\n                if(field.type=='date')\n                {\n                    // date to strtotime\n                    if(isNaN(field.value)){\n                        if(field.value.length==10){\n                            field.value = Date.parse(field.value+\" GMT\") / 1000;\n                        }\n                    }\n                }\n                return field.value;\n            },\n            validate_email : function(email){\n                var pattern = /^([a-z\\d!#$%&'*+\\-\\/=?^_`{|}~\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]+(\\.[a-z\\d!#$%&'*+\\-\\/=?^_`{|}~\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]+)*|\"((([ \\t]*\\r\\n)?[ \\t]+)?([\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\x21\\x23-\\x5b\\x5d-\\x7e\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0d-\\x7f\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]))*(([ \\t]*\\r\\n)?[ \\t]+)?\")@(([a-z\\d\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]|[a-z\\d\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF][a-z\\d\\-._~\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]*[a-z\\d\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])\\.)+([a-z\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]|[a-z\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF][a-z\\d\\-._~\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]*[a-z\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])\\.?$/i;\n                return pattern.test(email);\n            },\n            validate    : function(){\n                var self    = this;\n                var valid   = true;\n                var fields  = this.options.fields;\n                this.$msgbox.empty().hide();\n                this._remove_alert_error();\n                var data    = this.get_data();\n                // if rows\n                $.each(this.options.fields, function(index, field) {\n                    if(field.rows){\n                        for(var i=0;i<field.rows.length;i++){\n                            var row = field.rows[i];\n                            $.each(row,function(index,col){\n                                if ((col.title === undefined || col.title == '') && field.title !== undefined) {\n                                    col.title = field.title\n                                }\n                                fields[index] = col;\n                            });\n                        }\n                    }\n                });\n                $.each(fields, function(index, field) {\n                    if(field.required && !field.rows){\n                        if(!field.value){\n                            self.alert_error(field,field.title + ' is required and cannot be empty.');\n                            valid = false;\n                        }else{\n                            switch(field.type){\n                                case 'checkbox':\n                                    if(typeof  field.value=='object'){\n                                        if(field.value.length<1){\n                                            self.alert_error(field,field.title + ' is required and cannot be empty.<br/>');\n                                            valid = false;\n                                        }\n                                    }else{\n                                        if(field.value.trim().length<1){\n                                            self.alert_error(field,field.title + ' is required and cannot be empty.<br/>');\n                                            valid = false;\n                                        }\n                                    }\n                                    break;\n                                case 'email':\n                                    if(!self.validate_email(field.value)){\n                                        self.alert_error(field,'Please fill <strong>'+ field.title + '</strong> with valid email address<br/>');\n                                        valid = false;\n                                    }\n                                    break;\n                                case 'number':\n                                    if(!$.isNumeric(field.value)){\n                                        self.alert_error(field,'Please fill <strong>'+ field.title + '</strong> with valid number<br/>');\n                                        valid = false;\n                                    }\n                                    break;\n                            }\n                        }\n                    }\n                    // final validate\n                    switch(field.type){\n                        case 'checkbox':\n                            if(field.options){\n                                if(field.other){\n                                    var other_checked   = field.element.find(\".checkbox-other\").prop('checked');\n                                    var other_input     = field.element.find(\".textbox_other\").val();\n                                    if(other_checked && other_input==''){\n                                        self.alert_error(field,'You checked other ' + field.name + ' but didn\\'t specify another ' + field.name + ' in text input<br/>');\n                                        valid = false;\n                                    }\n                                }\n                            }\n                            if(field.textbox){\n                                var checked = field.element.find('input[type=\"checkbox\"]').prop('checked');\n                                if(field.value.length<1 && checked){\n                                    self.alert_error(field,field.title + ' cannot be empty<br/>');\n                                    valid = false;\n                                }\n                            }\n                            break;\n\n                        case 'radio':\n                            if(field.options){\n                                if(field.other){\n                                    var other_checked   = field.element.find(\".checkbox-other\").prop('checked');\n                                    var other_input     = field.element.find(\".textbox_other\").val();\n                                    if(other_checked && other_input==''){\n                                        self.alert_error(field,'You checked other ' + field.name + ' but didn\\'t specify another ' + field.name + ' in text input<br/>');\n                                        valid = false;\n                                    }\n                                }\n                            }\n                            break;\n                    }\n                });\n                if(!valid){\n                    self.$msgbox.addClass('alert-danger').html('Please fill in the blank with accurate data!');\n                    self.$msgbox.show();\n                    window.scrollTo(0, 0);\n                }\n                return valid;\n            },\n            alert_clear : function(field){\n                field.element.find('.alert').remove();\n            },\n            alert_error : function(field,message){\n                var $alert  = $('<div/>').addClass('col-sm-12 alert alert-danger').html(message);\n                if(!field.element) return;\n                field.element.find('.alert').remove();\n                field.element.children().last().append($alert);\n            },\n            alert_success : function(field,message){\n                var $alert  = $('<div/>').addClass('col-sm-12 alert alert-success').html(message);\n                field.element.find('.alert').remove();\n                field.element.children().last().append($alert);\n            },\n            _remove_alert_error: function(){\n                var rows = this.element.find('.form-group pt-5');\n                $.each(rows, function(index, row){\n                    $(row).find('.alert-danger').remove();\n                });\n            },\n            submit     : function(callback){\n                var self        = this;\n                var data        = this.get_data();\n                var response    = '';\n                var action_save = this.options.action_save!==undefined?this.options.action_save:this.options.source + '?loketform_action=save_data';\n                data            = JSON.stringify(data);\n                if(this.options.encode){\n                    data = this._encode(data);\n                }\n                $.ajax({\n                      url: action_save,\n                      data: data,\n                      type: \"POST\",\n                      async: this.options.async,\n                      success: function(data) {\n                        if(self.options.async){\n                            callback(data);\n                        }else{\n                            response = data;\n                        }\n                      }\n                });\n                return response;\n            },\n            show_error : function(field,message){\n                var $div = $('<div/>').addClass('error').html(message);\n                field.element.after($div);\n            },\n            \"serialize\" : function(){\n                  var self          = this;\n                  var placeholder   = '____PLACEHOLDER____';\n                  var fns           = [];\n                  var json          = JSON.stringify(this.options, function(key, value) {\n                    if (typeof value === 'function') {\n                      value = self._clear_string(value.toString());\n                      fns.push('\"' + value.toString() + '\"');\n                      return placeholder;\n                    }\n                    return value;\n                  }, 2);\n                  json = json.replace(new RegExp('\"' + placeholder + '\"', 'g'), function(_) {\n                    return fns.shift();\n                  });\n                  return json;\n            },\n            \"load\" : function(is_new){\n                var self = this;\n                $.each(this.options.fields, function(index, field) {\n                    if (is_new === true)\n                        field.value = ''\n                    if (field.rows){\n                        for(var i=0;i<field.rows.length;i++){\n                            $.each(field.rows[i],function(index,col){\n                                if (!col.value)\n                                    col.value = '';\n                                col.name    = index;\n                                col.element = field.element;\n                                if (self._is_new_widget())\n                                    col.parent_value = field.value\n                                self._set_value(col);\n                            });\n                        }\n                    }else{\n                        self._set_value(field);\n                    }\n                });\n            },\n            _set_value    : function(field){\n                switch(field.type){\n                    default:\n                        this._set_value_text(field);\n                    break;\n                    case 'radio':\n                        this._set_value_radio(field);\n                    break;\n                    case 'checkbox':\n                        this._set_value_checkbox(field);\n                    break;\n                    case 'date':\n                        this._set_value_date(field);\n                        break;\n                }\n            },\n            \"bind\" : function(record){\n                var self = this;\n                $.each(record,function(key,value){\n                    if(self.options.fields[key]){\n                        self.options.fields[key].value = value;\n                    }\n                });\n            },\n            \"set_options\" : function(options){\n                this.options = options;\n                this.element.empty();\n                this._create();\n            },\n            _set_value_text : function(field){\n                var $element = field.element.find(\"[name=loket_form_\" + field.name + \"]\");\n                $element.val(field.value).change();\n            },\n            _set_value_select: function(field) {\n                if (field.value != \"\" && field.value.length > 0 && field.value) {\n                    var $element = field.element.find(\"[name=loket_form_\" + field.name + \"]\");\n                    $element.append(\"<option value='\" +field.value+ \"'>\"+field.value+\"</option>\");\n                }\n            },\n            _set_value_radio : function(field){\n                var $element = field.element.find(\"[name='loket_form_\" + field.name + \"'][value='\" + field.value + \"']\");\n                if(field.value!=null && field.value.length>0 && field.value=='other' && field.other){\n                    $element = field.element.find(\"[name='loket_form_\" + field.name + \"'][value='other']\");\n                    $element.val(field.value);\n\n                    if (field.value_other != undefined && field.value_other != null)\n                        field.element.find(\"[name='loket_form_\" + field.name + \"_other']\").val(field.value_other).show();\n                }\n                $element.prop(\"checked\",true).change();\n            },\n            _set_value_checkbox : function(field){\n                var $element = field.element.find(\"[name=loket_form_\" + field.name + \"]\");\n                $element.prop(\"checked\",field.value).change();\n            },\n            _is_new_widget() {\n                return this.options.hasOwnProperty('new_widget') &&  this.options.new_widget\n            },\n            _set_value_date : function(field){\n                var $element = field.element.find(\"[name=loket_form_\" + field.name + \"]\");\n                if (this._is_new_widget())\n                    field.value = field.parent_value\n                if(field.value!==undefined && field.value!='' && !isNaN(field.value) && field.value != null){\n                    field.value = field.value === null||field.value < 0?'631126800':field.value;\n                    if (this._is_new_widget())\n                    {\n                        $element.val(this._format_date