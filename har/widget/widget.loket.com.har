            "text": "window.addEventListener('DOMContentLoaded', () => {\n\n    const dropdowns = document.querySelectorAll('.telephone-wrapper');\n\n    if (!dropdowns.length) return;\n\n    dropdowns.forEach(dropdown => {\n        const idx = dropdown.getAttribute('idx')\n        const fieldName = dropdown.getAttribute('field')\n\n        // ====== DOM ELEMENTS (scoped per dropdown) ===========\n        const toggleBtn      = dropdown.querySelector('.country-code');\n        const listWrapper    = dropdown.querySelector('.country-list');\n        const searchInput    = dropdown.querySelector('.country-search');\n        const countryItems   = dropdown.querySelectorAll('.country-item');\n        const noResultEl     = dropdown.querySelector('.no-result');\n        let inputValue     = dropdown.querySelector(`input[name=\"${fieldName}_code\"]`)\n        if (dropdown.hasAttribute('idx')) {\n            inputValue = dropdown.querySelector(`input[name=\"${fieldName}_code[${idx}]\"]`)\n        }\n\n        // ====== FUNCTIONS ===================================\n\n        const toggleDropdown = () => {\n            toggleBtn.classList.toggle('active');\n            listWrapper.classList.toggle('hidden');\n        };\n\n        const updateSelectedCountry = (item) => {\n            const phoneCode = item.dataset.phone;\n            const flag      = item.dataset.flag;\n\n            toggleBtn.querySelector('span').innerHTML = `${flag} +${phoneCode}`;\n            if (inputValue) {\n                inputValue.value = phoneCode\n            }\n            toggleDropdown();\n        };\n\n        const filterCountries = (value) => {\n            const q = value.toLowerCase();\n            let found = false;\n\n            countryItems.forEach(item => {\n                const name  = item.dataset.country.toLowerCase();\n                const phone = item.dataset.phone.toLowerCase();\n\n                const match = name.includes(q) || phone.includes(q);\n                item.style.display = match ? 'block' : 'none';\n                if (match) found = true;\n            });\n\n            noResultEl.style.display = found ? 'none' : 'block';\n        };\n\n\n        // ====== EVENT LISTENERS ==============================\n\n        toggleBtn.addEventListener('click', e => {\n            e.preventDefault();\n            toggleDropdown();\n        });\n\n        if (searchInput) {\n            searchInput.addEventListener('input', e => {\n                filterCountries(e.target.value);\n            });\n        }\n\n        countryItems.forEach(item => {\n            item.addEventListener('click', e => {\n                e.preventDefault();\n                updateSelectedCountry(item);\n            });\n        });\n    });\n\n    const inputTelephons = document.querySelectorAll('input[type=\"tel\"]');\n    inputTelephons.forEach(item => {\n        item.addEventListener('keydown', e => {\n            if ((e.key === \"0\" && item.value.length === 0) || e.key === \"+\" || e.key === \"-\") {\n                e.preventDefault();\n            }\n        });\n\n        const sanitizeInput = () => {\n            item.value = item.value.replace(/^(\\+|0)+/, '');\n            item.value = item.value.replace(/-/g, '');\n        };\n\n        item.addEventListener('input', sanitizeInput);\n        item.addEventListener('paste', () => {\n            setTimeout(sanitizeInput, 0);\n        });\n    });\n\n});\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 0,
          "_transferSize": 0,
