            "mimeType": "application/javascript",
            "text": "function vwar() {\n\tconst ONE_SECOND = 1000; // in ms\n\tlet HEARBEAT_INVERVAL = ONE_SECOND * 60; // one minute\n\treturn {\n\t\ttypeEqual: function(data, type) {\n\t\t\treturn typeof data === type;\n\t\t},\n\t\tstart: function({\n\t\t\tpath,\n\t\t\thost,\n\t\t\tinterval,\n\t\t\tonSuccess,\n\t\t\tonError\n\t\t}) {\n\t\t\tlet self = this;\n\t\t\tif (self.typeEqual(path, 'undefined') || self.typeEqual(host, 'undefined')) {\n\t\t\t\tconsole.error('Param host and path are required');\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (path == \"\" || host == \"\") {\n\t\t\t\tconsole.error('Param host and path cannot be empty');\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tif (!(self.typeEqual(onSuccess, 'function') && self.typeEqual(onError, 'function'))) {\n\t\t\t\tconsole.error('Please define success and error callback');\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tsetInterval(function() {\n\t\t\t\tconst requestBody = {\n\t\t\t\t\thost,\n\t\t\t\t\tpath\n\t\t\t\t}\n\t\t\t\tconst httpOptions = {\n\t\t\t\t\tmethod: 'POST',\n\t\t\t\t\theaders: {\n\t\t\t\t\t\t'Content-Type': 'application/json',\n\t\t\t\t\t\t'Accept': 'application/json',\n\t\t\t\t\t},\n\t\t\t\t\tbody: JSON.stringify(requestBody)\n\t\t\t\t}\n\t\t\t\tfetch('/token/refresh', httpOptions)\n                    .then(response => {\n                        let {status} = response\n                        if (status != 200)\n                        {\n                            onError(response)\n                            return;\n                        } \n                        onSuccess(response.json());\n                    })\n                    .catch(err => onError(err))\n\t\t\t}, this.typeEqual(interval, 'undefined') ? HEARBEAT_INVERVAL : interval)\n\t\t}\n\t}\n}\n"
          },
