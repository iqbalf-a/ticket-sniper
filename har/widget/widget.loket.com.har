...')\n                .css({\n                    'margin-left':'10px',\n                    'padding':'2px',\n                    'display':'inline',\n                })\n                .addClass('textbox_other')\n                .click(function(e){\n                    e.stopPropagation();\n                })\n                .on('input',function(){\n                    var $div = $(this).closest('div');\n                    $div.find('input:checkbox').val($(this).val()).change();\n                })\n                .hide().appendTo($label);\n            $label.unbind('click');\n            $label.click(function(){\n                var cb          = $(this).find('input:checkbox')[0];\n                if($(cb).is(\":checked\")){\n                    $(cb).prop('checked',true).change();\n                    $(this).find('.textbox_other').show();\n                }else{\n                    $(cb).prop('checked',false).change();\n                    $(this).find('.textbox_other').hide();\n                }\n            });\n            if(field.inline){\n                $label.css('display','inline-block');\n            }\n            return $label;\n        },\n\n        _get_input_radio    : function(field){\n            if(!field.options.rows)\n                return base._get_input_radio.apply(this,arguments);\n            return this._get_input_radio_rows.apply(this,arguments);\n        },\n\n        _get_input_radio_rows : function(field){\n            var self            = this;\n            var $div            = $('<span/>').addClass('form-span');\n            var $label          = this._get_label(field);\n            var col_size        = Object.keys(field.options.rows).length;\n            var col_size        = field.options.size || Math.floor(12/col_size);\n            $.each(field.options.rows,function(index, option) {\n                    if(!option.size)\n                        option.size     = col_size;\n                    var $col_div        = $('<div/>').addClass('radio col-sm-' + option.size).appendTo($div);\n                    var $div_radio      = self._get_input_radio_multiple_option_row(field,option);\n                    $col_div.append($div_radio);\n            });\n\n            if(field.other){\n                var $other_div      = $('<div/>').addClass('radio col-sm-12').appendTo($div);\n                $other_div.append(this._get_input_radio_multiple_row_other(field));\n            }\n\n            return $div;\n        },\n        \n        _get_input_radio_multiple_option_row : function (field,option) {\n            var self            = this;\n            var $label          = $('<label/>');\n            var $input          = $('<input/>').prop('type','radio').prop('value',option.value).appendTo($label);\n            if(field.default!==undefined && field.default==option.value){\n                $input.prop('checked',true);\n            }\n            $input      =  self._get_input_base(field,$input);\n            $input.click(function(e){\n                e.stopPropagation();\n                self._do_graded_form.apply(self, [field, option]);\n            });\n            $input.prop('id',$input.prop('id') + '_' + option.value);\n            $input.removeClass('form-control')\n                .addClass('checkbox-multiple')\n                .css({\n                    \"cursor\":\"pointer\",\n                });\n\n            $span               = $('<span/>').html(option.text).appendTo($label);\n            return $label;\n        },\n\n        _get_input_radio_multiple_row_other : function(field) {\n            var self    = this;\n            var $label  = this._get_input_radio_multiple_option_row(field,{value:'other',text:field.other_text || 'Other'});\n            var $cb     = $label.find('input').addClass('checkbox-other').unbind('click');\n            $cb.click(function(e){\n                e.stopPropagation();\n                var div = $(this).closest('div');\n                if($(