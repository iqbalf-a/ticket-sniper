s;\n            base._create_form.apply(this,arguments);\n\n            setTimeout(function(){\n                self._trigger_date_picker.apply(self,arguments);\n                self._trigger_time_picker.apply(self,arguments);\n                self._trigger_show_hide_password.apply(self,arguments);\n                self._submit_on_enter();\n            }, 300)\n        },\n\n        _trigger_date_picker: function() {\n            var self = this\n            if ($.fn.datepicker) {\n                if (self._is_new_widget())\n                {\n                    return;\n                }\n                $('[data-toggle=datepicker]').datepicker({\n                    format: base.date_format\n                })\n                .on('changeDate', function(ev){\n                    self._set_input_change($(this));\n                });\n            }\n            else {\n                console.log('CustomForm: extension datepicker not active')\n            }\n        },\n\n        _trigger_time_picker: function() {\n            var self = this\n            if ($.fn.timepicker) {\n                $('[data-toggle=timepicker]').timepicker({\n                    showInputs: false,\n                    disableFocus: true,\n                    showMeridian: false\n\n                });\n            }\n            else {\n                console.log('CustomForm: extension timepicker not active')\n            }\n        },\n\n        _trigger_show_hide_password: function() {\n            var self = this\n            if ($.fn.hideShowPassword) {\n                $('input[type=password]').hidePassword(true, {\n                    toggle: {verticalAlign: 'top'},\n                    wrapper: {enforceWidth: false}\n                });\n            }\n            else {\n                console.log('CustomForm: extension hideShowPassword not active')\n            }\n        },\n\n        _submit_on_enter: function() {\n            var self = this;\n            $('input[type=text]').keypress(function (e) {\n                if (e.which == 13) {\n                    $(this).change();\n                    if (self.validate()) {\n                        self.submit_data(function(data){\n                            eval(self.options.complete_action)\n                        })\n                    }\n                    return false; \n                }\n            });\n        },\n\n        _set_input_change: function (element) {\n            var field   = element.data('field');\n            field.value = element.val();\n            element.data('field',field);\n        }\n\n    });\n}(jQuery));"
