            "text": "$(function(){\n\t$('#cancel-subdomain').click(function(){\n\t\tlocation.href='/setting/subdomain';\n\t});\n\t$('#cancel-account').click(function(){\n\t\tlocation.href='/setting/account';\n\t});\n\t$('#cancel-scope').click(function(){\n\t\tlocation.href='/setting/scope';\n\t});\n\t$('#cancel-menu').click(function(){\n\t\tlocation.href='/setting/menu';\n\t});\n\t$('#back-to-first-step').click(function(){\n\t\tlocation.href='/admin/event/first_step/' + $(this).data('id-event');\n\t});\n\t$('#back-to-second-step').click(function(){\n\t\tlocation.href='/admin/event/second_step/' + $(this).data('id-event');\n\t});\n\t$('#event-last-step').click(function(){\n\t\tlocation.href='/admin/event/last_step/' + $(this).data('id-event');\n\t});\n\t$('#finish-modify-location, #finish-modify-schedule').click(function(){\n\t\tlocation.href='/event/overview';\n\t});\n\t$('#cancel-modify-event').click(function(){\n\t\tlocation.href='/event/overview';\n\t});\n\t$('.menu-privilege').click(function(){\n\t\t$(':checkbox.privilege-' + $(this).data('privilege')).prop('checked', this.checked);\n\t});\n\t$('#cancel-dashboard-menu').click(function(){\n\t\tlocation.href='/menu/list';\n\t});\n\t$('#cancel-dashboard-scope').click(function(){\n\t\tlocation.href='/scope/list';\n\t});\n\t$('#cancel-dashboard-user').click(function(){\n\t\tlocation.href='/user/list';\n\t});\n\t$('#cancel-dashboard-privilege').click(function(){\n\t\tlocation.href='/privilege/assign/' + $(this).data('privilege');\n\t});\n\t$('#cancel-modify-ticket').click(function(){\n\t\tlocation.href='/ticket/manage';\n\t});\n\t$('#cancel-setting-profile').click(function(){\n\t\tlocation.href='/admin/event';\n\t});\n\t$('#cancel-setting-organization').click(function(){\n\t\tlocation.href='/admin/event';\n\t});\n\n\t$('input[name=\"payment_type\"]').change(function(){\n\t\tif($(this).attr('id') == \"payment_type-info\"){\n\t\t\t$('#payment-default-value').show();\n\t\t}else\n\t\t{\n\t\t\t$('#payment-default-value').hide();\n\t\t}\n\t});\n\n\t$('#id-country').change(function(){\n\t\tif ($(this).val().length)\n\t\t{\n\t\t\t$.post('/ajax_data/get_province',{'id_country':$(this).val()},function(data){\n\t\t\t\t$('#id-province').html('');\n\t\t\t\t$('#id-province').append('<option value=\"\">&hellip;</option>');\n\t\t\t\t$.each(data.dropdown_province, function(k,v){\n\t\t\t\t\t$('#id-province').append('<option value=\"' + k + '\">'+ v +'</option>');\n\t\t\t\t});\n\t\t\t\t$('#id-province').trigger(\"chosen:updated\");\n\t\t\t},'json');\n\n\t\t\tif ($(this).val() == 1) // indo only\n\t\t\t{\n\t\t\t\t$(\".indo_only\").show();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$(\".indo_only\").hide();\n\t\t\t}\n\t\t}\n\t});\n\n\t$('#id-province').change(function(){\n\t\tif ($(this).val().length)\n\t\t{\n\t\t\t$.post('/ajax_data/get_district',{'id_province':$(this).val()},function(data){\n\t\t\t\t$('#id-district').html('');\n\t\t\t\t$('#id-district').append('<option value=\"\">&hellip;</option>');\n\t\t\t\t$.each(data.dropdown_district, function(k,v){\n\t\t\t\t\t$('#id-district').append('<option value=\"' + k + '\">'+ v +'</option>');\n\t\t\t\t});\n\t\t\t\t$('#id-district').trigger(\"chosen:updated\");\n\t\t\t},'json');\n\t\t}\n\t});\n\n\t$('#id-district').change(function(){\n\t\tif ($(this).val().length)\n\t\t{\n\t\t\t$.post('/ajax_data/get_region',{'id_district':$(this).val()},function(data){\n\t\t\t\t$('#id-region').html('');\n\t\t\t\t$('#id-region').append('<option value=\"\">&hellip;</option>');\n\t\t\t\t$.each(data.dropdown_region, function(k,v){\n\t\t\t\t\t$('#id-region').append('<option value=\"' + k + '\">'+ v +'</option>');\n\t\t\t\t});\n\t\t\t\t$('#id-region').trigger(\"chosen:updated\");\n\t\t\t},'json');\n\t\t}\n\t});\n\n\t$(\"#checkall\").on('click',function()\n\t{\n\t\tvar checked_status = this.checked;\n\t\t$(\".actionchk\").each(function()\n\t\t{\n\t\t\tthis.checked = checked_status;\n\t\t});\n\t});\n\n\n\t$('#id-currency').on('change',function(){\n\t\tvar val \t\t\t\t\t\t= $('#id-currency').val();\n\t\tvar existing_payment_value\t\t= $('#payment-option').find('input[name=existing_payment_value]').val();\n\t\tvar existing_payment_currency\t= $('#payment-option').find('input[name=existing_payment_currency]').val();\n\t\tvar is_vaccine_event \t\t\t= $(\"#is_vaccine_event\").val();\n\t\tvar flag_action                 = $(\"#flag_action\").val();\n        var GROUP_ADD                   = 'group_add';\n\n\t\t$('#payment-option').find('input').attr('disabled', false);\n\n\t\tif(val > 0)\n\t\t{\n\t\t\t$('#payment-option').find('input').attr('disabled', 'disabled').prop('checked', false);\t\n\t\t}\n\t\tvar el\t\t\t\t\t\t\t= $('#payment-option').find('input');\n\t\texisting_payment_value\t\t\t= typeof existing_payment_value != 'undefined' ? existing_payment_value.split(',') : [];\n\t\tconst CURRENCY_IDR = 1;\n\t\t$.each(el, function(index, item){\n\t\t\tvar id_currency = $(item).attr('id-currency');\n\t\t\tvar is_vaccine_event_payment_method = $(item).attr('is-vaccine-event-payment-method');\n\t\t\tvar is_active_payment_idr = $(item).attr('is-active-payment-idr');\n\t\t\tif (is_vaccine_event && flag_action == GROUP_ADD) \n\t\t\t{\n\t\t\t\tif (is_vaccine_event_payment_method)\n\t\t\t\t{\n\t\t\t\t\t$(item).attr('disabled', false);\n\t\t\t\t\t$(item).prop('checked', true);\n\t\t\t\t}\n\t\t\t} else \n\t\t\t{\n\t\t\t\tif (val == CURRENCY_IDR) {\n\t\t\t\t\tif (is_active_payment_idr)\n\t\t\t\t\t{\n\t\t\t\t\t\t$(item).attr('disabled', false);\n\t\t\t\t\t\t$(item).prop('checked', true)\n\t\t\t\t\t\treturn;\n\t\t\t\t\t} else \n\t\t\t\t\t{\n\t\t\t\t\t\t$(item).attr('disabled', true);\n\t\t\t\t\t\t$(item).prop('checked', false)\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif (typeof id_currency != 'undefined')\n\t\t\t\t{\n\t\t\t\t\tid_currency\t\t\t\t= id_currency.split(',');\n\t\t\t\t\tid_payment\t\t\t\t= $(item).attr('id').split('_')[2];\n\n\t\t\t\t\tif ($.inArray(val, id_currency) >= 0)\n\t\t\t\t\t{\n\t\t\t\t\t\t$(item).attr('disabled', false);\n\t\t\t\t\t\tif (val == existing_payment_currency)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif ($.inArray(id_payment, existing_payment_value) >= 0){\n\t\t\t\t\t\t\t\t$(item).prop('checked', true);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t$(item).prop('checked', true);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t});\n\t});\n\t\n\t$(document).on('click', '.delete-location', function(){\n\t\tif(confirm('Are you sure to delete this data?'))\n\t\t{\n\t\t\tvar id_location = $(this).data('id-location');\n\t\t\t$.post('/ajax_data/delete_location',{'id_location':id_location},function(return_id_location){\n\t\t\t\tif(return_id_location == id_location)\n\t\t\t\t{\n\t\t\t\t\t$('#location-row-' + return_id_location).fadeOut(1000);\n\t\t\t\t\tsetTimeout(function(){$('#location-row-' + return_id_location).remove()}, 2000);\n\t\t\t\t}\n\t\t\t},'json');\n\t\t}\n\t});\n\n\t$(document).on('click', '.delete-schedule', function(){\n\t\tif(confirm('Are you sure to delete this data?'))\n\t\t{\n\t\t\tvar id_schedule = $(this).data('id-schedule');\n\t\t\t$.post('/ajax_data/delete_schedule',{'id_schedule':id_schedule},function(return_id_schedule){\n\t\t\t\tif(return_id_schedule == id_schedule)\n\t\t\t\t{\n\t\t\t\t\t$('#schedule-row-' + return_id_schedule).fadeOut(1000);\n\t\t\t\t\tsetTimeout(function(){$('#schedule-row-' + return_id_schedule).remove()}, 2000);\n\t\t\t\t}\n\t\t\t},'json');\n\t\t}\n\t});\n\n\t$('#checkin_list_attendee_selected').click(function(){\n\t\tvar id_schedules \t= new Array;\n\t\tvar id_group \t\t= new Array;\n\n        $('input[type=\"checkbox\"][name=\"id_schedule[]\"]:checked').each(function(i){\n            id_schedules.push($(this).val());\n        });\n\n\t\t$('input[type=\"checkbox\"][name=\"id_group[]\"]:checked').each(function(i){\n\t\t\tid_group.push($(this).val());\n\t\t});\n\n\t\tif (id_schedules.length > 0)\n\t\t{\n\t\t\tlocation.href = '/ticket/checkin/attendee/' + id_schedules.join('-') + '?id_group=' + id_group.join('-');\n\t\t}\n\t\telse\n\t\t{\n\t\t\talert(\"For multiple checkin attendee, please select the schedules!\");\n\t\t}\n\t});\n\n\t$('#reset-account').on('click', function (e) {\n\t\te.preventDefault();\n\t\tconst field = document.querySelector('#reset-account');\n\t\tconst id_user = field.getAttribute('data-id-user')\n\t\tconst confirmation_label = field.getAttribute('data-confirmation-label')\n\t\tif (confirm(confirmation_label)) {\n\t\t\tconst payload = {\n\t\t\t\tid_user\n\t\t\t}\n\t\t\tconst self = this;\n\t\t\t$(self).attr('disabled', true)\n\t\t\t$(self).html('Loading...')\n\t\t\t$.ajax({\n\t\t\t\turl\t\t\t: '/ajax_data/reset_account',\n\t\t\t\ttype\t\t: 'POST',\n\t\t\t\tdataType\t: 'json',\n\t\t\t\tdata\t\t: payload\n\t\t\t})\n\t\t\t.done(function (result) {\n\t\t\t\talert(result.message)\n\t\t\t\t$(self).html('Reset Account')\n\t\t\t\t$(self).attr('disabled', false)\n\t\t\t})\n\t\t}\n\t});\n\n\t$('#reset-2fa').on('click', function (e) {\n\t\te.preventDefault();\n\t\tconst field = document.querySelector('#reset-2fa');\n\t\tconst id_user = field.getAttribute('data-id-user')\n\t\tconst confirmation_label = field.getAttribute('data-confirmation-label')\n\t\tif (confirm(confirmation_label)) {\n\t\t\tconst payload = {\n\t\t\t\tid_user\n\t\t\t}\n\t\t\tconst self = this;\n\t\t\t$(self).attr('disabled', true)\n\t\t\t$(self).html('Loading...')\n\t\t\t$.ajax({\n\t\t\t\turl\t\t\t: '/ajax_data/reset_2fa',\n\t\t\t\ttype\t\t: 'POST',\n\t\t\t\tdataType\t: 'json',\n\t\t\t\tdata\t\t: payload\n\t\t\t})\n\t\t\t.done(function (result) {\n\t\t\t\talert(result.message)\n\t\t\t\t$(self).html('2FA has been reseted')\n\t\t\t\t$(self).attr('disabled', false)\n\t\t\t\twindow.location.reload()\n\t\t\t})\n\t\t}\n\t});\n});\n\nfunction generate_code(generate_count, code_length, code_prefix)\n{\n\tvar generate_count\t= $('#generate_count').val();\n\tvar code_length\t\t= $('#code_length').val();\n\tvar code_prefix\t\t= $('#code_prefix').val();\n\tvar numeric_only\t= $('#code_numeric_only').is(\":checked\") ? 1 : 0;\n\tvar post_data\t\t= \n\t{\n\t\t'generate_count': generate_count,\n\t\t'code_length'\t: code_length,\n\t\t'code_prefix'\t: code_prefix,\n\t\t'numeric_only'\t: numeric_only\n\t};\n\n\t$.post('/ajax_data/generate_code', post_data, function(data)\n\t{\n\t\tif (data.error == false)\n\t\t{\n\t\t\t$('#result-code').val(data.data);\n\t\t} \n\t\telse\n\t\t{\n\t\t\talert(data.error_message);\n\t\t}\n\t}, 'json');\n}\n\nfunction set_status_record(field, id_record, set_to, el)\n{\t\n\t$.post('/ajax_data/set_status_record',{'field':field, 'id_record':id_record, 'set_to':set_to}, function(data)\n\t{\n\t\tif(data.error == false)\n\t\t{\n\t\t\tel.text(data.set_to_text);\n\t\t\tel.attr('class',data.button_class);\n\t\t\tel.attr('onClick','set_status_record(\"'+field+'\", '+id_record+','+data.set_to+',$(this));return false;');\n\t\t\tif (data.set_to == 1)\n\t\t\t{\n\t\t\t\tif(!$('#status_record_'+id_record).hasClass('badge-grey'))\n\t\t\t\t{\n\t\t\t\t\t$('#status_record_'+id_record).attr('class','badge-grey');\t\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$('#status_record_'+id_record).removeClass('badge-grey');\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$('#status_record_'+id_record).removeClass('badge-grey');\n\t\t\t}\n\t\t\t\n\t\t}\n\t\telse\n\t\t{\n\t\t\talert(data.message);\n\t\t}\n\t}, 'json');\n}\n\nfunction set_status_email(id_email, set_to)\n{\t\n\tvar notes\t= $('#notes').val();\n\tpost\t\t= \n\t{\n\t\t'id_email'\t: id_email,\n\t\t'set_to'\t: set_to,\n\t\t'notes'\t\t: notes\n\t}\n\t$.post('/ajax_data/set_status_email', post, function(data)\n\t{\n\t\talert(data.message);\n\n\t\t$('.status').prop('disabled', true);\n\n\t\tsetTimeout(function() \n\t\t{\n\t\t\tlocation.href='/marketing/email/';\n\t\t}, '1000');\n\n\t}, 'json');\n}\n\nfunction set_group_bin(id_list_bin, id_group, set_to, el)\n{\t\n\t$.post('/ajax_data/set_group_bin',{'id_list_bin':id_list_bin, 'id_group':id_group,'set_to':set_to}, function(data)\n\t{\n\t\tif(data.error == false)\n\t\t{\n\t\t\tel.text(data.set_to_text);\n\t\t\tel.attr('class',data.button_class);\n\t\t\tel.attr('onClick','set_group_bin('+id_list_bin+','+id_group+','+data.set_to+',$(this));return false;');\n\t\t\tif (data.set_to == 1)\n\t\t\t{\n\t\t\t\tif(!$('#status_record_'+id_list_bin).hasClass('badge-grey'))\n\t\t\t\t{\n\t\t\t\t\t$('#status_record_'+id_list_bin).attr('class','badge-grey');\t\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$('#status_record_'+id_list_bin).removeClass('badge-grey');\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t$('#status_record_'+id_list_bin).removeClass('badge-grey');\n\t\t\t}\n\t\t\t\n\t\t}\n\t\telse\n\t\t{\n\t\t\talert(data.message);\n\t\t}\n\t}, 'json');\n}\n\nfunction del_data(url)\n{\n\tif(confirm('Are you sure to delete this data?'))\n\t{\n\t\tlocation.href= url;\n\t}\n}\n\nfunction handleFileSelect(a)\n{\n\tfor (var d = a.target.files, c = 0, b; b = d[c]; c++) {\n\t\tif (!b.type.match(\"image.*\")) return $(\"#dialogModal\").modal(\"show\"), !1;\n\t\tvar e = new FileReader;\n\t\te.onload = function(b) {\n\t\t\treturn function(a) {\n\t\t\t\tdocument.createElement(\"span\").innerHTML = ['<img id=\"imageView\" src=\"', a.target.result, '\" title=\"', escape(b.name), '\">'].join(\"\");\n\t\t\t\tdocument.getElementById(\"image-preview\").innerHTML = '<img src=\"' + a.target.result + '\">';\n\t\t\t\ta = $(\"#image-preview\").height();\n\t\t\t}\n\t\t}(b);\n\t\te.readAsDataURL(b)\n\t}\n\td = a.target.files;\n\ta = [];\n\tfor (c = 0; b = d[c]; c++) a.push(\"<b>\", escape(b.name), \"</b> (\", b.type || \"n/a\", \") - \", b.size, \" Kb\");\n\tdocument.getElementById(\"data-preview\").innerHTML = '<div class=\"label-preview\">' + a.join(\"\") + \" - Max 2MB</div>\";\n\t$(this).parent().parent().addClass(\"file-focus\")\n}\n\nfunction check_promo_page(value_check)\n{\n\tif (typeof value_check != 'undefined')\n\t{\n\t\t$.post('/ajax_data/check_promo_page', value_check, function(result)\n\t\t{\n\t\t\t$('#bin_alert').attr('class','alert ' + result.response_bin.cls).html(result.response_bin.message).fadeIn();\n\t\t\tif (!result.response_bin.error)\n\t\t\t{\n\t\t\t\t$('#bin').fadeOut('slow');\n\t\t\t}\n\t\t\tif (!result.error)\n\t\t\t{\n\t\t\t\tsetTimeout(function() \n\t\t\t\t{\n\t\t\t\t\tlocation.reload();\n\t\t\t\t}, '1000');\n\t\t\t}\n\t\t}, 'json');\n\t}\n\telse\n\t{\n\t\talert('Undefined BIN Number.');\n\t}\n}\n\nfunction save_email_template(type)\n{\n\t$('.btn_save').attr(\"disabled\", true);\n\t$('.btn_save').html(\"Loading...\");\n\t\n\ttemplate_type\t\t\t\t= $('#template-type').val();\n\tsubject\t\t\t\t\t\t= $('#subject').val();\n\tsubject_english\t\t\t\t= $('#subject-english').val();\n\tstatus_template\t\t\t\t= $('input:radio[name=\"status_template\"]:checked').val(); \n\tid_template\t\t\t\t\t= $('input[name=\"id_template\"]').val();\n\tid_event\t\t\t\t\t= $('input[name=\"id_event\"]').val();\n\tcontent_template\t\t\t= $('#raw-contents').val();\n\tcontent_template_english\t= $('#raw-contents-english').val();\n    content_wa_id               = $('#content_wa_id').val();\n    content_wa_en               = $('#content_wa_en').val();\n\tif (type == 'inline')\n\t{\n\t\tcontent_template\t\t\t= $('#email-contents').contents().find('#save-content-below').clone().wrap('<html/>').html();\n\t\tcontent_template_english\t= $('#email-contents-english').contents().find('#save-content-below').clone().wrap('<html/>').html();\n\t}\n\t// prepare post data\n\tvar post\t\t\t\t= {\n\t\t'template_type'\t\t: template_type,\n\t\t'subject'\t\t\t: subject,\n\t\t'subject_english'\t: subject_english,\n\t\t'status_template'\t: status_template,\n\t\t'id_template'\t\t: id_template,\n\t\t'content'\t\t\t: content_template,\n\t\t'content_english'\t: content_template_english,\n\t\t'id_event'\t\t\t: id_event,\n        'content_wa_id'     : content_wa_id,\n        'content_wa_en'     : content_wa_en,\n\t};\n\tconsole.log(post);\n\t$.post('/ajax_data/save_email_template', post, function(data)\n\t{\n\t\talert(data.message);\n\n\t\tsetTimeout(function() \n\t\t{\n\t\t\tlocation.href='/template/email/';\n\t\t}, '1000');\n\n\t\t$('.btn_save').attr(\"disabled\", false);\n\t\t$('.btn_save').html(\"Save\");\n\n\t},'json');\n}\n\nfunction save_email_blast(type)\n{\n\t$('.btn_save').attr(\"disabled\", true);\n\t$('.btn_save').html(\"Loading...\");\n\t\n\tvar post\t\t\t\t= $('#form-email-blast').serializeArray();\n\tif (type == 'inline')\n\t{\n\t\tvar content_email\t= $('#email-contents').contents().find('html').clone().wrap('<html/>').parent().html();\n\t\tpost.push({name : 'content_email', value : content_email});\n\t}\n\t$.post('/ajax_data/save_email_blast', post, function(data)\n\t{\n\t\talert(data.message);\n\n\t\t$('#save').prop('disabled', true);\n\n\t\tsetTimeout(function() \n\t\t{\n\t\t\tlocation.href='/marketing/email/';\n\t\t}, '1000');\n\t\t\n\t},'json');\n}\n\n// duplicate to w.js\nfunction countChars(e)\n{\n\tvar text_limit = $('#'+ $(e).attr('id') + '-length').data($(e).attr('id') + '-length');\n\tvar text_length = $(e).val().length;\n\t$('#'+ $(e).attr('id') + '-length').html(text_limit-text_length);\n\tif (text_length > text_limit)\n\t{\n\t\t$(e).attr('style','color:#FF3A2D;');\n\t}\n\telse\n\t{\n\t\t$(e).attr('style', '');\n\t}\n}\n\n// add comma after press space\nfunction add_comma_on_space(element,event){\n\tif (event.keyCode === 0 || event.keyCode === 32) {\n\t\tvar val = $(element).val();\n\t\t$(element).val(val + ', ');\n\t}\n}\n\nfunction debounce(func, wait, immediate) {\n    var timeout;\n    return function() {\n        var context = this, args = arguments;\n        var later = function() {\n            timeout = null;\n            if (!immediate) func.apply(context, args);\n        };\n        var callNow = immediate && !timeout;\n        clearTimeout(timeout);\n        timeout = setTimeout(later, wait);\n        if (callNow) func.apply(context, args);\n    };\n};\n\nfunction validate_split_group_attendee(id_group, id_ticket) \n{\n\tlet ticket_qty = $(`#ticket_${id_group}_${id_ticket}`).val();\n\tlet grouping = $(`#grouping_${id_group}_${id_ticket}`).val();\n\tparam  = {\n\t\tid_group, \n\t\tid_ticket,\n\t\tticket_qty,\n\t\tgrouping\n\t}\n\t\n\tif (grouping == \"\")\n\t{\n\t\t$(`#child_attendee_information_${id_ticket}`).text(`0`);\n\t\treturn;\n\t}\n\n\t$.post('/ajax_data/validate_split_attende_group', param, function(data)\n\t{\n\t\tlet {error, message} = data\n\t\t\n\t\tif (error) \n\t\t{\n\t\t\t$(`#grouping_${id_group}_${id_ticket}`).val(0)\n\t\t\talert(message)\n\t\t\t$(`#child_attendee_information_${id_ticket}`).text(`0`);\n            _clear_grouping_ticket(id_ticket);\n            $(`#btn_set_group_`+id_ticket).attr('disabled', 'disabled');\n\t\t\treturn;\n\t\t}\n\t\tlet {child_attendee} = data.data\n\t\t$(`#child_attendee_information_${id_ticket}`).text(`${child_attendee}`);\n\t\t$(`#btn_set_group_`+id_ticket).removeAttr('disabled');\n        generate_grouping_form(id_group, id_ticket);\n\t},'json');\n}\n\nfunction generate_grouping_form(id_group, id_ticket)\n{\n    var modal = $('#modal-set-group_'+id_ticket);\n    var body = modal.find('tbody');\n\tvar foot = modal.find('tfoot');\n    _clear_grouping_ticket(id_ticket);\n\n    var total_qty = $('#ticket_'+id_group+'_'+id_ticket).val();\n    $('#modal-set-group_'+id_ticket+'__total-qty').text('Total Qty: '+ total_qty);\n    \n    var total_group = $(`#grouping_${id_group}_${id_ticket}`).val();\n    var qty_assigned = 0;\n    for (var idx = 0; idx < total_group; idx++) {\n        var qty = (idx != total_group - 1 ? Math.floor(total_qty/total_group) : (total_qty - qty_assigned)); \n        var tr = '<tr>' +\n                    '<td style=\"text-align: left;\">Group #'+(idx + 1)+'</td>' +\n                    '<td>'+\n                        '<input type=\"number\" class=\"ticket_grouping_input__'+id_ticket+'\" name=\"grouping['+id_ticket+']['+idx+']\" value=\"'+qty+'\">'+\n                    '</td>'+\n                  '</tr>';\n        body.append(tr);\n        qty_assigned += qty;\n    }\n\t\n    var tr = '<tr>' +\n                '<th style=\"text-align: left;\">&nbsp;</th>' +\n                '<th id=\"sum_qty_'+id_ticket+'\">'+qty_assigned+'</th>'+\n             '</tr>';\n    foot.append(tr);\n}\n\nfunction _clear_grouping_ticket(id_ticket) {\n    var modal = $('#modal-set-group_'+id_ticket);\n    var body = modal.find('tbody');\n    body.html('');\n\tvar foot = modal.find('tfoot');\n    foot.html('');\n}\n\n\nfunction check_ticket_quantity(widget_code, csrf_token, id_group, id_ticket, arrival_date = '')\n{\n\t//check max qty ticket\n\tvar max_qty_ticket\t\t\t\t\t= $('#form-user :input[type=hidden][name=max_qty_ticket]').val();\n\tvar ticket_sum\t\t\t\t\t\t= 0;\n\tvar ticket_qty\t\t\t\t\t\t= 0;\n\tvar form_sum \t\t\t\t\t\t= 0;\n\tvar is_enable_associate_id\t\t\t= $('#form-user input[name=is_associate_id]').val();\n\tvar is_enable_checkin\t\t\t\t= $('#form-user input[name=ticketbox_checkin]').val();\n\tvar count_ticket\t\t\t\t\t= $('#ticket_'+id_group+'_'+id_ticket).val();\n\tvar latest_associate_input\t\t\t= $('.add-associate', '#invitation-code-wrap').length;\n\tvar ticket_type_name\t\t\t\t= $('#ticket_'+id_group+'_'+id_ticket).attr('data-tt-name');\n\tvar is_same_ticket\t\t\t\t\t= $('#form-user :input[type=hidden][name=is_same_ticket]').val();\n\tvar is_same_ticket_lang\t\t\t\t= $('#form-user :input[type=hidden][name=is_same_ticket_lang]').val();\n\tvar event_type\t\t\t\t\t\t= $('input[name=event_type]').val();\n\tlet custom_price\t\t\t\t\t= remove_character_from_string($(`.custom_price_field_${id_ticket}`).val() ?? '')\n\tvar arrival_date = arrival_date;\n\tvar grouping = $(`#grouping_${id_group}_${id_ticket}`).val()\n\tif (!event_type)\n\t\tevent_type = 0\n\n\tif(is_same_ticket==1){\n\t\tvar self = $(\"select#ticket_\"+id_group+\"_\"+id_ticket);\n\t\n\t\tvar ticket_qtys = []\n\t\t$('#ticket_list select').each(function (id, select_qty) {\n\t\t\tif ($(select_qty).val() > 0) ticket_qtys.push($(select_qty).val());\n\t\t})\n\t\t\n\t\tif (ticket_qtys.length > 1) {\n\t\t\t$(self).val(0);\n\t\t\talert(is_same_ticket_lang);\n\t\t}\n\t}\n\t\n\t$('#ticket_list select').map(function () \n\t{\n\t\tticket_qty\t\t= $(this).val();\n\t\tif (ticket_qty) \n\t\t{\n\t\t\tticket_sum\t\t+= parseInt(ticket_qty);\n\t\t}\n\t});\n\n\t$('#ticket_list input[type=text]').map(function () \n\t{\n\t\tlet is_payw_ticket = $(this).data('is-payw') == undefined ? false : true;\n\t\tticket_qty\t\t= $(this).val();\n\t\tif (!is_payw_ticket) {\n\t\t\tif (ticket_qty) \n\t\t\t{\n\t\t\t\tticket_sum\t\t+= parseInt(ticket_qty);\n\t\t\t}\n\t\t}\n\t});\n\n\tticket_qty\t\t\t= $(\"#ticket_\"+id_group+\"_\"+id_ticket).val();\n\n    param_data = {\n        'widget_code'       : widget_code,\n        'csrf_token'        : csrf_token,\n        'id_group'          : id_group,\n        'id_ticket'         : id_ticket,\n        'ticket_qty'        : ticket_qty,\n        'ticket_sum'        : ticket_sum,\n        'event_type'        : event_type,\n\t\t'arrival_date'\t\t: arrival_date,\n\t\t'custom_price'\t\t: parseInt(custom_price)\n    }\n\n    if (event_type == 1)\n        param_data['ticket_tiering_price'] = $('#ticket_'+id_group+'_'+id_ticket).attr('data-price');\n\n\t$.post('/widget/'+widget_code+'/check_quantity', param_data, function(data)\n\t{\n\t\t$(\".alert\").hide();\n\n\t\t$(\"#new_price_\"+id_ticket).html(data.new_price);\n\t\tset_total_purchase();\n\n\t\tsub_total_price = calculate_total_price();\n\t\t$(\"#total_price\").val(sub_total_price)\n\t\tif (data.reset_to_zero)\n\t\t{\n\t\t\t$(\"#new_price_\"+id_ticket).html(\"Rp. 0\");\n\t\t\t$(`.custom_price_field_${id_ticket}`).val('');\n\t\t\t$(\"#ticket_\"+id_group+\"_\"+id_ticket).val(\"0\");\n\t\t\t$(\"#ticket_\"+id_group+\"_\"+id_ticket).focus();\n\t\t}\n\n\t\tif (data.error)\n\t\t{\n            $(\"#ticket_\"+id_group+\"_\"+id_ticket).val(\"0\");\n\t\t\talert(data.message);\n\t\t}\n\t\telse\n\t\t{\n\t\t\t//show intitiation box per ticket\n\t\t\t// show_invitation_box(ticket_sum);\n\t\t\t//check associate\n\t\t\tif (typeof is_enable_associate_id != 'undefined' && is_enable_checkin == true)\n\t\t\t{\n\t\t\t\t//generate form\n\t\t\t\t$('#invitation-code-wrap input').map(function () \n\t\t\t\t{\n\t\t\t\t\tform_associate_id\t\t\t= $(this).attr('data-ticket-id');\n\t\t\t\t\tif (form_associate_id == id_ticket) \n\t\t\t\t\t{\n\t\t\t\t\t\tform_sum++;\n\t\t\t\t\t}\n\t\t\t\t});\t\n\n\t\t\t\t//empty if associate not enable\n\t\t\t\tif (latest_associate_input > 0 && is_enable_associate_id == false)\n\t\t\t\t{\n\t\t\t\t\t$('#invitation-code-wrap').empty();\n\t\t\t\t}\n\t\t\t\telse if (form_sum < count_ticket)\n\t\t\t\t{\n\t\t\t\t\tfor(counter=form_sum; counter < count_ticket; counter++)\n\t\t\t\t\t{\n\t\t\t\t\t\tif (is_enable_associate_id == true)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tvar $associate = $('.add-associate', '#associate-id-template').clone();\n\t\t\t\t\t\t\t$associate.attr('class', id_ticket+' add-associate');\n\t\t\t\t\t\t\t$associate.find('input[type=text]').attr('name','associate_id['+id_ticket+'][]').attr('data-ticket-id', id_ticket);\n\t\t\t\t\t\t\t$associate.find('label.ticket_type_name').text(ticket_type_name);\n\t\t\t\t\t\t\t$('#invitation-code-wrap').append($associate);\n\t\t\t\t\t\t}\n\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tvar el\t\t= $('#invitation-code-wrap .add-associate').filter('.'+id_ticket);\n\t\t\t\t\tvar length\t= el.length;\n\t\t\t\t\tfor(counter=length; counter > count_ticket; counter--)\n\t\t\t\t\t{\n\t\t\t\t\t\tel.eq((counter-1)).remove();\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\n\t\t}\n\t\tif (grouping != \"\" && grouping != undefined) \n\t\t{\n\t\t\tvalidate_split_group_attendee(id_group, id_ticket)\n\t\t}\n\t\ttotal_qty = calculate_total_qty();\n\t\t$(\"#total_qty\").val(total_qty)\n\t},'json');\n}\n\nfunction check_ticket_quantity_ticketbox(id_group, id_ticket, arrival_date = '')\n{\n    //check max qty ticket\n    var max_qty_ticket\t\t\t\t\t= $('#form-user :input[type=hidden][name=max_qty_ticket]').val();\n    var ticket_sum\t\t\t\t\t\t= 0;\n    var ticket_qty\t\t\t\t\t\t= 0;\n    var form_sum \t\t\t\t\t\t= 0;\n    var is_enable_associate_id\t\t\t= $('#form-user input[name=is_associate_id]').val();\n    var is_enable_checkin\t\t\t\t= $('#form-user input[name=ticketbox_checkin]').val();\n    var count_ticket\t\t\t\t\t= $('#ticket_'+id_group+'_'+id_ticket).val();\n    var latest_associate_input\t\t\t= $('.add-associate', '#invitation-code-wrap').length;\n    var ticket_type_name\t\t\t\t= $('#ticket_'+id_group+'_'+id_ticket).attr('data-tt-name');\n    var is_same_ticket\t\t\t\t\t= $('#form-user :input[type=hidden][name=is_same_ticket]').val();\n    var is_same_ticket_lang\t\t\t\t= $('#form-user :input[type=hidden][name=is_same_ticket_lang]').val();\n    var event_type\t\t\t\t\t\t= $('input[name=event_type]').val();\n    let custom_price\t\t\t\t\t= remove_character_from_string($(`.custom_price_field_${id_ticket}`).val() ?? '')\n    var arrival_date = arrival_date;\n    var grouping = $(`#grouping_${id_group}_${id_ticket}`).val()\n    if (!event_type)\n        event_type = 0\n\n    if(is_same_ticket==1){\n        var self = $(\"select#ticket_\"+id_group+\"_\"+id_ticket);\n\n        var ticket_qtys = []\n        $('#ticket_list select').each(function (id, select_qty) {\n            if ($(select_qty).val() > 0) ticket_qtys.push($(select_qty).val());\n        })\n        \n        if (ticket_qtys.length > 1) {\n            $(self).val(0);\n            alert(is_same_ticket_lang);\n        }\n    }\n\n    $('#ticket_list select').map(function () \n    {\n        ticket_qty\t\t= $(this).val();\n        if (ticket_qty) \n        {\n            ticket_sum\t\t+= parseInt(ticket_qty);\n        }\n    });\n\n    $('#ticket_list input[type=text]').map(function () \n    {\n        let is_payw_ticket = $(this).data('is-payw') == undefined ? false : true;\n        ticket_qty\t\t= $(this).val();\n        if (!is_payw_ticket) {\n            if (ticket_qty) \n            {\n                ticket_sum\t\t+= parseInt(ticket_qty);\n            }\n        }\n    });\n\n    ticket_qty\t\t\t= $(\"#ticket_\"+id_group+\"_\"+id_ticket).val();\n\n    param_data = {\n        'id_group'          : id_group,\n        'id_ticket'         : id_ticket,\n        'ticket_qty'        : ticket_qty,\n        'ticket_sum'        : ticket_sum,\n        'event_type'        : event_type,\n        'arrival_date'\t\t: arrival_date,\n        'custom_price'\t\t: parseInt(custom_price)\n    }\n\n    if (event_type == 1)\n        param_data['ticket_tiering_price'] = $('#ticket_'+id_group+'_'+id_ticket).attr('data-price');\n\n    $.post('/ajax_data/check_quantity_ticketbox', param_data, function(data)\n    {\n        $(\".alert\").hide();\n\n        $(\"#new_price_\"+id_ticket).html(data.new_price);\n        set_total_purchase();\n\n        sub_total_price = calculate_total_price();\n        $(\"#total_price\").val(sub_total_price)\n        if (data.reset_to_zero)\n        {\n            $(\"#new_price_\"+id_ticket).html(\"Rp. 0\");\n            $(`.custom_price_field_${id_ticket}`).val('');\n            $(\"#ticket_\"+id_group+\"_\"+id_ticket).val(\"0\");\n            $(\"#ticket_\"+id_group+\"_\"+id_ticket).focus();\n        }\n\n        if (data.error)\n        {\n            $(\"#ticket_\"+id_group+\"_\"+id_ticket).val(\"0\");\n            alert(data.message);\n        }\n        else\n        {\n            //show intitiation box per ticket\n            // show_invitation_box(ticket_sum);\n            //check associate\n            if (typeof is_enable_associate_id != 'undefined' && is_enable_checkin == true)\n            {\n                //generate form\n                $('#invitation-code-wrap input').map(function () \n                {\n                    form_associate_id\t\t\t= $(this).attr('data-ticket-id');\n                    if (form_associate_id == id_ticket) \n                    {\n                        form_sum++;\n                    }\n                });\t\n\n                //empty if associate not enable\n                if (latest_associate_input > 0 && is_enable_associate_id == false)\n                {\n                    $('#invitation-code-wrap').empty();\n                }\n                else if (form_sum < count_ticket)\n                {\n                    for(counter=form_sum; counter < count_ticket; counter++)\n                    {\n                        if (is_enable_associate_id == true)\n                        {\n                            var $associate = $('.add-associate', '#associate-id-template').clone();\n                            $associate.attr('class', id_ticket+' add-associate');\n                            $associate.find('input[type=text]').attr('name','associate_id['+id_ticket+'][]').attr('data-ticket-id', id_ticket);\n                            $associate.find('label.ticket_type_name').text(ticket_type_name);\n                            $('#invitation-code-wrap').append($associate);\n                        }\n                        \n                    }\n                }\n                else\n                {\n                    var el\t\t= $('#invitation-code-wrap .add-associate').filter('.'+id_ticket);\n                    var length\t= el.length;\n                    for(counter=length; counter > count_ticket; counter--)\n                    {\n                        el.eq((counter-1)).remove();\n                    }\n                }\n            }\n\n        }\n        if (grouping != \"\" && grouping != undefined) \n        {\n            validate_split_group_attendee(id_group, id_ticket)\n        }\n        total_qty = calculate_total_qty();\n        $(\"#total_qty\").val(total_qty)\n    },'json');\n}\n\nfunction check_ticket_quantity_radio(id_group, id_ticket)\n{\n\tvar max_qty_ticket\t\t\t\t= $('#form-user :input[type=hidden][name=max_qty_ticket]').val();\n\tvar ticket_sum\t\t\t\t\t= 0;\n\tvar ticket_qty\t\t\t\t\t= 0;\n\tvar form_sum \t\t\t\t\t= 0;\n\tvar is_enable_associate_id\t\t= $('#form-user input[name=is_associate_id]').val();\n\tvar is_enable_checkin\t\t\t= $('#form-user input[name=ticketbox_checkin]').val();\n\tvar latest_associate_input\t\t= $('.add-associate', '#invitation-code-wrap').length;\n\tvar ticket_type_name\t\t\t= $('.ticket_'+id_group+'_'+id_ticket+':checked').attr('data-tt-name');\n\tvar is_same_ticket\t\t\t\t= $('#form-user :input[type=hidden][name=is_same_ticket]').val();\n\tvar is_same_ticket_lang\t\t\t= $('#form-user :input[type=hidden][name=is_same_ticket_lang]').val();\n\tvar id_list_payment\t\t\t\t= $('input[name=id_list_payment]:checked').val();\n\tvar id_ticket_type\t\t\t\t= $('.ticket_'+id_group+'_'+id_ticket+':checked').attr('data-tt-id');\n    var event_type                  = $('input[name=event_type]').val();\n\t\n\tif (is_same_ticket == 1) {\n\t\tvar self = $(\"#ticket_\"+id_group+\"_\"+id_ticket+\"-0\");\n\t\tvar ticket_qtys = []\n\t\t$('#ticket_list :radio').each(function (id, select_qty) {\n\t\t\tif ($(select_qty).val() > 0 && $(select_qty).is(':checked')) ticket_qtys.push($(select_qty).val());\n\t\t})\n\t\t\n\t\tif (ticket_qtys.length > 1) {\n\t\t\t$(self).prop('checked', true);\n\t\t\talert(is_same_ticket_lang);\n\t\t}\n\t}\n\t\n\t$('#ticket_list :radio').map(function () \n\t{\n\t\tvar el \t= $(this);\n\t\tif (el.is(':checked')) {\n\t\t\tvar ticket_qty\t\t= el.val();\n\t\t\tif (ticket_qty) \n\t\t\t{\n\t\t\t\tticket_sum\t\t+= parseInt(ticket_qty);\n\t\t\t}\n\t\t}\n\t});\n\n\tticket_qty = $(\".ticket_\"+id_group+\"_\"+id_ticket+\":checked\").val();\n    param_data = {\n        'id_ticket_type'    : id_ticket_type,\n        'id_list_payment'   : id_list_payment,\n        'id_group'          : id_group,\n        'id_ticket'         : id_ticket,\n        'ticket_qty'        : ticket_qty,\n        'ticket_sum'        : ticket_sum,\n        'event_type'        : event_type,\n    }\n\n    if (event_type == 1)\n        param_data['ticket_tiering_price'] = $('.ticket_'+id_group+'_'+id_ticket+':checked').attr('data-price');\n    \n\t$.post('/ajax_data/check_quantity_ticketbox', param_data, function(data)\n\t{\n\t\t$(\".alert\").hide();\n\t\t$(\"#new_price_\"+id_ticket).html(data.new_price);\n\t\tset_total_purchase();\n\n\t\tif (data.reset_to_zero)\n\t\t{\n\t\t\t$(\"#new_price_\"+id_ticket).html(\"Rp. 0\");\n\t\t\t$(\"#ticket_\"+id_group+\"_\"+id_ticket).val(\"0\");\n\t\t\t$(\"#ticket_\"+id_group+\"_\"+id_ticket).focus();\n\t\t}\n\n\t\tif (data.error) {\n\t\t\talert(data.message);\n\t\t}\n\t\telse\n\t\t{\n\t\t\tif (typeof is_enable_associate_id != 'undefined' && is_enable_checkin == true)\n\t\t\t{\n\t\t\t\t$('#invitation-code-wrap input').map(function () \n\t\t\t\t{\n\t\t\t\t\tform_associate_id\t\t\t= $(this).attr('data-ticket-id');\n\t\t\t\t\tif (form_associate_id == id_ticket) \n\t\t\t\t\t{\n\t\t\t\t\t\tform_sum++;\n\t\t\t\t\t}\n\t\t\t\t});\t\n\n\t\t\t\t//empty if associate not enable\n\t\t\t\tif (latest_associate_input > 0 && is_enable_associate_id == false)\n\t\t\t\t{\n\t\t\t\t\t$('#invitation-code-wrap').empty();\n\t\t\t\t}\n\t\t\t\telse if (form_sum < ticket_qty)\n\t\t\t\t{\n\t\t\t\t\tfor(counter=form_sum; counter < ticket_qty; counter++)\n\t\t\t\t\t{\n\t\t\t\t\t\tif (is_enable_associate_id == true)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tvar $associate = $('.add-associate', '#associate-id-template').clone();\n\t\t\t\t\t\t\t$associate.attr('class', id_ticket+' add-associate');\n\t\t\t\t\t\t\t$associate.find('input[type=text]').attr('name','associate_id['+id_ticket+'][]').attr('data-ticket-id', id_ticket);\n\t\t\t\t\t\t\t$associate.find('label.ticket_type_name').text(ticket_type_name);\n\t\t\t\t\t\t\t$('#invitation-code-wrap').append($associate);\n\t\t\t\t\t\t}\n\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\tvar el\t\t= $('#invitation-code-wrap .add-associate').filter('.'+id_ticket);\n\t\t\t\t\tvar length\t= el.length;\n\t\t\t\t\tfor(counter=length; counter > ticket_qty; counter--)\n\t\t\t\t\t{\n\t\t\t\t\t\tel.eq((counter-1)).remove();\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\n\t\t\tif (latest_associate_input > 0 && is_enable_associate_id == false)\n\t\t\t{\n\t\t\t\t$('#invitation-code-wrap').empty();\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tif (is_enable_associate_id == true)\n\t\t\t\t{\n\t\t\t\t\tticket_giveaway_ticketbox(data, id_ticket_type);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t},'json');\n}\n\nfunction check_promo_ticket_box($id_list_payment)\n{\n\t$.post('/ajax_data/check_giveaway_ticketbox/'+$id_list_payment, $(\"#ticket_list :input:checked\").serialize(), function(data, textStatus, xhr) {\n\t\t//reset form associate\n\t\tvar el\t\t= $('#invitation-code-wrap .add-associate-promo');\n\t\tvar length\t= el.length;\n\t\t\n\t\tfor(counter=length; counter > 0; counter--)\n\t\t{\n\t\t\tel.eq((counter-1)).remove();\n\t\t}\n\t\n\t\t//append\n\t\tif(data.data_promo != null){\n\t\t\t$.each(data.data_promo, function (index, data_promo) {\n\t\t\t\tfor(counter=1; counter <= data_promo.qty_ticket_type_extra; counter++)\n\t\t\t\t{\n\t\t\t\t\tvar $associate = $('.add-associate', '#associate-id-template').clone();\n\t\t\t\t\t$associate.attr('class', data_promo.id_ticket_type+'-'+data_promo.id_ticket_type_extra+' add-associate-promo');\n\t\t\t\t\t$associate.find('input[type=text]')\n\t\t\t\t\t.attr('name','associate_id['+data_promo.id_ticket+'][]')\n\t\t\t\t\t.attr('data-ticket-id', data_promo.id_ticket)\n\t\t\t\t\t.attr('data-ticket-promo', data_promo.id_ticket_type+'-'+data_promo.id_ticket_type_extra);\n\t\t\t\t\t$associate.find('label.ticket_type_name').text(data_promo.ticket_type);\n\t\t\t\t\t$('#invitation-code-wrap').append($associate);\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t});\n}\n\nfunction ticket_giveaway_ticketbox(data, id_ticket_type)\n{\n\tif(data.data_promo != null){\n\t\tvar form_sum_promo = 0;\n\t\t// save to history\n\t\tvar history_promo = $('span', '#history-promo-giveaway').filter('.'+id_ticket_type+'-'+data.data_promo.id_ticket_type_extra).length;\n\n\t\tif(history_promo>0){\n\t\t\t//update qty\n\t\t\t$('span', '#history-promo-giveaway').filter('.'+id_ticket_type+'-'+data.data_promo.id_ticket_type_extra).attr('data-qtyextra', data.data_promo.qty_ticket_type_extra);\n\t\t}else{\n\t\t\t//append\n\t\t\t$('#history-promo-giveaway')\n\t\t\t.append('<span data-idtickettype=\"'+id_ticket_type+'\" data-idextra=\"'+data.data_promo.id_ticket_type_extra+'\" data-qtyextra=\"'+data.data_promo.qty_ticket_type_extra+'\" class=\"'+id_ticket_type+'-'+data.data_promo.id_ticket_type_extra+' '+id_ticket_type+'\"></span>');\n\t\t}\n\t\t\n\t\t//count existing input fee ticket\n\t\t$('#invitation-code-wrap input').map(function () \n\t\t{\n\t\t\tform_associate_id_promo\t\t\t= $(this).attr('data-ticket-promo');\n\t\t\tif (form_associate_id_promo == id_ticket_type+'-'+data.data_promo.id_ticket_type_extra) \n\t\t\t{\n\t\t\t\tform_sum_promo++;\n\t\t\t}\n\t\t});\t\n\t\t\n\t\t//empty if associate not enable\n\t\tif (form_sum_promo < data.data_promo.qty_ticket_type_extra)\n\t\t{\n\t\t\tfor(counter=form_sum_promo; counter < data.data_promo.qty_ticket_type_extra; counter++)\n\t\t\t{\n\t\t\t\tvar $associate = $('.add-associate', '#associate-id-template').clone();\n\t\t\t\t$associate.attr('class', id_ticket_type+'-'+data.data_promo.id_ticket_type_extra+' add-associate-promo');\n\t\t\t\t$associate.find('input[type=text]')\n\t\t\t\t.attr('name','associate_id['+data.data_promo.id_ticket+'][]')\n\t\t\t\t.attr('data-ticket-id', data.data_promo.id_ticket)\n\t\t\t\t.attr('data-ticket-promo', id_ticket_type+'-'+data.data_promo.id_ticket_type_extra);\n\t\t\t\t$associate.find('label.ticket_type_name').text(data.data_promo.ticket_type);\n\t\t\t\t$('#invitation-code-wrap').append($associate);\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\tvar el\t\t= $('#invitation-code-wrap .add-associate-promo').filter('.'+id_ticket_type+'-'+data.data_promo.id_ticket_type_extra);\n\t\t\tvar length\t= el.length;\n\t\t\tfor(counter=length; counter > data.data_promo.qty_ticket_type_extra; counter--)\n\t\t\t{\n\t\t\t\tel.eq((counter-1)).remove();\n\t\t\t}\n\t\t}\n\t} else {\n\t\tvar id_ticket_from_history = $('span', '#history-promo-giveaway').filter('.'+id_ticket_type).attr('data-idextra');\n\t\tvar qty_extra = $('span', '#history-promo-giveaway').filter('.'+id_ticket_type).attr('data-qtyextra');\n\n\t\tvar el\t\t= $('#invitation-code-wrap .add-associate-promo').filter('.'+id_ticket_type+'-'+id_ticket_from_history);\n\t\tvar length\t= el.length;\n\t\t\n\t\tfor(counter=qty_extra; counter > 0; counter--)\n\t\t{\n\t\t\tel.eq((counter-1)).remove();\n\t\t}\n\t\t//update qty to 0\n\t\t$('span', '#history-promo-giveaway').filter('.'+id_ticket_type+'-'+id_ticket_from_history).attr('data-qtyextra', 0);\n\t}\n}\n\nfunction show_invitation_box(ticket_sum)\n{\n\tif(global_is_enable_invitation == true)\n\t{\n\t\tvar latest_invitation_code_input\t= $('.add-coupon', '#invitation-code-wrap').length;\n\n\t\tif(latest_invitation_code_input < ticket_sum)\n\t\t{\n\t\t\tfor(inde=latest_invitation_code_input; inde<ticket_sum; inde++)\n\t\t\t{\n\n\t\t\t\t$.ajaxSetup({ async: false });\n\n\t\t\t\tvar $invitationcodetemplate = $('.add-coupon', '#invitation-code-template').clone();\n\t\t\t\t\n\t\t\t\t$invitationcodetemplate.find('.invitation-code-input').addClass('invitation'+inde);\n\n\t\t\t\tvar $this \t\t\t\t= $invitationcodetemplate.find('.invitation-code-input');\n\t\t\t\tvar $invitation_code \t= $.trim($invitationcodetemplate.find('.invitation-code-input').val());\n\t\t\t\tvar $id_group\t\t\t= $invitationcodetemplate.find('.invitation-code-input').attr('data-idgroup');\n\t\t\t\tvar $id_schedule\t\t= $invitationcodetemplate.find('.invitation-code-input').attr('data-idschedule');\n\n\t\t\t\tif($invitation_code.length > 1 && inde == 0)\n\t\t\t\t{\n\t\t\t\t\t$.post('/ajax_data/check_invitation_code',{'id_group':$id_group, 'id_schedule':$id_schedule,'invitation_code':$invitation_code},function(data)\n\t\t\t\t\t{\n\t\t\t\t\t\t$('.loading', $($this).parent().parent()).hide();\n\t\t\t\t\t\tif (data.error)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t$('.guide', $($this).parent().parent()).show().html(data.message).css('color', '#ff0000');\n\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t$('.check', $($this).parent().parent()).show();\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t}\n\t\t\t\t\t},'json');\n\t\t\t\t}\n\t\t\t\telse {\n\t\t\t\t\t$invitationcodetemplate.find('.invitation-code-input').val('');\n\t\t\t\t}\n\n\t\t\t\t$('#invitation-code-wrap').append($invitationcodetemplate);\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\tfor(inde=latest_invitation_code_input; inde>ticket_sum; inde--)\n\t\t\t{\n\t\t\t\t$('.add-coupon', '#invitation-code-wrap').eq((inde-1)).remove();\n\t\t\t}\n\t\t}\n\n\t\tif(inde == 1)\n\t\t{\n\t\t\t$('#buy_ticket').attr('disabled', false);\n\t\t}\n\t\telse \n\t\t{\n\t\t\t$('#buy_ticket').attr('disabled', true);\n\t\t}\n\n\t\tvar delayinputinvitation = (function(){\n\t\t  var timer = 0;\n\t\t  return function(callback, ms){\n\t\t\tclearTimeout (timer);\n\t\t\ttimer = setTimeout(callback, ms);\n\t\t  };\n\t\t})();\n\n\t\t$('.invitation-code-input').keyup(function(e){\n\t\t\t$('.loading', $(this).parent().parent()).show();\n\t\t\t$('.guide', $(this).parent().parent()).hide();\n\t\t\t$('.check', $(this).parent().parent()).hide();\n\t\t\t$('.custom-message', $(this).parent().parent()).hide();\n\t\t\t$('#buy_ticket').attr('disabled', true);\n\t\t\tvar $this = this;\n\t\t\tdelayinputinvitation(function(){\n\t\t\tvar $invitation_code \t= $.trim($($this).val());\n\t\t\tvar $id_group\t\t\t= $($this).attr('data-idgroup');\n\t\t\tvar $id_schedule\t\t= $($this).attr('data-idschedule');\n\n\t\t\t$.post('/ajax_data/check_invitation_code',{'id_group':$id_group, 'id_schedule':$id_schedule,'invitation_code':$invitation_code},function(data)\n\t\t\t{\n\t\t\t\t\t$('.loading', $($this).parent().parent()).hide();\n\t\t\t\t\tif (data.error)\n\t\t\t\t\t{\n\t\t\t\t\t\t$('.guide', $($this).parent().parent()).show().html(data.message).css('color', '#ff0000');\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tvar indexing = $('.invitation-code-input').index($this);\n\t\t\t\t\t\tvar invitation_code_existing = false;\n\t\t\t\t\t\tfor(ind=0; ind<ticket_sum; ind++){\n\t\t\t\t\t\t\tvar invitation_code_inputed = $.trim($('.invitation-code-input').eq(ind).val());\n\t\t\t\t\t\t\tif(invitation_code_inputed == $invitation_code && indexing!= ind){\n\t\t\t\t\t\t\t\tinvitation_code_existing = true;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tif(invitation_code_existing == true){\n\t\t\t\t\t\t\t$('.custom-message', $($this).parent().parent()).show();\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse{\n\t\t\t\t\t\t\t$('.check', $($this).parent().parent()).show();\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tif(ticket_sum == $('.check:visible', '.add-coupon').length)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t$('#buy_ticket').attr('disabled', false);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t},'json');\n\t\t\t}, 1000 );\n\t\t});\n\n\t}\n}\n\nfunction show_invitation_box_per_invoice($csrf_token = '', $widget_code = '')\n{\n\tif(global_is_enable_invitation == true)\n\t{\t\n\t\t$.ajaxSetup({ async: false });\n\n\t\tvar $this \t\t\t\t= $('#invitation-code')\n\t\tvar $invitation_code \t= $this.val();\n\t\tvar $id_group\t\t\t= $this.attr('data-idgroup');\n\t\tvar $id_schedule\t\t= $this.attr('data-idschedule');\n\n        if (typeof invitationBeforeFunc == 'function') {\n            invitationBeforeFunc();\n        }\n        else\n\t\t{\n            $('#invitation-code-template').show()\n            $('#buy_ticket').attr('disabled', true);\n\t\t}\n\n\t\tif($invitation_code && $invitation_code.length > 1)\n\t\t{\n\t\t\t$.post('/ajax_data/check_invitation_code',{'csrf_token': $csrf_token, 'widget_code': $widget_code, 'id_group':$id_group, 'id_schedule':$id_schedule,'invitation_code':$invitation_code},function(data)\n\t\t\t{\n\t\t\t\t$('.loading', $($this).parent().parent()).hide();\n\t\t\t\tif (data.error)\n\t\t\t\t{\n                    if (typeof invitationErrorFunc == 'function') {\n                        invita