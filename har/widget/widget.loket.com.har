d columns for checkbox & radio options */\n\n(function( $ ) {\n\n    var base = {\n        _get_input_radio : $.loket.loketForm.prototype._get_input_radio,\n        _get_input_checkbox_multiple : $.loket.loketForm.prototype._get_input_checkbox_multiple,\n        _get_input_value_checkbox_multiple : $.loket.loketForm.prototype._get_input_value_checkbox_multiple\n    }\n\n    $.extend(true, $.loket.loketForm.prototype, {\n\n        _get_input_checkbox_multiple : function(field){\n            if(!field.options.columns)\n                return base._get_input_checkbox_multiple.apply(this,arguments);\n            return this._get_input_checkbox_multiple_columns.apply(this,arguments);\n        },\n\n        _get_input_checkbox_multiple_columns : function(field){\n            var self            = this;\n            var $div            = $('<div/>').addClass('input form-group pt-5');\n            var $label          = this._get_label(field);\n            var col_size        = Object.keys(field.options.columns).length;\n            var col_size        = Math.floor(12/col_size);\n            var $input_div      = $('<div/>').addClass('row');\n            $.each(field.options.columns,function(index, column) {\n                var $col_div        = $('<div/>').addClass('col-checkbox col-sm-' + col_size).appendTo($input_div);\n                $.each(column,function(index,option){\n                    var $div_checkbox   = self._get_input_checkbox_multiple_option(field,option);\n                    $col_div.append($div_checkbox);\n                });\n            });\n\n            var $input_box          = $('<span/>').addClass('form-input').append($input_div);\n\n            if(field.other){\n                var $other_div      = $('<div/>').addClass('row').appendTo($input_box);\n                $other_div.append(this._get_input_checkbox_multiple_other(field));\n            }\n\n            $label.append($input_box).appendTo($div);\n            return $div;\n        },\n\n    