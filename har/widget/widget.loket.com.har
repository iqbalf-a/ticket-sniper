            "mimeType": "application/javascript",
            "text": "function countdown_timer(duration, type, widget_code, widget_url, options = {})\n{\n\tvar timer\t\t= duration, hours, minutes, seconds;\n\tvar countdownInterval = setInterval(function ()\n\t{\n\t\thours\t\t\t\t= parseInt(timer / 3600, 10);\n\t\t\n\t\ttimer_remaining\t\t= timer - (hours * 3600);\n\t\tminutes\t\t\t\t= parseInt(timer_remaining / 60, 10);\n\t\tseconds\t\t\t\t= parseInt(timer_remaining % 60, 10);\n\n\t\tif (timer > 0)\n\t\t{\n\t\t\thours\t\t\t\t= hours < 10 ? \"0\" + hours : hours;\n\t\t\tminutes\t\t\t\t= minutes < 10 ? \"0\" + minutes : minutes;\n\t\t\tseconds\t\t\t\t= seconds < 10 ? \"0\" + seconds : seconds;\n\t\t}\n\t\telse\n\t\t{\n\t\t\thours\t\t\t\t= \"00\";\n\t\t\tminutes\t\t\t\t= \"00\";\n\t\t\tseconds\t\t\t\t= \"00\";\n\t\t}\n\n\t\tvar el\t\t\t\t\t= $(\".countdown_timer\").find('span');\n\n\t\t//set hour minutes second\n\t\tif (options.hasOwnProperty('countdown_selector'))\n\t\t{\n\t\t\t$(options.countdown_selector).text(`${minutes}:${seconds}`)\n\t\t} else if (options.hasOwnProperty('payment_countdown_selector')) {\n\t\t\t$(options.payment_countdown_selector.hour).text(hours)\n\t\t\t$(options.payment_countdown_selector.minute).text(minutes)\n\t\t\t$(options.payment_countdown_selector.second).text(seconds)\n\t\t} else {\n\t\t\t$(el[0]).find('b').text(hours);\n\t\t\t$(el[1]).find('b').text(minutes);\n\t\t\t$(el[1]).next().text(seconds);\n\t\t}\n\t\t\n\n\t\ttimer--;\n\n\t\tif (timer <= 120)\n\t\t{\n\t\t\t$(\".countdown_timer\").addClass(\"clock--warning\");\n\t\t}\n\n\t\tif (timer <= 0)\n\t\t{\n\t\t\tconst modal = document.getElementById('modal-timeout')\n\t\t\tconst confirmationOk = document.querySelector('.btn-ok-timeout')\n\t\t\tif (type == \"widget\")\n\t\t\t{\n                clearInterval(countdownInterval);\n\t\t\t\tif ([undefined, null].includes(modal))\n\t\t\t\t{\n\t\t\t\t\talert('Waktu Anda sudah habis.');\n\n\t\t\t\t\t$.post('/widget/reset',{'widget_code':widget_code},function(data)\n\t\t\t\t\t{\n\t\t\t\t\t\tif (data.error == false)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tlocalStorage.removeItem(`ticket_${widget_code}`)\n\t\t\t\t\t\t\tlocalStorage.removeItem(`meta_pixel_tracker_${widget_code}`)\n\t\t\t\t\t\t\turl_redirect = (typeof widget_url == 'undefined') ? data.redirect_url : widget_url;\n\t\t\t\t\t\t\tlocation.href = url_redirect + data.param;\n\t\t\t\t\t\t}\n\t\t\t\t\t},'json');\n\t\t\t\t} else \n\t\t\t\t{\n\t\t\t\t\tmodal.classList.remove('hidden')\n\t\t\t\t\tmodal.classList.add('flex')\n\t\t\t\t\tconfirmationOk.addEventListener('click', function(event) {\n\t\t\t\t\t\t$.post('/widget/reset',{'widget_code':widget_code},function(data)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif (data.error == false)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlocalStorage.removeItem(`ticket_${widget_code}`)\n\t\t\t\t\t\t\t\tlocalStorage.removeItem(`meta_pixel_tracker_${widget_code}`)\n\t\t\t\t\t\t\t\turl_redirect = (typeof widget_url == 'undefined') ? data.redirect_url : widget_url;\n\t\t\t\t\t\t\t\tlocation.href = url_redirect + data.param;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t},'json');\t\n\t\t\t\t\t})\n\t\t\t\t}\n\t\t\n\t\t\t}\n\t\t\telse if (type == \"payment\")\n\t\t\t{\n\t\t\t\ttimer = 0;\n\t\t\t\tif (typeof widget_code !='undefined' && widget_code!='')\n\t\t\t\t{\n\t\t\t\t\tclearInterval(countdownInterval);\n\t\t\t\t\tif ([undefined, null].includes(modal))\n\t\t\t\t\t{\n\t\t\t\t\t\talert('Waktu Pembayaran Anda sudah habis.');\n\n\t\t\t\t\t\t$.post('/widget/reset',{'widget_code':widget_code, payment: true},function(data)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif (data.error == false)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tlocalStorage.removeItem(`ticket_${widget_code}`)\n\t\t\t\t\t\t\t\turl_redirect = (typeof widget_url == 'undefined') ? data.redirect_url : widget_url;\n\t\t\t\t\t\t\t\tlocation.href = url_redirect + data.param;\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t},'json');\n\t\t\t\t\t} else \n\t\t\t\t\t{\n\t\t\t\t\t\tmodal.classList.remove('hidden')\n\t\t\t\t\t\tmodal.classList.add('flex')\t\n\t\t\t\t\t\tconfirmationOk.addEventListener('click', function () {\n\t\t\t\t\t\t\t$.post('/widget/reset',{'widget_code':widget_code, payment: true},function(data)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif (data.error == false)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tlocalStorage.removeItem(`ticket_${widget_code}`)\n\t\t\t\t\t\t\t\t\turl_redirect = (typeof widget_url == 'undefined') ? data.redirect_url : widget_url;\n\t\t\t\t\t\t\t\t\tlocation.href = url_redirect + data.param;\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t},'json');\t\n\t\t\t\t\t\t})\n\t\t\t\t\t}\n                    \n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}, 1000);\n}\n\nfunction countdown_timer_full_booked(duration, type, widget_code, whichclass)\n{\n\tvar timer\t\t= duration, hours, minutes, seconds;\n\tvar counterInterval = setInterval(function ()\n\t{\n\t\thours\t\t\t\t= parseInt(timer / 3600, 10);\n\t\t\n\t\ttimer_remaining\t\t= timer - (hours * 3600);\n\t\tminutes\t\t\t\t= parseInt(timer_remaining / 60, 10);\n\t\tseconds\t\t\t\t= parseInt(timer_remaining % 60, 10);\n\n\t\tif (timer > 0)\n\t\t{\n\t\t\thours\t\t\t\t= hours < 10 ? \"0\" + hours : hours;\n\t\t\tminutes\t\t\t\t= minutes < 10 ? \"0\" + minutes : minutes;\n\t\t\tseconds\t\t\t\t= seconds < 10 ? \"0\" + seconds : seconds;\n\t\t}\n\t\telse\n\t\t{\n\t\t\thours\t\t\t\t= \"00\";\n\t\t\tminutes\t\t\t\t= \"00\";\n\t\t\tseconds\t\t\t\t= \"00\";\n\t\t}\n\n\t\t$(\".countdown_timer_full_booked\"+whichclass).html(\"<span><b>\"+hours+\"</b><sup>Jam</sup></span><span><b>\"+minutes+\"</b><sup>Menit</sup></span><b>\"+seconds+\"</b><sup>Detik</sup></span>\");\n\n\t\ttimer--;\n\n\t\tif (timer <= 120)\n\t\t{\n\t\t\t$(\".countdown_timer_full_booked\"+whichclass).addClass(\"clock--warning\");\n\t\t}\n\n\t\tif (timer <= 0)\n\t\t{\n\t\t\tif (type == \"widget\")\n\t\t\t{\n                clearInterval(counterInterval);\n\t\t\t\talert('Waktu Anda sudah habis.');\n\n\t\t\t\t$.post('/widget/reset',{'widget_code':widget_code},function(data)\n\t\t\t\t{\n\t\t\t\t\tif (data.error == false)\n\t\t\t\t\t{\n\t\t\t\t\t\tlocalStorage.removeItem(`ticket_${widget_code}`)\n\t\t\t\t\t\tlocation.href = data.redirect_url;\n\t\t\t\t\t}\n\t\t\t\t},'json');\n\t\t\t}\n\t\t\telse if (type == \"payment\")\n\t\t\t{\n\t\t\t\ttimer = 0;\n\t\t\t}\n\t\t}\n\t}, 1000);\n}\n\nfunction getAddons()\n{\n\tlet checkboxAddons = $('.checkbox_addon:checked')\n\t.map(function(){\n\t\treturn {['ticket_addons[' + $(this).data('id_ticket')+']'] : $(this).val()};\n\t})\n\t.get()\n\t.reduce((prev, current)  => Object.assign(prev, current), {});\n\t\n\tlet textboxAddons = $('.textbox_addon')\n\t.map(function(){\n\t\tif ($(this).val() > 0)\n\t\t\treturn {['ticket_addons['+$(this).data('id_ticket')+']'] : $(this).val()};\n\t})\n\t.get()\n\t.reduce((prev, current)  => Object.assign(prev, current), {});\n\n\treturn Object.assign({}, checkboxAddons, textboxAddons);\n}\n\nfunction disabledCoupon() \n{\n\t$('#coupon_code').attr('readonly', true);\n\t$('#coupon_code_btn').attr('disabled', true);\n}\n\nfunction enableCoupon()\n{\n\t$('#coupon_code').removeAttr('readonly');\n\t$('#coupon_code_btn').removeAttr('disabled');\n}\n\nfunction calculate_payment(csrf_token = '')\n{\n\twidget_code\t\t\t\t= $('input:hidden[name=\"widget_code\"]').val();\n\tid_list_payment\t\t\t= $('input:radio[name=\"id_list_payment\"]:checked').val();\n\tid_loket_installment \t= $('input:radio[name=\"id_loket_installment\"]:checked').val();\n\tlet event_name\t\t\t= $(\"#event_name\").val();\n\tlet payment_method \t\t= $(`#payment_name_${id_list_payment}`).val()\n\tlet add_ons = getAddons()\n\tlet dataLayerObj \t\t= {\n\t\tevent : 'generalEvent',\n\t\tevent_category:'Event Order Flow',        \n\t\tevent_action:'Select Payment Method',\n\t\tevent_label : `${event_name}`,\n\t\tpayment_method: payment_method,\n\t\tuser_id: ''\n\t}\n\tdisabledCoupon()\n\twindow.dataLayer.push(dataLayerObj)\n\t$('#pay_info').fadeOut('fast');\n\t\n\tif (typeof id_loket_installment != 'undefined') {\n\t\tcalculate_installment();\n\t}\n\telse {\n\t\tlet param = {'widget_code':widget_code, 'id_list_payment':id_list_payment, 'csrf_token':csrf_token};\n\t\tparam = {...param, ...add_ons};\n\t\t$.post('/widget/calculate', param ,function(data)\n\t\t{\n\t\t\tif (data.error)\n\t\t\t{\n\t\t\t\t$('#id_list_payment_alert').html(data.message);\n\t\t\t\tif (data.redirect_url != undefined)\n\t\t\t\t\twindow.location = data.redirect_url;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tenableCoupon()\n\t\t\t\tif (data.payment_info != '')\n\t\t\t\t{\n\t\t\t\t\t$('#pay_info').fadeIn('fast');\n\t\t\t\t\t$('#info_text').html(data.payment_info);\n\t\t\t\t}\n\n\t\t\t\tif (data.limit_va && (id_list_payment==18)) {\n\t\t\t\t\t$('#convenience_fee').html(data.lang_fee).attr('data-payment-term', data.payment_term);\n\t\t\t\t\t$('.limit_va_permata').remove();\n\t\t\t\t\t$('#error_va_permata').remove();\n\t\t\t\t\tvar info_va = '\\\n\t\t\t\t\t\t<div class=\"alert alert--red limit_va_permata\" style=\"text-align:center;\">\\\n\t\t\t\t\t\t\t' + data.lang_info_va + '\\\n\t\t\t\t\t\t</div>\\\n\t\t\t\t\t';\n\t\t\t\t\t$(info_va).insertBefore('div.form');\n\n\t\t\t\t\t\tvar error_va = '\\\n\t\t\t\t\t\t\t<div id=\"error_va_permata\" class=\"alert alert--red\" style=\"text-align:center;\">\\\n\t\t\t\t\t\t\t\tOnly payment method ATM Transfer are allowed \\\n\t\t\t\t\t\t\t\tif your order value more than IDR 10 Million\\\n\t\t\t\t\t\t\t</div>\\\n\t\t\t\t\t\t';\n\t\t\t\t\t\t$('#error_va_permata').remove();\n\t\t\t\t\t\t$('#btn-submit').removeAttr('disabled');\n\t\t\t\t}\n\t\t\t\telse{\n\t\t\t\t\tis_visible_limit_va_permata = $('.limit_va_permata').is(':visible');\n\t\t\t\t\tif(is_visible_limit_va_permata == true){\n\t\t\t\t\t\t$('.limit_va_permata').remove();\n\t\t\t\t\t}\n\t\t\t\t\t$('#convenience_fee').html(data.lang_fee);\n\t\t\t\t}\n\n\t\t\t\t//Promo discount\n\t\t\t\t$('#tr-discount-promotion').remove();\n\t\t\t\tif (data.promotion_discount) {\n\t\t\t\t\tvar promotion_discount \t= '\\\n\t\t\t\t\t\t<tr id=\"tr-discount-promotion\">\\\n\t\t\t\t\t\t\t<td colspan=\"4\">' + data.lang_discount + '</td>\\\n\t\t\t\t\t\t\t<td class=\"alert--green\" style=\"text-align:right;white-space:nowrap;\">\\\n\t\t\t\t\t\t\t\t<span>\\\n\t\t\t\t\t\t\t\t\t' + data.discount + '\\\n\t\t\t\t\t\t\t\t</span>\\\n\t\t\t\t\t\t\t</td>\\\n\t\t\t\t\t\t</tr>\\\n\t\t\t\t\t';\n\t\t\t\t\t$(promotion_discount).insertBefore('.tr-grand-total');\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t//Promo\n\t\t\t\t$('.tr-promo').remove();\n\t\t\t\tif ((data.result_promo) && (data.result_promo.total_free_ticket > 0)) {\t\n\t\t\t\t\t$.each(data.result_promo.data_promo, function(k, v) {\n\t\t\t\t\t\tvar promo \t= '\\\n\t\t\t\t\t\t\t<tr class=\"tr-promo\">\\\n\t\t\t\t\t\t\t\t<td colspan=\"2\">' + data.lang_free_ticket + v.ticket_type + '</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">'+data.currency_code+' 0</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;\">' + v.qty_ticket_type_extra + '</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">'+data.currency_code+' 0</td>\\\n\t\t\t\t\t\t\t</tr>\\\n\t\t\t\t\t\t';\n\t\t\t\t\t\t$(promo).insertBefore('#free-ticket');\n\t\t\t\t\t});\n\t\t\t\t}\n\n\t\t\t\t//Addon\n\t\t\t\t$('.tr-addon').remove();\n\t\t\t\tif(data.addon){\n\t\t\t\t\t$.each(data.addon.detail, function(k, v) {\n\t\t\t\t\t\tvar addon \t= '\\\n\t\t\t\t\t\t\t<tr class=\"tr-addon\">\\\n\t\t\t\t\t\t\t\t<td colspan=\"4\">' + v.desc + '</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">'+v.price+'</td>\\\n\t\t\t\t\t\t';\n\t\t\t\t\t\t$(addon).insertBefore('#free-ticket');\n\t\t\t\t\t});\n\t\t\t\t}\n\n\t\t\t\tif (data.result_promo) {\t\n\t\t\t\t\t$('b', '#grand-total-qty').html(data.result_promo.total_ticket_qty);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t$('.invoice_fee').html(data.fee);\n\t\t\t\t$('.invoice_tax').html(data.tax);\n\t\t\t\t$('.invoice_grand_total').html(data.grand_total);\n\n\t\t\t\t$('#id_list_payment_alert').hide();\n\t\t\t\t$('#installment_fee').remove();\n\t\t\t\t$('#installment_payment').remove();\n\n\t\t\t\ttoggleFormKlikBCA(id_list_payment, data.lang_klikbca, 'User ID KlikBCA');\n\t\t\t\ttoggleFormWallet(id_list_payment, data.doku_data);\n\t\t\t}\n\t\t},'json');\n\t}\n}\n\nfunction toggleFormKlikBCA(id_list_payment, lang_text) {\n\tvar formKlikBCA = '\\\n\t\t<div class=\"row\">\\\n\t\t<div class=\"col grid-6\">\\\n\t\t<p><b>' +lang_text+ '</b></p>\\\n\t\t<input type=\"text\" name=\"id_user_klikbca\" id=\"id_user_klikbca\" placeholder=\"User ID KlikBCA\" class=\"form-control\" style=\"margin-top:5px;\" autocomplete=\"off\" required /> \\\n\t\t</div>\\\n\t\t</div>\\\n\t';\n\tvar divKlikBCA = $('#div-klikbca');\n\tif (divKlikBCA.length < 1) {\n\t\tconsole.error(\"Div KlikBCA not found\");\n\t\talert('An error occurred, please choose other payment method or contact customer services');\n\t}\n\n\t// If faspay klikbca\n\tif (id_list_payment == 38) {\n\t\tdivKlikBCA.html(formKlikBCA).fadeIn();\n\t}\n\t// If veritrans klikbca\n\telse if (id_list_payment == 50) {\n\t\tdivKlikBCA.html(formKlikBCA).fadeIn();\n\t}\n\telse {\n\t\tdivKlikBCA.html('').hide();\n\t}\n}\n\nfunction get_installment_info () {\n\tid_loket_installment \t= $('input:radio[name=\"id_loket_installment\"]:checked').val();\n\t$.post('/widget/installment_info', {'id_loket_installment': id_loket_installment}, function (data) {\n\t\tif (data.installment_info != '')\n\t\t{\n\t\t\t$('#installment_info').fadeIn('fast');\n\t\t\t$('#installment_info_text').html(data.installment_info);\n\t\t}\n\t\telse {\n\t\t\t$('#installment_info').fadeOut('fast');\n\t\t\t$('#installment_info_text').html('');\n\t\t}\n\t}, 'json');\n}\n\nfunction calculate_installment(csrf_token = '')\n{\n\twidget_code\t\t\t= $('input:hidden[name=\"widget_code\"]').val();\n\tid_list_payment\t\t= $('input:radio[name=\"id_list_payment\"]:checked').val();\n\tid_loket_installment \t= $('input:radio[name=\"id_loket_installment\"]:checked').val();\n\n\tif (typeof id_loket_installment != 'undefined' && typeof id_list_payment != 'undefined') {\n\n\t\t$.post('/widget/calculate',{'widget_code':widget_code, 'id_list_payment':id_list_payment, 'id_loket_installment':id_loket_installment,'csrf_token':csrf_token},function(data)\n\t\t{\n\t\t\tif (data.error)\n\t\t\t{\n\t\t\t\t$('#installment_alert').html(data.message).fadeIn('fast');\n\t\t\t\t$('#btn-submit').attr('disabled', 'disabled');\n\t\t\t\tif (data.redirect_url != undefined)\n\t\t\t\t\twindow.location = data.redirect_url;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tif (data.payment_info != '')\n\t\t\t\t{\n\t\t\t\t\t$('#pay_info').fadeIn('fast');\n\t\t\t\t\t$('#info_text').html(data.payment_info);\n\t\t\t\t}\n\n\t\t\t\t$('.invoice_fee').html(data.fee);\n\t\t\t\t$('.invoice_tax').html(data.tax);\n\t\t\t\t$('.invoice_grand_total').html(data.grand_total);\n\t\t\t\t$('#installment_alert').hide();\n\t\t\t\t$('#id_list_payment_alert').hide();\n\t\t\t\t$('#btn-submit').removeAttr('disabled');\n\t\t\t\t$('#grand-total-qty').text('');\n\n\t\t\t\t//Promo\n\t\t\t\t$('.tr-promo').remove();\n\t\t\t\tif (data.result_promo.get_extra) {\t\n\t\t\t\t\t$.each(data.result_promo.data_promo, function(k, v) {\n\t\t\t\t\t\tvar promo \t= '\\\n\t\t\t\t\t\t\t<tr class=\"tr-promo\">\\\n\t\t\t\t\t\t\t\t<td colspan=\"2\">'+data.lang_free_ticket + v.ticket_type + '</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">Rp. 0</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;\">' + v.qty + '</td>\\\n\t\t\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">Rp. 0</td>\\\n\t\t\t\t\t\t\t</tr>\\\n\t\t\t\t\t\t';\n\t\t\t\t\t\t$(promo).insertBefore('#free-ticket');\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\t$('b', '#grand-total-qty').html(data.result_promo.total_ticket_qty);\n\t\t\t\t\n\t\t\t\tvar installment_fee \t= '\\\n\t\t\t\t\t<tr id=\"installment_fee\">\\\n\t\t\t\t\t\t<td colspan=\"4\">' + data.lang_installment_fee + '</td>\\\n\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">\\\n\t\t\t\t\t\t\t<span>\\\n\t\t\t\t\t\t\t\t' + data.installment_fee + '\\\n\t\t\t\t\t\t\t</span>\\\n\t\t\t\t\t\t</td>\\\n\t\t\t\t\t</tr>\\\n\t\t\t\t';\n\t\t\t\tvar installment_payment \t= '\\\n\t\t\t\t\t<tr id=\"installment_payment\">\\\n\t\t\t\t\t\t<td colspan=\"4\">' + data.lang_installment_payment + '</td>\\\n\t\t\t\t\t\t<td style=\"text-align:right;white-space:nowrap;\">\\\n\t\t\t\t\t\t\t<span>\\\n\t\t\t\t\t\t\t\t' + data.installment_payment + '\\\n\t\t\t\t\t\t\t</span>\\\n\t\t\t\t\t\t</td>\\\n\t\t\t\t\t</tr>\\\n\t\t\t\t';\n\t\t\t\t$('#installment_fee').remove();\n\t\t\t\t$(installment_fee).insertBefore('.tr-grand-total');\n\t\t\t\t$('#installment_payment').remove();\n\t\t\t\t$(installment_payment).insertBefore('.tr-grand-total');\n\t\t\t}\n\t\t},'json');\n\t}\n}\n\nfunction save_billing_address(id_invoice, token, id_creditcard, cb = null)\n{\n    token = typeof token != 'undefined' ? token : false;\n\tvar bill_error\t= 0;\n\tvar card_number\t= '';\n    var event_id\t= $('#id_event').val();             \n\n\ttoken_id \t\t\t= $('input[name=default_cc]:checked').attr('token-id');\n\n\tcard_number\t\t\t= $(\"#card-number\").val();\n\tcard_cvv\t\t\t= $(\"#card-cvv\").val();\n\tif (token != false)\n\t{\n\t\tcard_cvv\t\t\t= $(\"input[name=cvv]\").val();\n\t}\n\t\n\tcard_expired_month\t= $(\"#card-expiry-month\").val();\n\tcard_expired_year\t= $(\"#card-expiry-year\").val();\n\tbin_number\t\t\t= $(\"#bin-number\").val();\n\tbill_firstname\t\t= $(\"input[name=bill_firstname]\").val();\n\tbill_lastname\t\t= $(\"input[name=bill_lastname]\").val();\n\tbill_address\t\t= 'customer loket address';\n    bill_postalcode\t\t= 'postalcode';\n\tbill_telephone\t\t= 'telephone';\n\tbill_countrycode\t= 'IDN';\n\tbill_city\t\t\t= 'city';\n\n\t// reset all\n\t$(\".form_group_card\").removeClass('form-group--error');\n\t$(\".error_card\").html('');\n\n\t$(\".form_group_bill\").removeClass('form-group--error');\n\t$(\".error_bill\").html('');\n\n\tif (token == false)\n\t{\n\t\t// checking card\n\t\tif (card_number.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_card_number\").addClass('form-group--error');\n\t\t\t$(\".error_card_number\").html(get_error_notif(['Card Number','Nomor Kartu']));\n\t\t}\n\t\telse {\n\t\t\tif (!valid_credit_card(card_number) && token == false) {\n\t\t\t\tbill_error++;\n\t\t\t\t$(\".form_group_card_number\").addClass('form-group--error');\n\t\t\t\t$(\".error_card_number\").html('The Card Number not valid.');\n\t\t\t}\n\t\t}\n\n\t\tif (card_cvv.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_card_cvv\").addClass('form-group--error');\n\t\t\t$(\".error_card_cvv\").html(get_error_notif(['CVV','CVV']));\n\t\t}\n\n\t\tif (card_expired_month.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_card_expired_month\").addClass('form-group--error');\n\t\t\t$(\".error_card_expired_month\").html(get_error_notif(['Expiration Month','Bulan Kadaluarsa']));\n\t\t}\n\n\t\tif (card_expired_year.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_card_expired_year\").addClass('form-group--error');\n\t\t\t$(\".error_card_expired_year\").html(get_error_notif(['Expiration Year','Tahun Kadaluarsa']));\n\t\t}\n\n\t\t// checking billing\n\t\tif (bill_firstname.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_bill_firstname\").addClass('form-group--error');\n\t\t\t$(\".error_bill_firstname\").html(get_error_notif(['Firstname','Nama Depan']));\n\t\t}\n\n\t\tif (bill_lastname.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_bill_lastname\").addClass('form-group--error');\n\t\t\t$(\".error_bill_lastname\").html(get_error_notif(['Lastname','Nama Belakang']));\n\t\t}\n\t\tif ($('#error_message').hasClass('widget-new')) \n\t\t{\n\t\t\twindow.setLoading(false)\n\t\t}\t\t\t\n\t}\n\n\tif (typeof bin_number != 'undefined') {\n\t\tif (bin_number.length == 0) {\n\t\t\tbill_error++;\n\t\t\t$(\".form_group_card_number\").addClass('form-group--error');\n\t\t\t$(\".error_card_number\").html(get_error_notif(['Card Number','Nomor Kartu']));\n\t\t}\n\t\telse {\n\t\t\tlet {error, message} = check_bin_number(id_invoice, bin_number, card_number, token_id);\n\t\t\tif (!error) {\n\t\t\t\tbill_error++;\n\t\t\t\tif ($('#error_message').hasClass('widget-new')) \n\t\t\t\t{\n\t\t\t\t\twindow.createToast(message)\n\t\t\t\t} else \n\t\t\t\t{\n\t\t\t\t\t$(\"#error_message\").html(get_alert_notif('The Credit Card you have entered does not participate in the current promotion.', 'Kartu kredit yang anda masukkan tidak termasuk dalam promosi ini.')).show();\n\t\t\t\t}\t\t\n\t\t\t}\n\n\t\t}\n\t}\n\n\t// save to db\n\tif (bill_error == 0)\n\t{\n\t\t$.post('/ajax_data/save_billing_info', {'id_invoice':id_invoice, 'id_creditcard' : id_creditcard, 'bill_firstname':bill_firstname, 'bill_lastname':bill_lastname, 'bill_telephone':bill_telephone, 'bill_address':bill_address, 'bill_countrycode':bill_countrycode, 'bill_city':bill_city, 'bill_postalcode':bill_postalcode}, function(data)\n\t\t{\n\t\t\tif (data.error)\n\t\t\t{\n\t\t\t\tif (cb != null)\n\t\t\t\t\tcb(false)\n\t\t\t\treturn false;\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tif (cb != null)\n\t\t\t\t\tcb(true)\n\t\t\t\treturn true;\n\t\t\t}\n\t\t},'json');\n\t}\n\telse\n\t{\n\t\tif (cb != null)\n\t\t\tcb(false)\n\t\treturn false;\n\t}\n}\n\nfunction get_error_notif(field)\n{\n\tlang = get_cookie('option_language');\n\tif (typeof lang =='undefined' || lang == 'ind')\n\t{\n\t\tstring = 'Kolom '+field[1]+' wajib diisi.';\t\n\t}\n\telse\n\t{\n\t\tstring = 'The '+field[0]+' field is required.';\n\t}\n\treturn string;\n}\n\nfunction get_alert_notif(lang_eng, lang_ind)\n{\n\tlang = get_cookie('option_language');\n\tif (typeof lang =='undefined' || lang == 'ind')\n\t{\n\t\tstring = lang_ind;\n\t}\n\telse\n\t{\n\t\tstring = lang_eng;\n\t}\n\treturn string;\n}\n\nfunction check_bin_number(id_invoice, bin_number, card_number, token_id)\n{\n\t//async method\n\tvar returns = false;\n\tvar message = ''\n\t$.ajax({\n\t  type\t\t: 'POST',\n\t  async\t\t: false,\n\t  datatype\t:'json',\n\t  url\t\t: \"/ajax_data/check_bin_number\",\n\t  data\t\t: {bin_number:bin_number,id_invoice:id_invoice},\n\t  success\t: function(data) \n\t  {\n\t\tdocument.querySelectorAll('#submit-button')\n                .forEach(item => {\n                    $(item).removeAttr('disabled');\n                });\n\t  \tif(data.error)\n\t\t{\n\t\t\tconsole.log(data)\n\t\t\treturns = false;\n\t\t\tmessage = data.text\n\t\t}\n\t\telse\n\t\t{\n\t\t\tif (typeof token_id != 'undefined' && token_id != '') {\n\t\t\t\tif (bin_number == token_id.slice(0,bin_number.length))\n\t\t\t\t\treturns = true;\n\t\t\t\telse\n\t\t\t\t\treturns = false;\n\t\t\t}\n\t\t\telse if (card_number != '') {\n\t\t\t\tif (bin_number == card_number.slice(0,bin_number.length))\n\t\t\t\t\treturns = true;\n\t\t\t\telse\n\t\t\t\t\treturns = false;\n\t\t\t}\n\t\t\telse {\n\t\t\t\treturns = false;\n\t\t\t}\n\t\t}\n\t  }\n\t});\n\n\treturn {\n\t\terror: returns,\n\t\tmessage: message\n\t}\n}\n\nfunction valid_credit_card(value)\n{\n\t// accept only digits, dashes or spaces\n\tif (/[^0-9-\\s]+/.test(value)) return false;\n\n\t// The Luhn Algorithm. It's so pretty.\n\tvar nCheck = 0, nDigit = 0, bEven = false;\n\tvalue = value.replace(/\\D/g, \"\");\n\n\tfor (var n = value.length - 1; n >= 0; n--)\n\t{\n\t\tvar cDigit = value.charAt(n),\n\t\t\t  nDigit = parseInt(cDigit, 10);\n\n\t\tif (bEven)\n\t\t{\n\t\t\tif ((nDigit *= 2) > 9) nDigit -= 9;\n\t\t}\n\n\t\tnCheck += nDigit;\n\t\tbEven = !bEven;\n\t}\n\n\treturn (nCheck % 10) == 0;\n}\n\nfunction resend_confirmation(email)\n{\n\t$.post('/ajax_data/resend_member_confirmation',{'email':email},function(data)\n\t{\n\t\t$('.alert').removeClass(\"alert--red\");\n\t\t$('.alert').addClass(\"alert--green\");\n\t\t$('.alert').html(data.message);\n\t},'json');\n}\n\nfunction get_geolocation()\n{\n\t$.get('/ajax_data/geolocation', function(data){\n\t\tconsole.log(data)\n\t});\n}\n\nfunction getParameterByName(name, url) \n{\n    if (!url) url = window.location.href;\n    name = name.replace(/[\\[\\]]/g, \"\\\\$&\");\n    var regex = new RegExp(\"[?&]\" + name + \"(=([^&#]*)|&|#|$)\"),\n        results = regex.exec(url);\n    if (!results) return null;\n    if (!results[2]) return '';\n    return decodeURIComponent(results[2].replace(/\\+/g, \" \"));\n}\n\nfunction check_cookie_white_label(domain, expires)\n{\n\twidget_code = get_cookie('widget_code');\n\twhite_label = get_cookie('white_label_'+ widget_code);\n\t\n\tif (top != self) {\n\t\tif (white_label == 'off') {\n\t\t\tset_cookie('white_label_'+ widget_code, 'on', domain, expires);\n\t\t\tlocation.reload();\n\t\t}\n\t}\n\telse {\n\t\tparam_white_label = getParameterByName('white_label');\n\t\tif (white_label == 'on' && param_white_label != 'true') {\n\t\t\t //set_cookie('white_label_'+ widget_code, 'off', domain, expires);\n\t\t\t //location.reload();\n\t\t}\n\t}\n}\n\nfunction formatToLocaleDateString(timestamp, locale = 'id-ID', includeDayName = false, separator = ' ') {\n    let date = new Date(timestamp * 1000);\n\n    let dayName = includeDayName ? date.toLocaleDateString(locale, { weekday: 'long' }) + \", \" : \"\";\n    let day = date.toLocaleDateString(locale, { day: '2-digit' });\n    let month = date.toLocaleDateString(locale, { month: 'short' });\n    let year = date.toLocaleDateString(locale, { year: 'numeric' });\n\n    let formattedDate = `${dayName}${day} ${month} ${year}`;\n\n    let hours = date.getHours().toString().padStart(2, '0');\n    let minutes = date.getMinutes().toString().padStart(2, '0');\n    let formattedTime = `${hours}:${minutes}`;\n\n    return `${formattedDate}${separator}${formattedTime}`;\n}\n\nfunction update_meta_pixel_tracker(storageKey, eventName, parsedData, payload) {\n\tconst foundIndex = parsedData.findIndex(item => item.event === eventName);\n\tif (foundIndex === -1) {\n\t\tlocalStorage.setItem(storageKey, JSON.stringify([...parsedData, payload]));\n\t} else {\n\t\tparsedData[foundIndex] = payload;\n\t\tlocalStorage.setItem(storageKey, JSON.stringify(parsedData));\n\t}\n}\n\n//Widget Payment Method Installment\n$(document).ready(function() {\n\tvar div_installment = $('.div-installment');\n\tvar div_payment = $('.div-payment');\n\t$('#installment_pay_method').on('click', function(){\n\t\tdiv_payment.hide();\n\t\t$('#full_payment').prop('checked', false);\n\t\t$('.installment_pay_method').hide();\n\t\t$('input[name=id_loket_installment]').prop('checked', false).attr('required', true);\n\t\t$('input[name=id_list_payment]').prop('checked', false);\n\t\t$('.invoice_fee').text('Rp. 0');\n\t\t$('.invoice_grand_total').text('Rp. 0');\n\t\ttoggle_payment_installment(true);\n\t\tdiv_installment.show();\n\t\tdiv_payment.toggle('slide', {direction: 'right'})\n\t});\n\t$('#full_payment').on('click', function(){\n\t\tdiv_payment.hide();\n\t\t$('#installment_pay_method').prop('checked', false);\n\t\t$('.installment_pay_method').show()\n\t\t$('input[name=id_loket_installment]').prop('checked', false).attr('required', false);\n\t\t$('input[name=id_list_payment]').prop('checked', false);\n\t\t$('#installment_fee').remove();\n\t\t$('#installment_payment').remove();\n\t\t$('.invoice_fee').text('Rp. 0');\n\t\t$('.invoice_grand_total').text('Rp. 0');\n\t\ttoggle_payment_installment(false);\n\t\tdiv_installment.hide();\n\t\tdiv_payment.toggle('slide', {direction: 'left'})\n\t});\n\t\n\tfunction toggle_payment_installment(installment) {\n\t\tvar radio_payment = $('input[name=id_list_payment]'),\n\t\t\tdiv_radio = radio_payment.closest('.select-payment__radio');\n\t\tif (installment === true) {\n\t\t\tdiv_radio.hide();\n\t\t\tradio_payment.not('#payment_6, #payment_18').attr('disabled', true);\n\t\t\t$('#payment_6, #payment_18').closest('.select-payment__radio').show()\n\t\t}\n\t\telse {\n\t\t\tdiv_radio.show();\n\t\t\tradio_payment.removeAttr('disabled', true);\n\t\t}\n\t}\n});\n"
