          "content": {
            "size": 76046,
            "mimeType": "application/javascript",
            "text": "(function( $ ) {\n        $.widget(\"loket.loketWizard\", {\n            options             : {\n                first       : {title:'First',click:function(){}},\n                finish      : {title:'Finish',class:'btn-blue',click:function(){}},\n                encode      : true,\n                async       : true,\n                action_save : null,\n            },\n            $container          : null,\n            $steps              : null,\n            $content            : null,\n            $buttons            : null,\n            $button_prev        : null,\n            $button_next        : null,\n            $button_first       : null,\n            $button_finish      : null,\n            _current_step       : null,\n            _total_step         : 0,\n            parent              : null,\n            sliding             : false,\n            next_slide          : null,\n            prev_slide          : null,\n            first_submit        : true,\n            _create             : function(){\n                if(this.options.source){\n                    var options = this._get_source();\n                    $.extend(true, this.options, options);                    \n                }\n                this._create_container();\n            },\n            _create_container_new: function () {\n                this.element.addClass('loket_wizard_main form-wrapper');\n                this.$container = $('<div/>').addClass('loket_wizard').appendTo(this.element);\n                this._create_content();\n                this._create_accordion();\n                if(this.options.records){\n                    this.set_records(this.options.records);\n                }\n                this._retrigger_accordion()\n            },\n            _create_container   : function(){\n                this.element.addClass('loket_wizard_main');\n                this.$container = $('<div/>').addClass('loket_wizard').appendTo(this.element);\n                this._create_steps();\n                this._create_content();\n                this._create_buttons();\n                this._fill_content();\n                this.select_by_index(0);\n                this._init_custom_form_merika();\n                if(this.options.parent){\n                    this.parent = this.options.parent;\n                }\n                if(this.options.records){\n                    this.set_records(this.options.records);\n                }\n            },\n            _init_custom_form_merika : function() {\n                $('input[name=loket_form_other_industry_type]').hide();\n\n                $('input[name=loket_form_industry_type]').on('click', function(){\n                    if ($(this).val() == 'Lainnya') {\n                        $('input[name=loket_form_other_industry_type]').show();\n                        $('input[name=loket_form_other_industry_type]').attr('required', true);\n                    }\n                    else {\n                        $('input[name=loket_form_other_industry_type]').hide();\n                        $('input[name=loket_form_other_industry_type]').removeAttr('required');\n                    }\n                });\n            },\n            _get_source : function(){\n                var params = {};\n                var source_url  = this.options.source + '?loketwizard_action=get_source';\n                if(this.options.session_name){\n                    source_url  = source_url + '&loketwizard_session_name=' + this.options.session_name;\n                }\n                $.ajax({\n                      url: source_url,\n                      type: \"GET\",\n                      async: false,\n                      success: function(data) {\n                        params = JSON.parse(data);\n                      }\n                });\n                return params;\n            },     \n            _create_accordion() {\n                const self = this\n                const wrapper = $('<section/>').addClass('accordion')\n                let sequence = 0;\n                $.each(self.options.steps, function (index, step) {\n                    const header = ` <div class=\"accordion__header ${sequence == 0 ? 'is-active' : ''}\">\n                                        <div class=\"flex\">\n                                            <div class=\"rectangle\"></div>\n                                            <h5 class=\"text-lg font-semibold mr-2\" style=\"color: #152955\"> ${step.title} </h5>\n                                        </div>\n                                        <span class=\"accordion__toggle\"></span>\n                                    </div>`;\n                    const content = self._create_step_contents(step);\n                    const body = $('<div />').addClass(`accordion__body ${sequence == 0 ? 'is-active' : ''}`)\n                    $(content).appendTo(body)\n                    $(header).appendTo(wrapper)\n                    $(body).appendTo(wrapper)\n                    sequence++;\n                })\n                self.$content.append(wrapper)\n            },\n            _create_steps       : function(){\n                var self        = this;\n                var $div        = $('<div/>').addClass('row');\n                var $div_step   = $('<div/>').addClass('btn-group btn-group-justified cf-btn-group');\n                var i           = 0; \n                $.each(this.options.steps,function(index,step){\n                    step.index          = i;\n                    step.name           = index;\n                    step.element        = self._create_step(step).appendTo($div_step);\n                    step.content_div    = self._create_step_contents(step);\n                    i++;\n                });\n                this._total_step = i;\n                this.$steps = $div.append($div_step).appendTo(this.$container);\n            },\n            _create_step        : function(step){\n                var self        = this;\n                var count_steps = this.options.steps.length;\n                var width       = 100/(count_steps>5?5:count_steps);\n                var $div        = $(\"<div/>\").addClass('btn-group').attr('role','group')\n                                    .css('cursor','pointer')\n                                    .data('step',step)\n                                    .append(\"<b></b>\")\n                                    .append(\"<a role='button' class='btn btn-default btn-sm'>\" + step.title + \"</span>\");\n                 $div.click(function(){\n                    var step    = $(this).data('step');\n                    self.select_by_index(step.index);\n                 });\n                 if(step.index>4){\n                    $div.hide();\n                 }                   \n                return $div;                    \n            },\n            _slide_next : function(index){\n                var self        = this;\n                var i           = 0;\n                this.sliding    =true;\n                this.next_slide = index + 3;\n                this.prev_slide = index - 1;\n                $.each(this.options.steps,function(key,step){\n                    if(i<(index)-1 || i>self.next_slide){\n                        step.element.hide();\n                    }else{\n                        step.element.show();\n                    }\n                    if(i==self.next_slide){\n                        step.element.click(function(){\n                            var step    = $(this).data('step');\n                            self.select_by_index(step.index);\n                            //self._slide_next(step.index);\n                        });\n                    }\n                    i++;\n                });\n            },\n            _slide_prev : function(index){\n                var self            = this;\n                var i               = 0;\n                if((index+1)==4){\n                    this.sliding = false;\n                }\n                this.prev_slide = index - 3;\n                this.next_slide = index + 1;\n                $.each(this.options.steps,function(key,step){\n                    if(i>self.next_slide || i<self.prev_slide){\n                        step.element.hide();\n                    }else{\n                        step.element.show();\n                    }\n                    i++;\n                });\n            },\n            _create_content     : function(){\n                var self = this;\n                this.$content   = $(\"<div/>\").addClass('wizard-content');\n                this.$container.append(\"<br/>\").append(this.$content);\n            },\n            _fill_content       : function(){\n                var self = this;\n                $.each(this.options.steps,function(key,step){\n                    step.content_div.hide();\n                    self.$content.append(step.content_div);\n                });\n\n            },\n            _create_buttons     : function(){\n                var self                = this;\n                this.$container.append(\"<hr/>\");\n                this.$buttons           = $(\"<div/>\").addClass('wizard-buttons row').appendTo(this.$container);\n                var $buttons_left       = $(\"<div/>\").addClass('col-lg-6');\n                var $buttons_right      = $(\"<div/>\").addClass('col-lg-6');\n                this.$button_first      = this._create_button(this.options.first);                            \n                this.$button_first.addClass('pull-left')\n                                // .append('<span class=\"glyphicon glyphicon-chevron-left\" aria-hidden=\"true\"></span>') \n                                .append('<small>First</small>')   \n                                .appendTo($buttons_left);                                                                    \n                this.$button_prev       = this._create_button({'title':'Back','click':function(self){\n                                                                var prev_index = self._current_step.index - 1;\n                                                                self.select_by_index(prev_index);\n                                                            }});\n                this.$button_prev.addClass('pull-left')\n                                // .append('<span class=\"glyphicon glyphicon-chevron-left\" aria-hidden=\"true\"></span>') \n                                .append('<small>Previous</small>')   \n                                .appendTo($buttons_left);                                                                    \n                this.$button_next       = this._create_button({'title':'Next','click':function(self){\n                                                                var next_index = self._current_step.index + 1;\n                                                                self.select_by_index(next_index);\n                                                                if(self.options.after_next){\n                                                                    if(typeof self.options.after_next==='string'){\n                                                                        var func = self.options.after_next.replace(\"function\",\"function run\");\n                                                                        eval(func);\n                                                                        run(self);                           \n                                                                    }else{\n                                                                        self.options.after_next(self);                        \n                                                                    }                                                                    \n                                                                }\n                                                            },'class':'btn-blue'}); \n                this.$button_next.addClass('pull-right')\n                                .append('<small>Next</small>')   \n                                // .append('<span class=\"glyphicon glyphicon-chevron-right\" aria-hidden=\"true\"></span>') \n                                .appendTo($buttons_right);                                                                    \n                this.$button_finish     = this._create_button(this.options.finish).addClass('loket_wizard_finish');\n                this.$button_finish.addClass('pull-right')\n                                .append('<small>' + this.options.finish.title + '</small>')   \n                                // .append('<span class=\"glyphicon glyphicon-chevron-right\" aria-hidden=\"true\"></span>') \n                                .appendTo($buttons_right);                                                                    \n                this.$buttons.append($buttons_left,$buttons_right);                            \n            },\n            _create_button      : function(button){\n                var $a      = $('<a/>').addClass('btn btn-sm btn-primary text-uppercase');\n                var self    = this;\n                if(button.class!==undefined)\n                    $a.addClass(button.class);\n                if(button.href!==undefined)\n                    $a.prop('href',button.href);\n                if(button.click!==undefined){\n                    if(typeof button.click==='string'){\n                        var func = button.click.replace(\"function\",\"function click\");\n                        eval(func);\n                        $a.click(function(){\n                            click(self);                           \n                        });\n                    }else{\n                        $a.click(function(){\n                            button.click(self);                        \n                        });\n                    }\n                }\n                return $a;\n            },\n            _create_step_contents: function(step){\n                var self = this;\n                var $div = $(\"<div/>\").addClass('loket_wizard_step_content').data('step',step);\n                if(step.content){\n                    $.each(step.content,function(key,content){\n                        $div.append(self._create_step_content(step,content,key));\n                    });\n                }\n                return $div;\n            },\n            _create_step_content : function(step,content,key){\n                switch(content.type){\n                    case \"loketform\":\n                        return $('<div/>').addClass('loket_form_main').addClass('loket_form_' + key).data('form_name',key).loketForm(content.options).loketForm(\"load\");\n                        break;\n                    case \"loketwizard\":\n                        return this.options.steps[step.name].content[key].content=this._create_step_content_loketwizard(step,content);                    \n                    break;\n                    default:\n                    break;\n                }\n            },\n            _create_step_content_loketform : function(step,content,key){\n                content.options.parent  = this;\n                return $('<div/>').addClass('loket_form_main').addClass('loket_form_' + key).data('form_name',key).loketForm(content.options);\n            },\n            _create_step_content_loketwizard : function(step,content){\n                content.options.parent  = this;\n                return $('<div/>').loketWizard(content.options);\n            },            \n            select_by_name      : function(name){\n                this.$steps.find('step_mark').find('a').removeClass('active');\n                this.options.steps[name].element.find('a').addClass('active');\n                this.$content.append(this.options.steps[name].content);\n            },\n            select_by_index      : function(index){\n                var i=0;\n                var self    = this;\n                var exists   = false;\n                self.$content.children().each(function(idx, el) {\n                    var prev_step = $(this).data('step');\n                    if(prev_step.index==index){\n                        exist=true;\n                        $(this).show('slow');\n                    }else{\n                        $(this).hide('slow');\n                    }\n                });\n\n                $.each(this.options.steps,function(key,step){\n                    if(i==index){\n                        self._current_step = step;\n                        step.element.find('a').addClass('active');\n                        if(!exists){\n                            //self.$content.append(step.content_div);\n                        }\n                    }else{\n                        step.element.find('a').removeClass('active');\n                    }\n                    i++;\n                });\n                if(index<1){\n                    this.$button_first.show();\n                    this.$button_prev.hide();\n                }else{\n                    this.$button_first.hide();\n                    this.$button_prev.show();\n                }\n                if(index==(this._total_step-1)){\n                    this.$button_finish.show();\n                    this.$button_next.hide();\n                }else{\n                    this.$button_finish.hide();\n                    this.$button_next.show();\n                }\n                if(this.options.hide_prev){\n                    this.$button_prev.hide();\n                }\n                if(this.options.hide_next){\n                    this.$button_next.hide();\n                }\n                if(this.options.hide_finish){\n                    this.$button_finish.hide();\n                }\n                if(this.options.hide_first){\n                    this.$button_first.hide();\n                }\n                if(this.sliding){\n                    if(index==this.next_slide){\n                        this._slide_next(index);\n                    }else if(index==this.prev_slide){\n                        this._slide_prev(index);\n                    }\n                }else{\n                    if((index+1)==5){\n                        this._slide_next(index);\n                    }\n                }\n                if(this.options.index_change){\n                        if(typeof self.options.index_change==='string'){\n                            var func = self.options.index_change.replace(\"function\",\"function run\");\n                            eval(func);\n                            run(self);                           \n                        }else{\n                            self.options.index_change(self);                        \n                        }                                                                    \n                }\n            },\n            prev : function(){\n                if(this._current_step.index>0){\n                    this.select_by_index(this._current_step.index-1);\n                    return true;\n                }else{\n                    return false;\n                }\n            },\n            has_prev : function(){\n                if((this._current_step.index-1)>0){\n                    return true;\n                }else{\n                    return false;\n                }\n            },\n            next : function(){\n                if(this._current_step.index<(this._total_step-1)){\n                    this.select_by_index(this._current_step.index+1);\n                    return true;\n                }else{\n                    return false;\n                }\n            },\n            has_next : function(){\n                if((this._current_step.index + 1)<(this._total_step-1)){\n                    return true;\n                }else{\n                    return false;\n                }\n            },\n            \"serialize\" : function(){\n                  var self          = this;\n                  var placeholder   = '____PLACEHOLDER____';\n                  var fns           = [];\n                  var json          = JSON.stringify(this.options, function(key, value) {\n                    if (typeof value === 'function') {\n                      value = self._clear_string(value.toString());\n                      fns.push('\"' + value.toString() + '\"');\n                      return placeholder;\n                    }\n                    return value;\n                  }, 2);\n                  json = json.replace(new RegExp('\"' + placeholder + '\"', 'g'), function(_) {\n                    return fns.shift();\n                  });\n                  return json;\n            },\n            _clear_string : function(str) {\n                str = str.replace(/\\s{2,}/g, ' ');\n                str = str.replace(/\\t/g, ' ');\n                str = str.toString().trim().replace(/(\\r\\n|\\n|\\r)/g,\"\");\n                str = str.replace(/\"/g,\"\\\\\\\"\");\n                return str;\n            },\n            get_forms : function(){\n                var forms = [];\n\n            },\n            validate : function(){\n                var self    = this;\n                var valid   = true;\n                this.$content.find('.loket_form_main').each(function(index, form) {\n                    if(!$(form).loketForm('validate')){\n                        var $step   = $(form).closest('.loket_wizard_step_content');\n                        self.auto_select($step);\n                        valid = false;\n                        return false;\n                    }                    \n                });\n                return valid;\n            },\n            auto_select : function($step){\n                var step        = $step.data('step');\n                var $wizard     = $step.closest('.loket_wizard_main').loketWizard('select_by_index',step.index);\n                var $new_step   = $wizard.parent();\n                if($new_step.hasClass('loket_wizard_step_content')){\n                    this.auto_select($new_step);\n                }                    \n            },\n            get_data : function(){\n                var self    = this;\n                var forms   = {};\n                this.$content.find('.loket_form_main').each(function(index, form) {\n                    var form_name       = $(form).data('form_name');\n                    var data            = $(form).loketForm('get_form_data');\n                    forms[form_name]    = data;\n                });\n                return forms;\n            },\n            submit : function(callback,save){\n                // if(this.first_submit){\n                //     this.first_submit = false;\n                //     return false;\n                // }\n                var self        =   this;\n                save            =   save!==undefined?save:false;\n                var data        =   {save:save,data:this.get_data()};\n                data            =   JSON.stringify(data);\n                if(this.options.encode){\n                    data = this._encode(data);\n                }\n                var response    = '';\n                var save_url  = this.options.source + '?loketwizard_action=save';\n                $.ajax({\n                      url: save_url,\n                      data: data,\n                      type: \"POST\",\n                      async: this.options.async,\n                      success: function(data) {\n                        if(self.options.async){\n                            callback(data);\n                        }else{\n                            response = data;\n                        }\n                      }\n                });\n                return response;\n            },\n            set_records : function(records){\n                var self = this;\n                this.$content.find('.loket_form_main').each(function(index, form) {\n                    var form_name       = $(form).data('form_name');\n                    if(self.options.records[form_name]){\n                        var record  = self.options.records[form_name];\n                        var options = $(form).loketForm('get_options');\n                        $(form).loketForm('set_options',options).loketForm('bind',record).loketForm('load');\n                    }\n                });\n            },\n            _encode        : function(data){\n                  var b64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';\n                  var o1, o2, o3, h1, h2, h3, h4, bits, i = 0,\n                    ac = 0,\n                    enc = '',\n                    tmp_arr = [];\n\n                  if (!data) {\n                    return data;\n                  }\n\n                  do { // pack three octets into four hexets\n                    o1 = data.charCodeAt(i++);\n                    o2 = data.charCodeAt(i++);\n                    o3 = data.charCodeAt(i++);\n\n                    bits = o1 << 16 | o2 << 8 | o3;\n\n                    h1 = bits >> 18 & 0x3f;\n                    h2 = bits >> 12 & 0x3f;\n                    h3 = bits >> 6 & 0x3f;\n                    h4 = bits & 0x3f;\n\n                    // use hexets to index into b64, and append result to encoded string\n                    tmp_arr[ac++] = b64.charAt(h1) + b64.charAt(h2) + b64.charAt(h3) + b64.charAt(h4);\n                  } while (i < data.length);\n\n                  enc = tmp_arr.join('');\n\n                  var r = data.length % 3;\n\n                  return (r ? enc.slice(0, r - 3) : enc) + '==='.slice(r || 3);\n            }\n        });\n}(jQuery));\n\n//First Widget\n(function( $ ) {\n    var base = {\n        _create: $.loket.loketWizard.prototype._create,\n        _get_source: $.loket.loketWizard.prototype._get_source,\n        select_by_index: $.loket.loketWizard.prototype.select_by_index,\n        _create_step_content: $.loket.loketWizard.prototype._create_step_content,\n        _id_country_list: [],\n        _id_province_list: [],\n        _id_district_list: [],\n        _id_region_list: []\n    }\n\n    $.extend(true, $.loket.loketWizard.prototype, {\n        _create: function() {\n            var self = this;\n            if (this.options.hold_render !== undefined && this.options.hold_render) {\n                var $img_loading = self._get_image_loading();\n                $img_loading.css('margin-top', '4rem');\n                $('.custom_form_widget').append($img_loading);\n                this._bind_ticket_changes.apply(this);\n                self._trigger_wizard.apply(self, arguments);\n            }\n            else {\n                base._create.apply(this, arguments);\n            }\n        },\n        _promise_create: function() {\n            var self = this;\n            return new Promise(function(resolve, reject) {\n                self._get_source().then(function(options) {\n                    $.extend(true, self.options, options);\n                    if (self._is_new_widget())\n                    {\n                        self._create_container_new();\n                    } else \n                    {\n                        self._create_container();\n                    }\n                    self._init_country();\n                    self._init_province();\n                    self._init_district();\n                    self._init_region();\n                    if (!self._is_new_widget())\n                    {\n                        self._init_medical();\t\t\t\t\t\t\t\t\n                    }\n                    resolve()       \n                })\n                .catch(function(e){\n                    console.log(e)\n                    alert('Something wrong. Please check internet connection.')\n                });\n            })\n        },\n        _get_source : function() {\n            if (!this.options.hold_render)\n                return base._get_source.apply(this, arguments);\n                \n            var self = this;\n            return new Promise(function(resolve, reject) {\n                var params = {};\n                var source_url  = self.options.source + '?loketwizard_action=get_source';\n                if(self.options.session_name){\n                    source_url  = source_url + '&loketwizard_session_name=' + self.options.session_name;\n                }\n                $.ajax({\n                    url: source_url,\n                    type: \"POST\",\n                    async: true,\n                    data: $('#form-user').serialize(),\n                    beforeSend: function(xhr) {\n                        $('#buy_ticket').attr('disabled', true);\n                        $('.ticket-types').attr('disabled', true);\n                        $('.container-form').hide();\n                        $('.loading').show();\n                    },\n                }).done(function(data) {\n                    params = JSON.parse(data);\n                    resolve(params)\n                })\n                .fail(function(){\n                    reject()\n                })\n                .always(function(){\n                    $('.ticket-types').removeAttr('disabled');\n                    $('.container-form').show();\n                    $('.loading').hide();\n                });\n            });\n            \n        },\n        _init_country: function() {\n            $.get('/ajax_data/get_country', function(data) {\n                $('select[name=\"loket_form_country\"], select[name=\"loket_form_country2\"], select[name=\"loket_form_country3\"]').html('');\n                $('select[name=\"loket_form_country\"], select[name=\"loket_form_country2\"], select[name=\"loket_form_country3\"]').append('<option value=\"\">&hellip;</option>');\n                $.each(data.dropdown_countries, function(k, v) {\n                    base._id_country_list[v] = k;\n                    $('select[name=\"loket_form_country\"], select[name=\"loket_form_country2\"], select[name=\"loket_form_country3\"]').append('<option value=\"'+v+'\">'+v+'</option>');\n                })\n            })\n        },\n        _init_province: function() {\n            $('select[name=\"loket_form_country\"], select[name=\"loket_form_country2\"], select[name=\"loket_form_country3\"]').change(function() {\n                var id_country              = base._id_country_list[$(\"option:selected\", this).val()];\n                var attribute_name          = $(this).attr('name');\n                var index_elm               = attribute_name[attribute_name.length - 1];\n                var selector_elm_province   = 'select[name=\"loket_form_province\"]';\n                var selector_elm_district   = 'select[name=\"loket_form_district\"]';\n                var selector_elm_region     = 'select[name=\"loket_form_region\"]';\n\n                if (!isNaN(index_elm)) {\n                    selector_elm_province   = 'select[name=\"loket_form_province'+index_elm+'\"]';\n                    selector_elm_district   = 'select[name=\"loket_form_district'+index_elm+'\"]';\n                    selector_elm_region     = 'select[name=\"loket_form_region'+index_elm+'\"]';\n                }\n                var elm_province            = $(this).parent().next().find(''+selector_elm_province);\n                var elm_district            = elm_province.parent().next().find(''+selector_elm_district);\n                var elm_region              = elm_district.parent().next().find(''+selector_elm_region);\n\n                if ($(this).val().length && $(this).val() == 'Indonesia')\n                {\n                    elm_province.removeAttr('disabled')\n                    elm_district.removeAttr('disabled');\n                    elm_region.removeAttr('disabled');\n\n                    $.post('/ajax_data/get_province',{'id_country':id_country},function(data){\n                        elm_province.html('');\n                        elm_province.append('<option value=\"\">&hellip;</option>');\n                        $.each(data.dropdown_province, function(k,v){\n                            base._id_province_list[v] = k;\n                            elm_province.append('<option value=\"' + v + '\">'+ v +'</option>');\n                        });\n                        elm_province.trigger(\"chosen:updated\");\n                    },'json');\n                }\n                else {\n                    elm_province.attr('disabled', 'disabled')\n                    elm_district.attr('disabled', 'disabled');\n                    elm_region.attr('disabled', 'disabled');\n                }\n            })\n        },\n        _init_district: function() {\n            $('select[name=\"loket_form_province\"], select[name=\"loket_form_province2\"], select[name=\"loket_form_province3\"]').change(function(){\n                if ($(this).val().length)\n                {\n                    var id_province         = base._id_province_list[$(\"option:selected\", this).val()];\n                    var attribute_name      = $(this).attr('name');\n                    var index_elm           = attribute_name[attribute_name.length - 1];\n                    var selector_district   = 'select[name=\"loket_form_district\"]'; \n                    if (!isNaN(index_elm))\n                        selector_district   = 'select[name=\"loket_form_district'+index_elm+'\"]';\n                    var id_district     = $(this).parent().next().find(''+selector_district);\n                    $.post('/ajax_data/get_district',{'id_province': id_province},function(data){\n                        id_district.html('');\n                        id_district.append('<option value=\"\">&hellip;</option>');\n                        $.each(data.dropdown_district, function(k,v){\n                            base._id_district_list[v] = k;\n                            id_district.append('<option value=\"' + v + '\">'+ v +'</option>');\n                        });\n                        id_district.trigger(\"chosen:updated\");\n                    },'json');\n                }\n            });\n        },\n        _init_region: function() {\n            $('select[name=\"loket_form_district\"], select[name=\"loket_form_district2\"], select[name=\"loket_form_district3\"]').change(function(){\n                if ($(this).val().length)\n                {\n                    var id_district         = base._id_district_list[$(\"option:selected\", this).val()];\n                    var attribute_name      = $(this).attr('name');\n                    var index_elm           = attribute_name[attribute_name.length - 1];\n                    var selector_region     = 'select[name=\"loket_form_region\"]'; \n                    if (!isNaN(index_elm))\n                        selector_region     = 'select[name=\"loket_form_region'+index_elm+'\"]';\n                    var id_region           = $(this).parent().next().find(''+selector_region);\n                    $.post('/ajax_data/get_region',{'id_district': id_district},function(data){\n                        id_region.html('');\n                        id_region.append('<option value=\"\">&hellip;</option>');\n                        $.each(data.dropdown_region, function(k,v){\n                            id_region.append('<option value=\"' + v + '\">'+ v +'</option>');\n                        });\n                        id_region.trigger(\"chosen:updated\");\n                    },'json');\n                }\n            });\n        },\n        _get_diff_years: function(date) {\n            var birth_date = new Date(date);\n            var current_date= new Date();\n            var birth_date_final = new Date(birth_date.getYear(), birth_date.getMonth() + 1, birth_date.getDate());\n            var current_date_final = new Date(current_date.getFullYear(), current_date.getMonth() + 1, current_date.getDate())\n            var diff = (current_date_final.getTime() - birth_date_final.getTime()) / 1000;\n            diff /= (60 * 60 * 24);\n            var diff_years = Math.abs(Math.round(diff/365.25));\n            return diff_years;\n        },\n        _validate_phone_number_is_same: function(phone_number_one, phone_number_two) {\n            if (phone_number_one && phone_number_two) {\n                if (phone_number_one == phone_number_two) {\n                    alert('Participant phone number cannot same with Emergency phone number');\n                    return true;\n                }\n                return false;\n            }\n\n            return false;\n        },\n        _init_medical: function() {\n            $('input[name=loket_form_allergy_description]').hide();\n            $('input[name=loket_form_allergy_description2]').hide();\n            $('input[name=loket_form_allergy_description3]').hide();\n            $('input[name=loket_form_medical]').hide();\n            $('input[name=loket_form_medical2]').hide();\n            $('input[name=loket_form_medical3]').hide();\n            $('select[name=loket_form_age_category]').attr('readonly', true);\n            $('select[name=loket_form_age_category2]').attr('readonly', true);\n            $('select[name=loket_form_age_category3]').attr('readonly', true);\n            var self = this;\n\n            $('input[name=\"loket_form_terms_and_condition[]\"]').click(function() {\n                var modalTNC = '<div id=\"modalTNC\" class=\"modal\"><div class=\"modal-dialog\" style=\"overflow-y: initial !important;\"><div class=\"modal-content\"><div class=\"modal-header\"><strong>Terms &amp; Conditions</strong> <button class=\"close\" type=\"button\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button></div><div class=\"modal-body\" style=\"height: calc(100vh - 270px); overflow-y: auto;\"><div class=\"row\"><div class=\"col grid-12\"><p><b>General</b></p><p><ol type=\"1\"><li>The Powerman Indonesia (referred to herein as the Race) is organized by E-Plus Indonesia (Organizer) in accordance with these Rules & Regulations (R&Rs) and Terms and Conditions (T&Cs) that is applicable to the Participants.</li><li>The Organizer reserves the right to modify or substitute any of these R&Rs and/or T&Cs of the Event from time to time as they deem fit. If there is ambiguity in any of these provisions, the Organizer shall be the authority to interpret and in doing so, Organizer will take into account the interests of all the affected Participants. Any amendments to these R&Rs and/or T&Cs will be updated on the Official Website, www.powermanindonesia.com and it is the responsibility of the involved and/or affected Party to keep abreast with any changes.</li></ol></p><b>I.P.A. International Powerman Association Powerman</b><p>Participants are obliged to the rules and regulations passed by the organizer with an addition: The Powerman 10m Non-Drafting rule. Created together with top athletes in 1999, the International Powerman Association continues to impose this ruling despite its abolishment by the federation, to ensure a fair race. Powerman races: If you’re tough enough…. Be There!</p><b>The Powerman races 10m Non-Drafting rule:</b><p>Cycle in a ‘single file’.<br><br> While cycling, athletes are supposed to cycle in one line (to the utmost left side of the track) with the prescribed distance between them.</p><p><ul><li>No fellow athlete may be hindered.</li><li>Hindering happens when overtaking a fellow athlete and putting him/her in a drafting/stayer position. The person who overtakes is responsible to observe the rules. When the overtaker is not able to pass, he/she may not cut in but has to maintain a distance of at least 10 m from the cyclist in front.</li><li>In the former rules the responsibility was for the person that was overtaken.</li><li>Hinderer may be punished by a ‘stop and go’ penalty/or black box.</li><li>The person who overtakes has to go at least 3 – 5 m to the right. This depends on the width of the road.</li></ul></p><b>Registration</b><ol type=\"1\"><li>By completing the online registration form, the Participant agrees to abide by the rules and regulations (‘R&R’) of Powerman Indonesia (‘Event’). These R&Rs shall be enforced before and during the event and applies to all rulings by the Organizer.</li><li>Successful registration does not constitute to a confirmation in the Event. Confirmation of participation is only confirmed upon payment of registration fees and upon receipt of a race identification number.</li></ol><ol type=\"1\"><li>In consideration of the Participant’s use of the Event’s website, the Participant agrees to:<br><b>i.\t</b>Provide true, accurate, current and complete information about the Participant contained in the registration form (the Registration Data); and<br><br><b>ii.\t</b>Maintain and promptly update the Registration Data to keep it true, accurate, current and complete. The Organizer may contact the Participant from time to time by email. Any notice sent to the email address registered with the Organizer shall be deemed as received by the Participant.</li><li>If the Participant provides any information that is untrue, inaccurate, not current or incomplete, or if the Organizer has grounds to suspect that such information is untrue, inaccurate, obsolete or incomplete, the Organizer may suspend or terminate the Participant’s registration and refuse any and all current or future use of the Official Website or Registration Portal (or any parts thereof) without any refund of fees.</li><li>The Organizer re serves the right to limit and or refuse race entries without assigning any reason.</li><li>The Organizer will not entertain nor be in any way responsible for any disputes arising from incomplete or inaccurate entry details in the registration form.</li><li>Participant(s) are strictly not allowed to transfer their race entries to another party or change race categories after their registrations are confirmed.</li><li>Once registration has been duly processed,, there will be no fee refund for Participant(s) who do not eventually participate in the Event for whatever reasons.</li></ol><b>Age Restriction</b><ol type=\"1\"><li>All participant(s) are to strictly adhere to the age limitations imposed on each category. The age of a participant will be taken as of race day (30th June 2019).</li></ol><b>Race Entry Packs</b><ol type=\"1\"><li>All Participants must collect their Race Entry Pack which includes the Race Bib, timing device, Event Tee, and other novelties at the Race Entry Pack Collection (REPC) during the collection period (Collection Period), of which details will be stated on the Official Website. If Participants are unable to collect their Race Entry Pack in person, they may empower a duly authorized representative in accordance with the procedure detailed on the Official Website.</li><li>Late collection will not be entertained and the Organizer shall not be liable for any other loss or inconvenience caused, due to Participant(s) inability to collect their Race Entry Packs. The Organizer may extend the collection time at the Organizer’s discretion and on a good-will basis only. For avoidance of doubt, the Organizer is not obliged to extend the collection time or to ensure that the Participant(s) receive their Race Entry Packs. At all times, it is the responsibility of the Participant(s) to collect their Race Entry Packs during the Collection Period. Entry packs not collected during the Collection Period will be deemed as unwanted, and the Organizer shall be at liberty to dispose or re- distribute them accordingly.</li></li></ol><b>Disclosure</b><ol type=\"1\"><li>The Participant(s) is deemed to have given written consent for the Organizer to collect, analyze and collate any personal information relating to that Participant(s), and the Organizer may at its sole discretion utilize the information for programs, planning, data-processing, statistics, risk-analysis, research and/or, any other purposes.</li></ol><b>Recorded Media</b><ol type=\"1\"><li>The Organizer reserves the right to use any photographs (including those of Participants), motion pictures, recordings, or any other media records of the Event, for any legitimate purpose, including commercial advertising and promotion and distribution to Sponsors anywhere in the world.</li></ol><b>The Race</b><ol type=\"1\"><li>Right to cancel and amend routes.<ol type=\"a\"><li>The Organizer reserves the right to cancel the Event at any time without prior notice to the Participant, in which case the Organizer will make its best effort to inform the Participant(s) prior to the date of the event. If the Event is cancelled, there shall be no refund of fees paid unless the Organizer deems fit to give a refund and the Organizer shall not be held liable for any loss or inconvenience caused.</li><li>There will strictly be no fee refund if the event is cancelled for reason of force majeure i.e. due to occurrence of incidents that are beyond the control of the Organizer or acts of God which renders it impossible or unsafe to hold the event.</li><li>The Organizer reserves the right to amend the event race routes as they deem fit for the safety of the Participants and/or to prevent any potential hazards in the running of the event, at any time without prior notice to the Participant(s). In such cases, every effort will be made to inform the Participant(s) prior to the date of the event. The Organizer shall not be liable for any other loss or inconvenience caused due to such changes.</li><li>The Organizer reserves the right to cancel and/or add any race category without prior notice to the Participant(s).</li></ol></li><li>Closure of roads and Cut-Off Time<ol type=\"a\"><li>Parts of the race route will be closed to traffic for the duration of the race up to six (6) hours from the first flag off. After which, beyond the six (6) hour cut off mark, the roads will be re-opened to live traffic. Participant(s) who are still on route and choose to continue running after the cut-off time, shall do so at their own risk.</li><li>The Organizer reserves the right to re-open the race route to live traffic at their sole discretion for operational reasons and/or to prevent any potential hazards in the running of the event, at any time without prior notice to the Participant(s). In such cases, Participant(s) prior to the date of the event, if possible, or, if not possible, on a best-effort basis. The Organizer shall not be liable for any other loss or inconvenience caused due to such changes.</li><li>For Participant(s) who are unlikely to finish the race within six hours, race officials may request Participant(s) to board a safety vehicle and/or abandon completion of the race course. For their own safety and to avoid being caught in between live traffic, Participant(s) must obey as instructed; or else they will be removed from the race course by Security Officers. Finisher medals, Finisher tees and official finish timings will not be issued to the afore-mentioned Participant(s) as they will be deemed disqualified.</li></ol></li><li>Restriction on vehicles along the race routes<ol type=\"a\"><li>Pets, in-line skates, prams, push carts, shoes with built-in or attached rollers and any other wheel-run objects are not allowed on the race route other than official race and medical vehicles.</li></ol></li><li>Participants Bib<ol type=\"a\"><li>The timing ch'\n                +'ip is a single-use, disposable device attached onto the Bib.</li><li>b.\t2. Participant(s) must attach the assigned Bib to their attire as instructed by Race Officials. Participant(s) who do not wear / display Bib numbers will be taken off the race route by security officers at the Organizer’s sole discretion.</li></ol></li><li>Indemnity<ol type=\"a\"><li>Whilst reasonable precaution will be taken by the Organizer to ensure the Participants’ safety, Participant(s) taking part in the event will be participating at their own risk and the Organizer will not be responsible or held liable for any injury or death howsoever arising from training for, during or after participation in the event. Participant(s) are strongly encouraged to go for a medical examination and/or consult their medical practitioner prior to registration and before the actual race day.</li></ol></li><li>Retirement from Race<ol type=\"a\"><li>Participant(s) must retire from the race immediately if required to do so by any member of the official medical staff, Race Director, Referee and/or Security Officer.</li></ol></li><li>Adherence to flag – off timings<ol type=\"a\"><li>Participant(s) who commences to run before the actual start time of his/her registered race category will be immediately disqualified. (The start time for the race can be found on the Official Website).</li><li>Participant(s) who do not start within 20 minutes from respective flag off will be disqualified and for safety reason, may not be allowed to start.</li></ol></li><li>Winners and Prizes<ol type=\"a\"><li>Each Participant is allowed only one prize-money award. A winning Participant may elect to receive an award in another prize category to which he/she is entitled to, which might offer a higher prize-money. Notwithstanding the Participant’s election, his/her finishing positions in each of the relevant prize categories do not change.</li><li>Winners will be disqualified from the race if he/she does not satisfy the age, nationality and/or gender requirements for the category they have registered in.</li><li>The Organizers reserve the right to replace any winners if he/she is found to be disqualified.</li><li>All prize-winning Participant(s) must present their original identification document (such as Passport or Identity Card) to collect their prize money</li><li>Prize money will be disbursed to the named winner upon confirmation by the organizer. Results and Announcements made by the organizer during the event shall be deemed final.</li><li>All prizes not claimed within one (1) month from the event date will be forfeited and the Organizer will be at liberty to redistribute or dispose of them accordingly.</li><li>Prizes must be taken, in the forms as presented by the Organizer. They are not transferable or exchangeable for cash and are subjected to the R&Rs and/or T&Cs as determined by the Organizer.</li></ol></li><li>Disputes over results<ol type=\"a\"><li>1. For prize winners or possible prize winners, appeals over disputes must be made onsite in person, in a written format and an appeal fee of IDR 750,000 within 30 mins after the prize presentation..</li><li>The Organizer reserves the rights to replace any winners if he/she is found to be disqualified.</li><li>For all other Participant(s), appeals over disputes regarding the results must be submitted in a written format together with an appeal fee of IDR 750,000 within 7 days of the event date. The Organizer reserves the right not to entertain any appeals after 7 days of the event date</li></ol></li><li>Finisher’s Medal, Finisher’s Tee and e-Certificate<ol type=\"a\"><li>All participants who successfully complete the race in the chosen race category will be awarded a Finisher’s Medal upon the presentation of their Bib to the respective officials.</li><li>All participants in the Powerman Classic Individual and Powerman Short Individual category will also be awarded a Finisher’s Tee upon the presentation of their Bib to the respective officials. Team Relays for both Classic and Short are not applicable to this entitlement.</li><li>All Finisher Medals and Finisher Tees are to be collected on the race day. No requests thereafter will be entertained.</li><li>All Participants who successfully complete the race in their chosen race category can download for an e-Certificate of Participation on the Official Website, <a href=\"http://www.powermanIndonesia.com.\">www.powermanIndonesia.com.</a> This entitlement will not apply to Participants who are unable to complete the race within the six (6) hour cut-off mark, are disqualified or do not complete the race. The availability of the e-Certificate will only be available until 3 months after the event date</li></ol></li></ol> <button id=\"btn-agree-tnc\" data-dismiss=\"modal\" class=\"btn btn-blue\" type=\"button\">Agree &amp; Continue</button></div></div></div><div class=\"modal-footer\">&nbsp;</div></div></div></div>';\n                $('#main').append(modalTNC);\n                $('#modalTNC').modal('show');\n            });\n\n            $('input[name=\"loket_form_terms_and_condition1[]\"]').click(function() {\n                var modalTNC = '<div id=\"modalTNC1\" class=\"modal\"><div class=\"modal-dialog\" style=\"overflow-y: initial !important;\"><div class=\"modal-content\"><div class=\"modal-header\"><strong>Terms &amp; Conditions</strong> <button class=\"close\" type=\"button\" data-dismiss=\"modal\" aria-label=\"Close\"><span aria-hidden=\"true\">&times;</span></button></div><div class=\"modal-body\" style=\"height: calc(100vh - 270px); overflow-y: auto;\"><div class=\"row\"><div class=\"col grid-12\"><p class=\"p1\" style=\"text-align:center\"><span class=\"s1\"><b>PERATURAN DAN REGULASI</b></span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Para peserta diwajibkan untuk membaca seluruh aturan dan pedoman dibawah ini secara seksama sebelum mendaftarkan diri untuk Le Minerale Water Run 2019.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\"><b>UMUM</b></span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Kategori lomba Fun Run 5K dan Family Run 2K</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Ketentuan peserta adalah Warga Negara Indonesia pemilik KTP/SIM/Passpor dan Warga Negara Asing pemilik KITAS.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Untuk batas usia keikutsertaan per kategori adalah sebagai berikut:</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">5K Tertutup: peserta diharuskan berusia minimal 12 tahun.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Family Run : 1. Usia Peserta Anak untuk Family Run adalah 6 (Enam) sampai dengan 11 (Sebelas) Tahun dan Usia untuk Orang tua atau pendamping Family Run adalah 17 &ndash; 75 tahun yang dibuktikan dengan kartu identitas yang sah menurut hukum.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Perlu diingat bahwa inspeksi akan dilakukan selama perlombaan untuk memastikan bahwa seluruh peraturan lomba ditaati.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Para peserta dihimbau untuk mendapatkan rekomendasi medis dari dokter terkait dengan kondisi kesehatan saat menjelang hari lomba.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Setiap peserta memahami sepenuhnya bahwa olahraga ini memiliki resiko yang dapat mengakibatkan cedera, cacat bahkan kematian.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Peserta pendaftar tidak dapat dialihnamakan/dipindahtangankan dan bersifat final serta menerima sepenuhnya atas seluruh peraturan dan ketentuan yang berlaku. Barang siapa memberikan nomor lomba (bib) kepada pihak/peserta lain makan peserta akan didiskualifikasi dari perlombaan.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Biaya pendaftaran tidak dapat dikembalikan. Pihak penyelenggara memiliki hak untuk menolak pendaftaran setelah pendaftaran diterima apabila ada pendaftar yang memberikan informasi yang salah/tidak akurat.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Apabila kegiatan/acara terpaksa dibatalkan dikarenakan hal-hal diluar kontrol pihak penyelenggara (force majeur) termasuk diantaranya musibah, hujan deras, badai, dan demonstrasi, maka tidak ada pengembalian biaya pendaftaran yang telah dibayarkan dan pihak penyelenggara tidak bertanggung jawab atas kerugian atau ketidaknyamanan yang terjadi.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Penyelenggara tidak menyediakan penginapan / akomodasi bagi peserta</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\"><b>PARTISIPASI</b></span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Para peserta harus dapat menyelesaikan jarak penuh</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Penyelesaian formulir pendaftaran online menegaskan persetujuan peserta untuk mematuhi seluruh aturan dan regulasi lomba.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Konfirmasi pendaftaran lomba akan diberikan setelah melengkapi pendaftaran dan pembayaran.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Pihak penyelenggara memiliki hak untuk menutup pendaftaran sebelum tenggang waktu tanpa pemberitahuan terlebih dahulu ketika kuota lomba sudah penuh.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Peserta menyetujui untuk memberikan informasi tentang kepesertaan yang benar, akurat, terkini dan menyeluruh, yang terdapat dalam formulir pendaftaran. Pihak penyelenggara dapat menghubungi peserta sewaktu-waktu melalui surat elektronik. Surat pemberitahuan dikirim ke alamat surat elektronik yang terdaftar.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Persyaratan waktu kegiatan dan usia minimum berlaku terhadap seluruh jenis pendaftaran dan partisipasi kegiatan.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Nomor peserta lomba (bib) adalah pengenal spesifik perseorangan dan tidak dapat dipertukarkan dengan atau dipindahkan/dijual kepada orang lain.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Penjualan dan/atau pemindahtanganan nomor peserta lomba sangat dilarang keras dan akan mengakibatkan diskualifikasi dan/atau pelarangan orang tersebut/tim dalam keikutsertaan di acara Le Minerale Water Run di masa depan.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Peserta yang ditemukan melakukan kecurangan seperti mengganggu/menghadang/ mendorong peserta lain dengan berjalan di depan peserta lain akan dikenakan diskualifikasi. Selain itu peserta yang mencari keuntungan waktu dengan berlari memperpendek jarak lomba, membonceng kendaraan, dan kecurangan/pelanggaran lainnya terhadap ketentuan-ketentuan perlombaan akan dikenakan diskualifikasi.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Water station terletak di beberapa titik disepanjang lintasan lomba dan di garis finish. Sedangkan pos buah akan disediakan di garis finish.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Penggunaan kendaraan bermotor dan sepeda sangat dilarang keras di jalur lomba, kecuali terkait Penyelenggaraan Lomba.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Penunjukan waktu akan ditampilkan di start line dan finish line. Para peserta akan diijinkan untuk menyelesaikan jarak tempuh selama paling 1 jam untuk 5K sejak lomba di masing-masing kategori lomba.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Keamanan jalan raya dibawah pengendalian Pihak Kepolisian, Dinas Perhubungan &amp; Otoritas&nbsp; setempat. Layanan kesehatan akan diberikan oleh Panitia Pelaksana bekerjasama dengan Rumah Sakit setempat dan Pelindung Masyarakat di sepanjang lintasan lomba. Para petugas kesehatan dapat menghentikan peserta untuk melanjutkan lomba dikarenakan alasan kesehatan.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Seluruh materi foto, rekaman film peserta beserta turunannya dalam bentuk promosi maupun fotografi pada saat lomba adalah milik Panitia dan dapat dipergunakan seluas-luasnya untuk kepentingan promosi dan penggandaan lebih lanjut.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Penyelenggara berhak mengubah aturan kapan saja yang dianggap perlu dan sesuai dengan keadaan, baik sebelum dan saat lomba berlangsung, tanpa pemberitahuan terlebih dahulu beserta alasannya.</span></p>'\n                                +'<p class=\"p2\"><span class=\"s1\">Hal-hal lain yang belum tercantum dalam peraturan ini akan ditetapkan kemudian.</span></p><button id=\"btn-agree-tnc\" data-dismiss=\"modal\" class=\"btn btn-blue\" type=\"button\">Agree &amp; Continue</button></div></div></div><div class=\"modal-footer\">&nbsp;</div></div></div></div>';\n                $('#main').append(modalTNC);\n                $('#modalTNC1').modal('show');\n            })\n\n            $('input[name=loket_form_telephone], input[name=loket_form_telephone2], input[name=loket_form_telephone3]').blur(function() {\n                var participant_phone_number = $(this).val();\n                var idx_element = $(this).attr('name').slice(-1);\n                var elm_emergency_phone_numb = 'loket_form_emergency_telephone';\n                if (!isNaN(idx_element)) {\n                    elm_emergency_phone_numb += idx_element\n                }\n                var emergency_telephone = $('input[name='+elm_emergency_phone_numb+']').val();\n                if (self._validate_phone_number_is_same(participant_phone_number, emergency_telephone)) {\n                    $('input[name='+elm_emergency_phone_numb+']').val('');\n                    $(this).val('');\n                    $(this).focus();\n                }\n            });\n\n            $('input[name=loket_form_emergency_telephone], input[name=loket_form_emergency_telephone2], input[name=loket_form_emergency_telephone3]').blur(function() {\n                var emergency_telephone = $(this).val();\n                var idx_element = $(this).attr('name').slice(-1);\n                var elm_participant_phone_numb = 'loket_form_telephone';\n                if (!isNaN(idx_element)) {\n                    elm_participant_phone_numb += idx_element\n                }\n                var participant_telephone = $('input[name='+elm_participant_phone_numb+']').val();\n                if (self._validate_phone_number_is_same(emergency_telephone, participant_telephone)) {\n                    $('input[name='+elm_participant_phone_numb+']').val('');\n                    $(this).val('');\n                    $(this).focus();\n                }\n            });\n\n            $('input[name=loket_form_dob], input[name=loket_form_dob1], input[name=loket_form_dob2], input[name=loket_form_dob3]').datepicker().on('changeDate', function(e) {\n                var diff_years = self._get_diff_years($(this).val());\n                var dob = $(this).val();\n                var idx = $(this).attr('name').slice(-1);\n                var elm_age_category = 'loket_form_age_category';\n                if (!isNaN(idx)) {\n                    elm_age_category += idx\n                }\n                var age_category = $(this).closest('.form-group').next().find('select[name='+elm_age_category+']');\n\n                if (diff_years >= 18 && diff_years <= 29) {\n                    age_category.val(\"18-29\").change();\n                }\n                else if (diff_years >= 30 && diff_years <= 39) {\n                    age_category.val(\"30-39\").change();\n                }\n                else if (diff_years >= 40 && diff_years <= 49) {\n                    age_category.val(\"40-49\").change();\n                }\n                else if (diff_years >= 50) {\n                    age_category.val(\"50-Abv\").change();\n                }\n            });\n\n            $('input[name=loket_form_leg1]').change(function() {\n                var leg1 = $('input[name=loket_form_leg1]:checked').val()\n\n                $('input[name=loket_form_leg2]').map(function(i, n) { \n                    $(n).removeAttr('disabled').removeAttr('checked')\n                })\n                $('input[name=loket_form_leg2][value='+ leg1 +']').attr('disabled', true)\n\n                $('input[name=loket_form_leg3]').map(function(i, n) { \n                    $(n).removeAttr('disabled').removeAttr('checked')\n                })\n                $('input[name=loket_form_leg3][value='+ leg1 +']').attr('disabled', true)\n            });\n\n            $('input[name=loket_form_leg2]').change(function() {\n                var leg2 = $('input[name=loket_form_leg2]:checked').val()\n                $('input[name=loket_form_leg3]').map(function(i, n) {\n                    if ($(n).attr('disabled') != 'disabled') {\n                        $(n).removeAttr('disabled').removeAttr('checked');\n                    }\n                })\n                $('input[name=loket_form_leg3][value='+ leg2 +']').attr('disabled', true)\n            })\n\n            $('input[name=\"loket_form_allergy\"], input[name=\"loket_form_allergy2\"], input[name=\"loket_form_allergy3\"]').click(function() {\n                var idx = $(this).attr('name').slice(-1);\n                var elm_allergy_desc = 'loket_form_allergy_description';\n                if (!isNaN(idx)) {\n                    elm_allergy_desc += idx\n                }\n                console.log(elm_allergy_desc);\n                var allergy_desc = $(this).closest('.form-group').next().find('input[name='+elm_allergy_desc+']');\n                if ($(this).val() == 'Yes') {\n                    allergy_desc.show();\n                } else {\n                    allergy_desc.hide();\n                }\n            });\n\n            $('input[name=\"loket_form_healthy\"], input[name=\"loket_form_healthy2\"], input[name=\"loket_form_healthy3\"]').click(function() {\n                var idx = $(this).attr('name').slice(-1);\n                var elm_medical = 'loket_form_medical';\n                if (!isNaN(idx)) {\n                    elm_medical += idx\n                } \n                var elm_details_medical = $(this).closest('.form-group').next().find('input[name='+elm_medical+']');\n                if ($(this).val() == 'Yes') {\n                    elm_details_medical.show();\n                } else {\n                    elm_details_medical.hide();\n                }\n            });\n\n            $('input[name=loket_form_company_name]').hide();\n            $('input[name=loket_form_school_name]').hide();\n            $('input[name=loket_form_no_member_gapensi]').hide();\n            $('input[name=loket_form_subject]').click(function() {\n                if ($(this).val() == 'Student') {\n                    $('input[name=loket_form_school_name]').show();\n                    $('input[name=loket_form_no_member_gapensi]').hide();\n                    $('input[name=loket_form_company_name]').hide();\n                    $('input[name=loket_form_school_name]').attr('required', true);\n                    $('input[name=loket_form_company_name]').removeAttr('required');\n                    $('input[name=loket_form_no_member_gapensi]').removeAttr('required');\n                    var parent_elm = $('input[name=loket_form_school_name]').parent();\n                    var label = $(this).closest('.form-group').next().find('.form-label');\n                    label.html('Nama Sekolah')\n                    label.attr('required', true);\n                    parent_elm.css('position','absolute')\n                } \n                else if ($(this).val() == 'Instansi/Komunitas') {\n                    $('input[name=loket_form_company_name]').show();\n                    $('input[name=loket_form_school_name]').hide();\n                    $('input[name=loket_form_no_member_gapensi]').hide();\n                    $('input[name=loket_form_company_name]').attr('required', true);\n                    $('input[name=loket_form_school_name]').removeAttr('required');\n                    $('input[name=loket_form_no_member_gapensi]').removeAttr('required');\n                    var parent_elm = $('input[name=loket_form_company_name]').parent();\n                    var label = $(this).closest('.form-group').next().find('.form-label');\n                    label.attr('required', true)\n                    label.html('Nama Perusahaan/Komunitas')\n                    parent_elm.css('position','absolute')\n                    \n                }\n                else if ($(this).val() == 'Gapensi') {\n                    $('input[name=loket_form_no_member_gapensi]').show();\n                    $('input[name=loket_form_no_member_gapensi]').attr('required', true);\n                    $('input[name=loket_form_school_name]').hide();\n                    $('input[name=loket_form_company_name]').hide();\n                    $('input[name=loket_form_school_name]').removeAttr('required');\n                    $('input[name=loket_form_company_name]').removeAttr('required');\n                    var parent_elm = $('input[name=loket_form_no_member_gapensi]').parent();\n                    var label = $(this).closest('.form-group').next().find('.form-label');\n                    label.attr('required', true)\n                    label.html('No Member Gapensi')\n                    parent_elm.css('position','absolute')\n                }\n            })\t\t\n        },\n        _trigger_wizard: function() {\n            var self = this;\n            self._destroy_wizard().then(function(){\n                if (self._get_sum_tickets() > 0) {\n                    $('.custom_form_widget').show();\n                    self._promise_create().then(function(options) {\n                        $('#buy_ticket').removeAttr('disabled');\n                        self._inject_button.apply(self, [self.options.finish]);\n                        \n                        setTimeout(function(){\n                            self._check_qty_match.apply(self, arguments);\n                        }, 300);\n                    })\n                }\n                else {\n                    $('.custom_form_widget').hide();\n                }\n            })\n        },\n        _check_qty_match: function() {\n            var total_tickets = this._get_sum_tickets();\n            var total_forms = Object.keys(this.options.steps).length;\n            \n            if (total_tickets != total_forms) {\n                this._trigger_wizard.apply(this, arguments);\n            }\n        },\n        _destroy_wizard: function() {\n            var self = this;\n            return new Promise(function(res, rej){\n                $('.loketwizard-container').empty();\n                self.options.steps = null;\n                self.options.records = null;\n                res(this);\n            });\n        },\n        _is_new_widget: function() {\n            return this.options.hasOwnProperty('is_new_widget') && this.options.is_new_widget;\n        },\n        _bind_ticket_changes: function() {\n            var self = this;\n            if (self._is_new_widget())\n            {\n                const inputs = document.querySelectorAll('.ticket-types')\n                inputs.forEach(item => item.addEventListener('input', () => {\n                    self._trigger_wizard.apply(self, arguments);\n                }))\n                return;\n            }\n            $('.ticket-types').on('change', function(e) {\n                self._trigger_wizard.apply(self, arguments);\n            })\n        },\n        _inject_button: function(button) {\n            var self = this;\n            if(button.click !== undefined && typeof button.click === 'string') {\n                var func = button.click.replace(\"function\",\"function click\");\n                eval(func);\n                $(button.injectid).off().on('click', function(e) {\n                    e.preventDefault();\n                    self.first_submit = false;\n                    click(self, function() {\n                        $('#form-user').submit();\n                    });\n                    return false;\n                });\n            }\n        },\n        select_by_index: function(index) {\n            if (!this.options.hold_render)\n                return base.select_by_index.apply(this, arguments);\n            var i = 0;\n            var self = this;\n            var exists = false;\n            self.$content.children().each(function(idx, el) {\n                var prev_step = $(this).data('step');\n                if(prev_step.index == index) {\n                    exist = true;\n                    $(this).show('slow');\n                }\n                else {\n                    $(this).hide('slow');\n                }\n            });\n\n            $.each(this.options.steps,function(key,step) {\n                if(i == index) {\n                    self._current_step = step;\n                    step.element.find('a').addClass('active');\n                    if(!exists) {\n                        //self.$content.append(step.content_div);\n                    }\n                }\n                else {\n                    step.element.find('a').removeClass('active');\n                }\n                i++;\n            });\n            \n            this.$button_finish.hide();\n            \n            if (index<1) {\n                this.$button_first.show();\n                this.$button_prev.hide();\n            } \n            else {\n                this.$button_first.hide();\n                this.$button_prev.show();\n            }\n            if (index==(this._total_step-1)) {\n                this.$button_next.hide();\n            }\n            else {\n                this.$button_next.show();\n            }\n            if (this.options.hide_prev) {\n                this.$button_prev.hide();\n            }\n            if (this.options.hide_next){\n                this.$button_next.hide();\n            }\n            if (this.options.hide_finish) {\n                this.$button_finish.hide();\n            }\n            if (this.options.hide_first) {\n                this.$button_first.hide();\n            }\n            if (this.sliding) {\n                if(index==this.next_slide){\n                    this._slide_next(index);\n                }\n                else if(index==this.prev_slide){\n                    this._slide_prev(index);\n                }\n            }\n            else {\n                if((index+1) == 5){\n                    this._slide_next(index);\n                }\n            }\n            if(this.options.index_change){\n                if(typeof self.options.index_change==='string'){\n                    var func = self.options.index_change.replace(\"function\",\"function run\");\n                    eval(func);\n                    run(self);                           \n                }\n                else {\n                    self.options.index_change(self);                        \n                }                                                                    \n            }\n        },\n        _retrigger_accordion: function() {\n            var acc = document.getElementsByClassName('accordion__header');\n            for (var i = 0; i < acc.length; i++) {\n                acc[i].onclick = function() {\n                this.parentElement.querySelectorAll('.is-active').forEach(el => {\n                    const not_form_wizard = !el.hasAttribute('wizard')\n                    if (not_form_wizard) el.classList.remove('is-active')\n                });\n\n                this.classList.add('is-active');\n                this.nextElementSibling.classList.add('is-active');\n                }\n            }\n        },\n        _create_step_content : function(step,content,key){\n            if (!this.options.hold_render) \n                return base._create_step_content.apply(this, arguments);\n            content.options.source = false;\n            content.options.new_widget = false\n            if (this._is_new_widget())\n            {\n                content.options.from_wizard = true\n                content.options.new_widget = true\n            }\n            switch(content.type){\n                case \"loketform\":\n                    return $('<div/>').addClass('loket_form_main').addClass('loket_form_' + key).data('form_name',key).loketForm(content.options).loketForm(\"load\");\n                    break;\n                case \"loketwizard\":\n                    return this.options.steps[step.name].content[key].content=this._create_step_content_loketwizard(step,content);                    \n                    break;\n                default:\n                    break;\n            }\n        },\n        _get_sum_tickets: function() {\n            var ticket_qty, ticket_sum = 0\n\t\t\t$('.ticket-types').map(function ()\n\t\t\t{\n\t\t\t\tticket_qty\t\t= $(this).val();\n\t\t\t\tif (ticket_qty) {\n\t\t\t\t\tticket_sum\t\t+= parseInt(ticket_qty);\n\t\t\t\t}\n\t\t\t});\n\n\t\t\treturn ticket_sum\n        },\n        _get_image_loading: function(){\n            return $('<img/>').attr('src','/themes_1.0/img/loading.gif').addClass('loading');\n        },\n    });\n}(jQuery));    "
