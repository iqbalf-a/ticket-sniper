          ],
          "cookies": [],
          "content": {
            "size": 4594,
            "mimeType": "application/javascript",
            "text": "window.addEventListener('DOMContentLoaded', function () {\n    const emailInputs = this.document.querySelectorAll('input[type=\"email\"]');\n    const domains = [\"gmail.com\", \"yahoo.com\", \"hotmail.com\", \"yahoo.co.id\", \"icloud.com\", \"ymail.com\", \"outlook.com\", \"rocketmail.com\", \"live.com\", \"yahoo.com.au\", \"googlemail.com\", \"live.com.au\", \"hotmail.co.uk\", \"naver.com\", \"yahoo.co.uk\", \"yahoo.co.jp\"];\n    const activeIndexes = {};\n    emailInputs.forEach((emailInput, idx) => {\n        activeIndexes[idx] = -1; \n        emailInput.addEventListener('input', function () {\n            const value = emailInput.value\n            const suggestionContainer = emailInput.nextElementSibling;\n            suggestionContainer.innerHTML = '';\n            const atIndex = value.indexOf('@');\n            if (atIndex > 0) {\n                const localPart = value.slice(0, atIndex);\n                const typedDomain = value.slice(atIndex + 1).toLowerCase();\n\n                const filteredDomains = domains.filter(domain =>\n                    domain.startsWith(typedDomain)\n                );\n\n                filteredDomains.forEach((domain, index) => {\n                    const restDomain = domain.slice(typedDomain.length); // part to bold\n                    const suggestionItem = document.createElement('div');\n                    suggestionItem.className = 'suggestion-item px-4 py-2 font-thin text-sm cursor-pointer';\n                    suggestionItem.setAttribute('data-full', `${localPart}@${domain}`);\n                    suggestionItem.innerHTML = `${localPart}@${typedDomain}<strong>${restDomain}</strong>`;\n\n                    suggestionItem.addEventListener('click', () => {\n                        emailInput.value = `${localPart}@${domain}`;\n                        suggestionContainer.innerHTML = '';\n                        suggestionContainer.classList.add('hidden');\n                    });\n\n                    suggestionContainer.appendChild(suggestionItem);\n                });\n\n                suggestionContainer.classList.remove('hidden');\n                if (filteredDomains.length <= 0) {\n                    suggestionContainer.classList.add('hidden');\n                }\n            } else {\n                suggestionContainer.classList.add('hidden');\n            }\n        })\n        emailInput.addEventListener('keydown', function (e) {\n            const suggestionContainer = emailInput.nextElementSibling;\n            const items = suggestionContainer.querySelectorAll('.suggestion-item');\n            if (!items.length) return;\n            if (e.key === 'ArrowDown') {\n                e.preventDefault();\n                activeIndexes[idx] = (activeIndexes[idx] + 1) % items.length;\n                updateActive(items,  activeIndexes[idx]);\n            } else if (e.key === 'ArrowUp') {\n                e.preventDefault();\n                activeIndexes[idx] = (activeIndexes[idx] - 1 + items.length) % items.length;\n                updateActive(items,  activeIndexes[idx]);\n            } else if (e.key === 'Enter') {\n                if (activeIndexes[idx] >= 0 && items[activeIndexes[idx]]) {\n                    e.preventDefault();\n                    emailInput.value = items[activeIndexes[idx]].getAttribute('data-full');\n                    suggestionContainer.innerHTML = '';\n                    suggestionContainer.classList.add('hidden');\n                }\n            } else if (e.key === 'Escape') {\n                suggestionContainer.innerHTML = '';\n                suggestionContainer.classList.add('hidden'); \n            }\n        })\n\n        emailInput.addEventListener('keypress', function (event) {\n            if (event.key != 'Enter') return;\n            const suggestionContainer = emailInput.nextElementSibling;\n            const items = suggestionContainer.querySelectorAll('.suggestion-item');\n            if (items.length == 0) return;\n            if (suggestionContainer != undefined && items.length > 1) return;\n            emailInput.value = items[0].getAttribute('data-full')\n            suggestionContainer.innerHTML = '';\n            suggestionContainer.classList.add('hidden');\n        })\n\n        function updateActive(items, currentIndex) {\n            items.forEach(item => item.classList.remove('active'));\n            if (currentIndex >= 0) {\n                const activeItem = items[currentIndex];\n                    activeItem.classList.add('active');\n                    activeItem.scrollIntoView({\n                    block: 'nearest',\n                    behavior: 'smooth'\n                });\n            }\n        }\n    })\n})"
          },
