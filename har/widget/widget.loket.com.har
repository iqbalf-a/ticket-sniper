              "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-ancestors 'self' *.loket.com *.loket.id;, default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; frame-ancestors 'self' *.loket.com *.loket.id go-tix.id *.go-tix.id gojek.com *.gojek.com persib.co.id *.persib.co.id persibstore.id *.persibstore.id;"
