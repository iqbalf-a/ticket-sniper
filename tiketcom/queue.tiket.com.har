            "size": 3203,
            "mimeType": "application/x-javascript",
            "text": "queueViewModel.pageReady(function (data) {\n  var pageid = $('body').attr('data-pageid');\n\n  //iFrameResize({ checkOrigin: false }, '#bottompanel_iframe');\n\n  $('#MainPart_lbExpectedServiceTimeText').text(\n    'Expected arrival time on the website: '\n  );\n  $('#MainPart_lbLastUpdateTime').text('Status last updated on ');\n\n  if (pageid == 'before') {\n    // $(\"#MainPart_lbQueueNumberText\").text('Your queue number:');\n  }\n\n  if (pageid == 'queue') {\n    // $(\"#MainPart_lbQueueNumberText\").text('Your queue number:');\n  }\n\n  if (pageid == 'after') {\n    // $(\"#MainPart_lbQueueNumberText\").text('Your queue number:');\n  }\n\n  //capcha page - challinge box\n  if (pageid == 'softblock') {\n    // $(\"#MainPart_lbQueueNumberText\").text('Your queue number:');\n  }\n\n  if (pageid == 'error') {\n    var errorid = $('body').attr('data-errorid');\n    // old queue number - AfterWindow\n    if (errorid == '4') {\n      $('#lbHeaderH2').text('Your spot in line has expired');\n      $('#lbHeaderP').text(\n        \"We held your spot in line for 10 minutes, but it looks like you haven't completed your order within the given time. No worries, you can easily hop back in line by clicking the button below.\"\n      );\n    }\n\n    // Max No Of Redirects Per QId\n    if (errorid == '5') {\n    }\n\n    // KnownUserV3\n    if (errorid == '6') {\n    }\n\n    // ChallengeSolveTimeout\n    if (errorid == '7') {\n    }\n  }\n\n  // // Guarded so the before to queue state transition (which re-fires pageReady)\n  // // doesn't append a second copy of these blocks.\n  const $versionInfo = $('#MainPart_divVersionInfo');\n\n  if ($versionInfo.data('banner-added') !== true) {\n    $versionInfo.data('banner-added', true); // Mark immediately\n    $(\n      `<div class=\"mobile-banner\" role=\"img\" aria-label=\"Campaign banner\"></div>`\n    ).appendTo('#main_t');\n  }\n\n  if ($versionInfo.data('services-added') !== true) {\n    $versionInfo.data('services-added', true); // Mark immediately\n\n    $(`<div class=\"services-container\">\n        <div class=\"services-banner\" role=\"img\" aria-label=\"Campaign banner\"></div>\n        <div class=\"services\">\n            <div>\n                <span><img src=\"https://assets-ap-northeast-1.queue-it.net/tiket/userdata/DemoTheme/assets/Wifi-Icon.svg\" alt=\"img\"></span>\n                <h3>Keep Your Connection Stable</h3>\n                <p>To avoid losing your spot in the queue, make sure your internet connection is fast and stable.</p>\n            </div>\n            <div>\n                <span><img src=\"https://assets-ap-northeast-1.queue-it.net/tiket/userdata/DemoTheme/assets/tds_ic_tab_one.svg\" alt=\"img\"></span>\n                <h3>Use One Tab Only</h3>\n                <p>Accessing the sale from multiple tabs may cause you to lose your spot in line.</p>\n            </div>\n            <div>\n                <span><img src=\"https://assets-ap-northeast-1.queue-it.net/tiket/userdata/DemoTheme/assets/tds_ic_bot_detection.svg\" alt=\"img\"></span>\n                <h3>Bot Detection is Live</h3>\n                <p>Disable any browser extensions, like iCloud Private Relay or VPNs, that might flag you as a bot.</p>\n            </div>\n        </div>\n    </div>`).appendTo('#MainPart_divVersionInfo');\n  }\n});\n"
          },
