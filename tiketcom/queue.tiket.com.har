          "content": {
            "size": 5313,
            "mimeType": "application/x-javascript",
            "text": "let language = 'en-US';\n\n/**\n * Warning the property assignment is using Object.assign\n * So need to make sure that the passed props are correct one\n */\nconst createElementWithProps = (tag, props) => {\n  const el = document.createElement(tag);\n\n  return Object.assign(el, props);\n};\n\n/* Custom section element ID list */\nconst CUSTOM_QUEUE_SECTION_ID = 'CustomQueueSection';\nconst PEOPLE_AHEAD_OF_ME_ID = 'CustomQueueSection_NumberOfPeopleAhead';\n\nconst createCustomQueueContainer = () => {\n  // Lookup by id (the element below is created with `id`, not `className`),\n  // otherwise the before→queue state transition re-runs pageReady and adds a\n  // second #CustomQueueSection in front of #MainPart_divProgressbar.\n  let container = document.getElementById(CUSTOM_QUEUE_SECTION_ID);\n\n  if (!container) {\n    container = createElementWithProps('div', {\n      id: CUSTOM_QUEUE_SECTION_ID,\n    });\n\n    const queueInfoContainer = document.querySelector(\n      '#MainPart_divProgressbar'\n    );\n\n    // Insert before the queueInfoContainer\n    // We'll assume we're gonna hide the original container\n    queueInfoContainer.parentElement.insertBefore(\n      container,\n      queueInfoContainer\n    );\n\n    /**\n     * Create container for each child elements\n     */\n    container.appendChild(\n      createElementWithProps('div', {\n        id: PEOPLE_AHEAD_OF_ME_ID,\n        className: 'custom-people-ahead',\n      })\n    );\n  }\n\n  return container;\n};\n\n/* rendering */\nlet timezone = '';\n\nconst renderNumberOfPeopleAhead = (numOfPeople) => {\n  if (Number.isNaN(numOfPeople)) return;\n  const queueElement = document.querySelector(`#${PEOPLE_AHEAD_OF_ME_ID}`);\n  // Format to be dot (`.`) thousands seperated\n  const formattedNumber = new Intl.NumberFormat('id').format(numOfPeople);\n  queueElement.innerHTML = `<span>${formattedNumber}</span><div>people are in front of you</div>`;\n};\n\nconst renderFirstInLine = (isFirstInLine) => {\n  if (!isFirstInLine) return;\n\n  const queueElement = document.querySelector(`#${PEOPLE_AHEAD_OF_ME_ID}`);\n  queueElement.innerHTML = `<span>It's your turn!</span>`;\n\n  const heading = document.querySelector('#lbHeaderH2');\n  heading.innerText = `You're the first in line!`;\n};\n\n/**\n * Will render first time and add subscription to the target\n * @param {*} callback function to be called to render the element, will be called whenever target notify updates\n * The callback requires 1 params, which is the current/newest value of the target\n * @param {*} target subscription target that will notifies subscribers when there's update\n */\nconst renderAndSubscribe = (callback, target) => {\n  if (!target.subscribe)\n    throw new Error(\n      'renderAndSubscribe provided target param without subscribe method'\n    );\n\n  if (typeof target.subscribe !== 'function')\n    throw new Error(\n      \"renderAndSubscribe provided target doesn't seem to be callable\"\n    );\n\n  // render first time\n  callback(target());\n  // render when there's update\n  target.subscribe(callback);\n};\n\nconst renderCustomQueuePage = () => {\n  createCustomQueueContainer();\n\n  language = queueViewModel.languageSelector.selectedLanguage();\n  queueViewModel.languageSelector.selectedLanguage.subscribe((newLanguage) => {\n    language = newLanguage;\n  });\n\n  timezone = queueViewModel.ticket.timeZonePostfix();\n  queueViewModel.ticket.timeZonePostfix.subscribe((newTimezone) => {\n    timezone = newTimezone;\n  });\n\n  renderAndSubscribe(\n    renderNumberOfPeopleAhead,\n    queueViewModel.ticket.usersInLineAheadOfYou\n  );\n\n  renderAndSubscribe(\n    renderFirstInLine,\n    queueViewModel.layout.firstInLineVisible\n  );\n};\n\nconst renderCustomBeforePage = () => {\n  /* Custom Text */\n  /* Replace Event Starts At */\n  const startAtEl = document.querySelector('#MainPart_lbEventStartsAtText');\n  if (startAtEl) {\n    startAtEl.innerText = 'Ticket sales will start at ';\n  }\n};\n\nconst updateGeneralCustomTexts = () => {\n  /* no internet */\n  const noInternet = document.querySelector('#MainPart_lbManualUpdateWarning');\n  noInternet.innerText =\n    'Lost internet connection. Please check your Wi-Fi, data package, or cellular service.';\n  /* redirect confirm modal */\n  const redirectConfirm = document.querySelector('#pConfirmRedirect');\n  redirectConfirm.innerText =\n    'Please confirm so we can get you to the site right away.';\n};\n\nconst renderCustomErrorPage = () => {\n  const heading = document.querySelector('#lbHeaderH2');\n  heading.innerText = `Your time is up!`;\n  const paragraph = document.querySelector('#lbHeaderP');\n  paragraph.innerText = `You've used up 10 minutes of the time allowed. If you still want the ticket, you'll need to wait in line.`;\n};\n\nconst initializeRenderer = (page) => {\n  /* Note: {page} values will be one of 'before' | 'queue' | 'after' | 'error' */\n  /* This also can be obtained from body['data-pageid'] property */\n  // console.log(`Initialize page render of ${page}`);\n\n  /* update general texts */\n  updateGeneralCustomTexts();\n\n  switch (page) {\n    case 'queue':\n      renderCustomQueuePage();\n      break;\n    case 'before':\n      renderCustomBeforePage();\n      break;\n    case 'error':\n      renderCustomErrorPage();\n      break;\n    default:\n      // console.log(\"No custom renderer found, skipping.\");\n      break;\n  }\n};\n\nqueueViewModel.pageReady(initializeRenderer);\n"
          },
