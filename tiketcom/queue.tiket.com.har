            "text": "/* Taken From Tiket Passport Design */\n@font-face {\n  font-family: 'TiketOdysseyText';\n  font-style: normal;\n  font-weight: 400;\n  src: url('./fonts/TiketOdysseyText-Regular.woff') format('woff'),\n    url('./fonts/TiketOdysseyText-Regular.woff2') format('woff2');\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'TiketOdysseyText';\n  font-style: normal;\n  font-weight: 600;\n  src: url('./fonts/TiketOdysseyText-SemiBold.woff') format('woff'),\n    url('./fonts/TiketOdysseyText-SemiBold.woff2') format('woff2');\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'TiketOdysseyText';\n  font-style: normal;\n  font-weight: 700;\n  src: url('./fonts/TiketOdysseyText-Bold.woff') format('woff'),\n    url('./fonts/TiketOdysseyText-Bold.woff2') format('woff2');\n  font-display: swap;\n}\n\n*,\n::before,\n::after {\n  box-sizing: border-box;\n}\n\n*,\nbody {\n  font-family: TiketOdysseyText, system-ui, -apple-system, 'Segoe UI', Roboto,\n    Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';\n}\n\nbody {\n  background-color: #f4f7fe;\n  margin: 0;\n\n  min-height: 100%;\n  display: flex;\n  flex-direction: column;\n  overflow: auto;\n}\n\n#wrapper {\n  flex: 1;\n  min-height: auto;\n  display: block;\n  background-image: var(--main-bg-image-url);\n  background-position: center;\n  background-size: cover;\n}\n\n#main {\n  display: flex;\n  /* background-image: var(--main-bg-image-url);\n  background-position: center;\n  background-size: cover; */\n\n  width: var(--wrapper-width);\n  max-width: unset;\n  padding: 25px var(--wrapper-padding);\n  min-height: auto;\n\n  flex-direction: column;\n  border-radius: 0;\n  align-items: center;\n  gap: var(--wrapper-padding);\n}\n\n#main .t {\n  display: inline-block;\n  width: 100%;\n  height: 100%;\n  background: none;\n  text-align: center;\n}\n#main .t img {\n  display: inline-block;\n  width: auto;\n  max-width: 90%;\n}\n\n/* Banner injected by script-edit-text.js into #main_t.\n * The actual image is supplied via the --main-illustration-url CSS variable,\n * which any theme override (e.g. theweekndbanner.css) can redefine at :root. */\n#main .t .mobile-banner {\n  display: block;\n  width: 100%;\n  max-width: 90%;\n  aspect-ratio: 3 / 2;\n  margin: 0 auto;\n  background-image: var(--main-illustration-url);\n  background-position: center;\n  background-size: contain;\n  background-repeat: no-repeat;\n}\n\n/* #main::before {\n  content: '';\n  background-image: var(--main-illustration-url);\n  background-position: center;\n  background-size: contain;\n  background-repeat: no-repeat;\n  display: block;\n  height: var(--banner-image-size);\n  aspect-ratio: 3 / 2;\n  margin-bottom: 4px;\n  flex: unset;\n} */\n\n#header {\n  padding: 0;\n  border-bottom: 0;\n}\n\n.warning-box {\n  border-bottom: 0;\n  background: none;\n  padding: 0;\n  margin: 0;\n  margin-top: 12px;\n  text-align: left;\n}\n\n.btn {\n  z-index: 0;\n  margin: 0;\n  padding: 13px 20px;\n  border-radius: 8px;\n  background: transparent !important;\n  box-shadow: none !important;\n  position: relative;\n  font-weight: 700;\n  text-align: center;\n\n  overflow: hidden;\n  top: 0 !important;\n  outline: none;\n  color: #ffffff !important;\n}\n\n.btn:focus-visible {\n  outline: 1px solid currentcolor;\n  outline-offset: -3px;\n}\n\n.btn::before,\n.btn::after {\n  content: '';\n  display: block;\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.btn::before {\n  z-index: -2;\n}\n\n.btn::after {\n  z-index: -1;\n  opacity: 0;\n  transition: 0.3s;\n  background: #5baaff;\n}\n\n.btn:hover::after {\n  opacity: 0.48;\n}\n\n.btn::before {\n  background: #007bff;\n}\n\n.warning-box > p {\n  margin: 0;\n  margin-top: 10px;\n}\n\n.warning-box .beforeElement {\n  margin: 0;\n  text-align: left;\n  font-weight: 700 !important;\n}\n\n.logo {\n  margin-bottom: 24px;\n  text-align: left;\n}\n\n.progressbar {\n  background: #e7f2ff;\n  border: 0;\n  border-radius: 10px;\n  margin: 2px 0;\n  height: var(--progress-bar-height);\n}\n\n.processbar-box {\n  background: none;\n}\n\n.processbar-box,\n.warning-box {\n  color: #303135;\n}\n\n.progressbar .progress {\n  background-image: none !important;\n  background: #002a58;\n  overflow: visible !important;\n  border-top-left-radius: inherit;\n  border-bottom-left-radius: inherit;\n}\n\n.progressbar .progress .runner {\n  background-image: var(--progress-icon-url);\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  top: 50%;\n  transform: translate(50%, -50%);\n  width: var(--progress-icon-width);\n  height: var(--progress-icon-height);\n  margin: 0;\n}\n\n.progressbar .progress .runner.paused {\n  background-image: var(--progress-paused-icon-url);\n}\n\n#MainPart_divProgressbarBox.processbar-box,\n.processbar-box .holder {\n  background: none;\n  padding: 0;\n  margin: 0;\n  border-bottom: 0;\n  text-align: left;\n}\n\n#MainPart_pProgressbarBox_Holder_Larger {\n  margin-top: 12px;\n  min-height: unset;\n}\n\n#MainPart_divProgressbarBox_Holder {\n  min-height: unset;\n}\n\n#MainPart_divProgressbarBox_Holder_LastUpdateTime {\n  margin-top: 12px;\n  display: flex;\n  align-items: center;\n}\n\n#MainPart_divProgressbarBox_Holder_LastUpdateTime > span + span::before {\n  content: '\\00a0';\n  display: inline-block;\n}\n\n#MainPart_divProgressbarBox_Holder_LastUpdateTime::before {\n  content: ' ';\n  background-image: url('./assets/tds_ic_region.svg');\n  width: 24px;\n  height: 24px;\n  margin-right: 8px;\n  display: inline-block;\n}\n\n.processbar-box p {\n  margin: 0;\n}\n\n#headerparagraph {\n  margin-top: 10px;\n}\n\n#lbHeaderP {\n  white-space: pre-line;\n}\n\n#main_c.c {\n  flex: 1 0 50%;\n  background: #ffffff;\n  /* background-image: url(assets/KV.png); */\n  border-radius: var(--content-radius);\n  padding: var(--content-padding);\n  display: flex;\n  flex-direction: column;\n  margin-left: 0;\n  width: auto;\n}\n\n#MainPart_div