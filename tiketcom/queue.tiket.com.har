            "size": 7417,
            "mimeType": "application/x-javascript",
            "text": "/*\n * scriptBackBtn.js\n *\n * Renders a single \"Back to Previous Page\" button inside\n * #MainPart_divWarningBox on the Queue-it error page and wires it to\n * navigate the user back through the browser history.\n *\n * Behavior:\n *   - Only runs when body[data-pageid=\"error\"].\n *   - Always removes any button Queue-it renders inside\n *     #MainPart_divWarningBox, even if we don't inject our own. The\n *     Queue-it-rendered button goes to queue re-entry which is not what we\n *     want on the error page.\n *   - Only renders our button when the URL has a `?t=` targetUrl pointing\n *     at a trusted tiket host (https + subdomain of tiket.com). Without a\n *     valid target there's nowhere safe to send the user, so the warning\n *     box is left empty.\n *   - On click, in order of preference:\n *       1. Redirect to the trusted `?t=` target URL. If that URL carries any\n *          query param in UNIVERSAL_LINK_BLOCK_PARAMS (e.g. `tag_event_userId`)\n *          and doesn't already have a `#no_universal_link` hash, append it so\n *          the destination doesn't get hijacked into the native app via\n *          universal links.\n *       2. Else, if the user arrived from a Queue-it hosted page (any\n *          subdomain of queue-it.net, queue.tiket.com, or the current host),\n *          and browser history has more than one entry, call\n *          `window.history.go(-2)` to skip past the queue entry.\n *       3. Else, fall back to `window.history.back()`.\n *     In practice we always hit branch (1) because the button only renders\n *     when a trusted target exists; (2) and (3) remain as a defensive\n *     fallback in case the `?t=` param changes between render and click.\n */\n(function () {\n  var BTN_ID = 'CustomBackToQueueBtn';\n  var BTN_LABEL = 'Go Back in Line';\n\n  // Each entry matches its exact host AND any subdomain of it\n  // (e.g. 'queue-it.net' matches 'tiket.queue-it.net').\n  var QUEUEIT_HOSTS = ['queue-it.net', 'queue.tiket.com'];\n\n  // Hosts we trust as redirect targets from the `?t=` parameter.\n  // Each entry matches exact + subdomains via hostMatches().\n  var TIKET_HOSTS = ['tiket.com'];\n\n  // Trailing path segments we strip from a trusted target so the user lands\n  // back on the PDP/product page instead of re-entering the order/packages\n  // flow they were just queued out of. Query is preserved (it can carry\n  // useful context like brand/tag_event_* for the PDP), but the hash is\n  // dropped since anchors like #bfVisitorDetail-0 are flow-specific.\n  var PDP_STRIP_SEGMENTS = ['order', 'packages'];\n\n  // Query params on the trusted target that should force a\n  // `#no_universal_link` hash so the destination opens in the browser instead\n  // of being hijacked into the native app via universal links.\n  var UNIVERSAL_LINK_BLOCK_PARAMS = ['tag_event_userId'];\n  var NO_UNIVERSAL_LINK_HASH = 'no_universal_link';\n\n  function isErrorPage(pageId) {\n    if (pageId) return pageId === 'error';\n    return (\n      document.body && document.body.getAttribute('data-pageid') === 'error'\n    );\n  }\n\n  function hostMatches(host, pattern) {\n    return host === pattern || host.endsWith('.' + pattern);\n  }\n\n  function cameFromQueueIt() {\n    if (!document.referrer) return false;\n    try {\n      var refHost = new URL(document.referrer).hostname;\n      if (refHost === window.location.hostname) return true;\n      for (var i = 0; i < QUEUEIT_HOSTS.length; i++) {\n        if (hostMatches(refHost, QUEUEIT_HOSTS[i])) return true;\n      }\n      return false;\n    } catch (e) {\n      return false;\n    }\n  }\n\n  function stripFlowSegmentToPdp(parsed) {\n    var segments = parsed.pathname.split('/').filter(Boolean);\n    if (segments.length === 0) return;\n    var last = segments[segments.length - 1].toLowerCase();\n    if (PDP_STRIP_SEGMENTS.indexOf(last) === -1) return;\n    segments.pop();\n    parsed.pathname = '/' + segments.join('/');\n    parsed.hash = '';\n  }\n\n  function applyNoUniversalLinkHash(parsed) {\n    var hasBlockedParam = false;\n    for (var i = 0; i < UNIVERSAL_LINK_BLOCK_PARAMS.length; i++) {\n      if (parsed.searchParams.has(UNIVERSAL_LINK_BLOCK_PARAMS[i])) {\n        hasBlockedParam = true;\n        break;\n      }\n    }\n    if (!hasBlockedParam) return;\n    if (parsed.hash === '#' + NO_UNIVERSAL_LINK_HASH) return;\n    parsed.hash = NO_UNIVERSAL_LINK_HASH;\n  }\n\n  function getTrustedTargetUrl() {\n    try {\n      var raw = new URLSearchParams(window.location.search).get('t');\n      if (!raw) return null;\n      var parsed = new URL(raw);\n      if (parsed.protocol !== 'https:') return null;\n      var trusted = false;\n      for (var i = 0; i < TIKET_HOSTS.length; i++) {\n        if (hostMatches(parsed.hostname, TIKET_HOSTS[i])) {\n          trusted = true;\n          break;\n        }\n      }\n      if (!trusted) return null;\n      stripFlowSegmentToPdp(parsed);\n      applyNoUniversalLinkHash(parsed);\n      return parsed.href;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function onBackClick(e) {\n    e.preventDefault();\n\n    var target = getTrustedTargetUrl();\n    if (target) {\n      window.location.href = target;\n      return;\n    }\n\n    if (cameFromQueueIt() && window.history.length > 1) {\n      window.history.go(-2);\n    } else {\n      window.history.back();\n    }\n  }\n\n  function clearExistingButtons(container) {\n    var existing = container.querySelectorAll('a.btn, button.btn, #' + BTN_ID);\n    for (var i = 0; i < existing.length; i++) {\n      var el = existing[i];\n      var wrapper = el.parentElement;\n      if (wrapper && wrapper.tagName === 'P' && wrapper.children.length === 1) {\n        wrapper.parentElement && wrapper.parentElement.removeChild(wrapper);\n      } else {\n        el.parentElement && el.parentElement.removeChild(el);\n      }\n    }\n  }\n\n  function injectButton(pageId) {\n    if (!isErrorPage(pageId)) return;\n\n    var container = document.getElementById('MainPart_divWarningBox');\n    if (!container) return;\n\n    // Always strip Queue-it's own button first — it routes users back into\n    // the queue, which is the wrong action on our expired/error page.\n    clearExistingButtons(container);\n\n    // No trusted ?t= target → nothing meaningful to redirect to. Leave the\n    // warning box empty rather than offering an unsafe fallback.\n    if (!getTrustedTargetUrl()) return;\n\n    var p = document.createElement('p');\n\n    var anchor = document.createElement('a');\n    anchor.id = BTN_ID;\n    anchor.className = 'btn';\n    anchor.tabIndex = 0;\n    anchor.setAttribute('role', 'button');\n    anchor.style.cursor = 'pointer';\n\n    var left = document.createElement('span');\n    left.className = 'l';\n    left.textContent = BTN_LABEL;\n\n    var right = document.createElement('span');\n    right.className = 'r';\n    right.innerHTML = '&nbsp;';\n\n    anchor.appendChild(left);\n    anchor.appendChild(right);\n    p.appendChild(anchor);\n\n    container.appendChild(p);\n\n    anchor.addEventListener('click', onBackClick);\n    anchor.addEventListener('keyup', function (e) {\n      if (e.key === 'Enter' || e.key === ' ') {\n        onBackClick(e);\n      }\n    });\n  }\n\n  if (window.queueViewModel && typeof queueViewModel.pageReady === 'function') {\n    queueViewModel.pageReady(function (pageId) {\n      injectButton(pageId);\n    });\n  } else if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', function () {\n      injectButton();\n    });\n  } else {\n    injectButton();\n  }\n})();\n"
