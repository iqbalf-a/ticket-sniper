100%;\n  background-color: #fff;\n}\n\n#leftpanel_iframe {\n  display: inline-block;\n  width: var(--wrapper-width);\n}\n\n.modal {\n  --modal-max-width: 100vw;\n\n  display: flex;\n  justify-content: center;\n}\n\n.modal .modal-content {\n  margin: 0;\n\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n  overflow: hidden;\n\n  align-self: flex-end;\n}\n\n#divConfirmRedirectModal_Content {\n  max-width: unset;\n}\n\n.modal .modal-body {\n  padding: 24px 20px 16px 20px;\n  width: var(--modal-max-width);\n}\n\n#h2ConfirmRedirect,\n#pConfirmRedirectTime {\n  margin: 0;\n  display: inline-block;\n}\n\n#pConfirmRedirect {\n  text-align: center;\n  margin: 0;\n  margin-top: 8px;\n}\n\n#buttonConfirmRedirect {\n  margin-top: 16px;\n  width: 100%;\n}\n\n#noscript {\n  display: block;\n}\n\n#queueIdLinkModal_Content {\n  max-width: unset;\n  background-color: #ffffff;\n}\n\n#detailExpander {\n  font-weight: 400;\n  text-align: left;\n}\n\n#MainPart_divWarningBox {\n  margin-top: 12px;\n}\n\n#footer-direct-link {\n  text-align: left;\n}\n\n#queueIdModal_Header {\n  text-align: center;\n  padding: 24px 20px 0 20px;\n  margin: 0;\n  background-color: unset;\n}\n\n#queueIdLinkModalLabel {\n  padding: 0;\n  margin: 0;\n}\n\n#queueIdLinkModal_Body {\n  padding: 8px 20px 16px 20px;\n}\n\n#queueIdLinkModal_Body p {\n  margin: 0;\n}\n\n#queueIdLinkURL {\n  overflow: auto;\n  white-space: nowrap;\n  margin-top: 12px;\n  border-color: #004fa7;\n  max-width: 100%;\n}\n\n#copyToClipboardButton {\n  width: 100%;\n  margin-top: 12px;\n}\n\n.custom-people-ahead {\n  margin-top: 24px;\n  margin-bottom: 12px;\n  text-align: center;\n}\n\n#imgCustomerLogo {\n  height: 24px;\n}\n\n/* hide non used components */\n#main-top,\n#MainPart_ulProgressbarBox_Holder_Processbar,\n#whatisthis,\n#MainPart_divTimeBox_Holder_Frame h2,\n#footer-queueit-link,\n.larger.beforeElement,\n#copyToClipboardButton img,\n#queueIdModal_Header button,\n#MainPart_lbQueueNumberContainer,\n#MainPart_lbUsersInLineAheadOfYouText,\n#MainPart_lbUsersInLineAheadOfYou,\n#first-in-line,\n#MainPart_lbWhichIsInText,\n#MainPart_lbWhichIsIn,\n#MainPart_lbUsersInLineAheadOfYouLineBreak,\n#MainPart_lbExpectedServiceTimeLineBreak {\n  display: none;\n}\n\n/* defaults to mobile design */\n:root {\n  --wrapper-width: 100%;\n  --wrapper-padding: 20px;\n  --progress-bar-height: 12px;\n  /* image progres (runner) hardcoded since it's utilizing bg image */\n  --progress-icon-height: 24px;\n  --progress-icon-width: 24px;\n\n  --progress-icon-url: url('./assets/running_tman.gif');\n  --progress-paused-icon-url: url('./assets/tman_run_test_2x.png');\n  --main-bg-image-url: url('./assets/ot_backgorund_queue.png');\n  --main-illustration-url: url('./assets/tds_si_queue_page.png');\n  --banner-image-size: 160px;\n  --content-padding: 16px;\n  --content-radius: 12px;\n}\n\n/* H2 */\nh1#headertext {\n  font-size: 22px;\n  font-weight: 700;\n  line-height: 28px;\n  letter-spacing: 0px;\n  color: #303135;\n}\n\n/* h3 */\n#h2ConfirmRedirect,\n#pConfirmRedirectTime,\n#defaultCountdown,\n#queueIdLinkModalLabel,\n.custom-people-ahead > span {\n  font-size: 18px;\n  font-weight: 700;\n  line-height: 24px;\n  letter-spacing: 0px;\n  color: #303135;\n}\n\n/* body 1 */\n.btn,\n#pConfirmRedirect,\n#queueIdLinkModal_Body {\n  font-size: 16px;\n  line-height: 22px;\n  letter-spacing: 0px;\n  color: #303135;\n}\n\n/* body 2 */\n#headerparagraph,\n#MainPart_divProgressbarBox_Holder_LastUpdateTime,\n#MainPart_pProgressbarBox_Holder_Larger,\n.warning-box .beforeElement,\n#detailExpander,\n.custom-people-ahead {\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 20px;\n  letter-spacing: 0px;\n  color: #303135;\n}\n\n/* body 3 */\n#MainPart_divTimeBox_Holder_Frame,\n#MainPart_lbManualUpdateWarning {\n  font-size: 12px;\n  font-weight: 400;\n  line-height: 16px;\n  letter-spacing: 0px;\n  color: #303135;\n}\n\n/* small */\n#footer * {\n  font-size: 10px;\n  font-weight: 600;\n  line-height: 14px;\n  letter-spacing: 0px;\n  color: #303135;\n}\n\n#main .b {\n  display: inline-block;\n  height: auto;\n  background: transparent;\n  width: 100%;\n}\n\n.services-container {\n  display: flex;\n  flex-direction: column;\n  min-height: 100%;\n  gap: 20px;\n}\n\n/* Desktop-only banner inside .services-container. Hidden below 900px because\n * #main_t .mobile-banner already shows the campaign banner at the top.\n * The asset is driven by --main-illustration-url, so theme overrides\n * (e.g. theweekndbanner.css) apply automatically.\n * Uses a fixed size on desktop; tweak --services-banner-width / -height\n * (or the values below) to resize. */\n.services-container > .services-banner {\n  display: none;\n  width: 450px;\n  height: 300px;\n  margin: 0 auto;\n  background-image: var(--main-illustration-url);\n  background-position: center;\n  background-size: contain;\n  background-repeat: no-repeat;\n}\n\n.services {\n  display: flex;\n  gap: 12px;\n  flex-direction: column;\n}\n\n.services > div {\n  display: inline-block;\n  background-color: #fff;\n  border-radius: 16px;\n  padding: 24px;\n  width: 100%;\n}\n\n.services span {\n  display: inline-block;\n  width: 100%;\n}\n\n.services h3 {\n  display: inline-block;\n  margin: 16px 0 5px;\n  font-size: 14px;\n  line-height: 143%;\n}\n\n.services p {\n  display: inline-block;\n  font-size: 14px;\n  line-height: 143%;\n  margin: 0;\n}\n\n/* xs */\n@media (max-width: 399px) {\n  /* noop */\n}\n\n/* sm */\n@media (min-width: 400px) {\n  :root {\n    --banner-image-size: 200px;\n    --content-padding: 20px;\n  }\n}\n\n/* md */\n@media (min-width: 600px) {\n  :root {\n    --wrapper-padding: 18px;\n    --banner-image-size: 240px;\n    --content-padding: 24px;\n  }\n}\n\n/* lg */\n@media (min-width: 900px) {\n  :root {\n    --wrapper-width: 94%;\n\n    --wrapper-padding: 20px;\n\n    --progress-bar-height: 20px;\n    --progress-icon-height: 32px;\n    --progress-icon-width: 32px;\n\n    --content-padding: 32px;\n    --content-radius: 16px;\n\n    --main-bg-image-url: url('./assets/ot_background_queue_desktop_840.png');\n    --main-illustration-url: url('./assets/tds_si_queue_page.png');\n  }\n\n  body {\n    height: auto;\n  }\n\n  #bottompanel_iframe {\n    display: block;\n  }\n\n  #wrapper {\n    background: none;\n  }\n\n  #main .t {\n    display: none;\n  }\n  #main {\n    background-image: var(--main-bg-image-url);\n    background-position: center;\n    background-size: cover;\n    flex-direction: row-reverse;\n    min-height: unset;\n    border-radius: 24px;\n    min-height: auto;\n  }\n\n  #main_c.c {\n    /* background-color: #fff;\n    background-image: none; */\n    /* background-image: var(--main-bg-image-url);\n    background-position: center;\n    background-size: cover; */\n  }\n\n  /* #main::before {\n    flex: 1 1 50%;\n\n    height: auto;\n  } */\n\n  .progressbar .progress .runner {\n    right: 0;\n  }\n\n  #wrapper {\n    display: flex;\n    align-items: center;\n    margin: 20px 0;\n  }\n\n  .logo {\n    margin-bottom: 40px;\n  }\n\n  /* H2 */\n  h1#headertext {\n    font-size: 38px;\n    font-weight: 700;\n    line-height: 42px;\n  }\n\n  /* h3 */\n  #h2ConfirmRedirect,\n  #pConfirmRedirectTime,\n  #defaultCountdown,\n  #queueIdLinkModalLabel,\n  .custom-people-ahead > span {\n    font-size: 24px;\n    font-weight: 700;\n    line-height: 30px;\n    letter-spacing: 0px;\n  }\n\n  /* body 1 */\n  .btn,\n  #pConfirmRedirect,\n  #queueIdLinkModal_Body {\n    font-size: 18px;\n    line-height: 24px;\n  }\n\n  /* body2 */\n  #headerparagraph,\n  #MainPart_divProgressbarBox_Holder_LastUpdateTime,\n  #MainPart_pProgressbarBox_Holder_Larger,\n  .warning-box .beforeElement,\n  #detailExpander,\n  .custom-people-ahead {\n    font-size: 16px;\n    line-height: 22px;\n  }\n\n  /* body 3 */\n  #MainPart_divTimeBox_Holder_Frame,\n  #MainPart_lbManualUpdateWarning {\n    font-size: 14px;\n    line-height: 20px;\n  }\n\n  /* small */\n  #footer * {\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 16px;\n  }\n\n  .modal {\n    --modal-max-width: 400px;\n  }\n\n  .modal .modal-body {\n    padding: 24px;\n    max-width: calc(100vw - 24px);\n  }\n\n  .modal .modal-content {\n    border-radius: 12px;\n    align-self: center;\n  }\n\n  .btn {\n    padding: 14px 24px;\n  }\n\n  #queueIdLinkModal_Content {\n    --modal-max-width: 600px;\n  }\n\n  #queueIdModal_Header {\n    width: var(--modal-max-width);\n    max-width: calc(100vw - 24px);\n  }\n\n  .custom-people-ahead {\n    margin-top: 40px;\n  }\n\n  #imgCustomerLogo {\n    height: 30px;\n  }\n  .services {\n    flex-direction: row;\n  }\n\n  .services > div {\n    padding: 15px;\n    width: 34%;\n  }\n  .services-container > .services-banner {\n    display: block;\n  }\n\n  #toppanel {\n    display: inline-block;\n  }\n}\n\n/* xl */\n@media (min-width: 960px) {\n  :root {\n    --wrapper-width: calc(100vw - 100px);\n  }\n}\n\n/* xxl */\n@media (min-width: 1280px) {\n  :root {\n    --wrapper-width: calc(100vw - 180px);\n    --main-bg-image-url: url('./assets/ot_backgorund_queue.png');\n    --main-illustration-url: url('./assets/tds_si_queue_page.png');\n  }\n}\n\n/* xxxl */\n@media (min-width: 1440px) {\n  :root {\n    --wrapper-width: 1200px;\n  }\n}\n"
