          "content": {
            "size": 630,
            "mimeType": "application/x-javascript",
            "text": "/*\n * script-remove-modal.js\n *\n * Strips the Queue ID \"share my link\" modal (`#queueIdLinkModal`) out of the\n * page so the `#hlLinkToQueueTicket2Text` \"Queue ID:\" button has nothing to\n * toggle. Net effect: clicking the Queue ID label does nothing.\n */\n(function () {\n  function removeQueueIdLinkModal() {\n    var modal = document.getElementById('queueIdLinkModal');\n    if (modal && modal.parentNode) {\n      modal.parentNode.removeChild(modal);\n    }\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', removeQueueIdLinkModal);\n  } else {\n    removeQueueIdLinkModal();\n  }\n})();\n"
          },
